{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All C# Projects",
            "type": "shell",
            "command": "${workspaceFolder}/build.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build K-OCRLib",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/K-OCRLib/K-OCRLib.csproj"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build K-OCR (WPF)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/K-OCR/K-OCR.csproj"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean All",
            "type": "shell",
            "command": "find . -type d \\( -name bin -o -name obj \\) -exec rm -rf {} + 2>/dev/null || true",
            "group": "build",
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}
