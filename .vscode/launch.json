{
    // Launch configurations for K-OCR projects
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch KOCRAsp (MVC)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build KOCRAsp Only",
            "program": "${workspaceFolder}/KOCRAsp/bin/Debug/net10.0/KOCRAsp.dll",
            "args": [],
            "cwd": "${workspaceFolder}/KOCRAsp",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": "Launch KOCRAsp (MVC Release)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build KOCRAsp Release",
            "program": "${workspaceFolder}/KOCRAsp/bin/Release/net10.0/KOCRAsp.dll",
            "args": [],
            "cwd": "${workspaceFolder}/KOCRAsp",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Production"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": "Launch K-OCR (Blazor)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build K-OCR (Blazor) Only",
            "program": "${workspaceFolder}/K-OCR/bin/Debug/net10.0/K-OCR.dll",
            "args": [],
            "cwd": "${workspaceFolder}/K-OCR",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },

        {
            "name": "Launch K-OCR (WPF - Windows Only)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/K-OCR/bin/Debug/net10.0-windows/K-OCR.exe",
            "args": [],
            "cwd": "${workspaceFolder}/K-OCR",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Attach to Process",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "ng serve",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "npm: start",
            "url": "http://localhost:4200/",
            "cwd": "${workspaceFolder}/K-OCRAngular",
            "webRoot": "${workspaceFolder}/K-OCRAngular",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack://_N_E/*": "${webRoot}/*"
            },
            "runtimeArgs": [
                "--disable-web-security",
                "--user-data-dir=${workspaceFolder}/.vscode/chrome-debug-profile"
            ]
        },
        {
            "name": "ng test",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "npm: test",
            "url": "http://localhost:9876/debug.html",
            "cwd": "${workspaceFolder}/K-OCRAngular"
        }
    ]
}
