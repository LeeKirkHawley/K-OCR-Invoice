@using K_OCR.Configuration
@inject IConfigurationService ConfigService
@inject DatabaseService DatabaseSvc
@inject WorkspaceState State
@inject ToastService Toast
@inject SettingsDialogService SettingsSvc
@implements IDisposable

@if (_visible)
{
    <div class="settings-overlay" @onclick="Cancel">
        <div class="settings-dialog" @onclick:stopPropagation="true">

            <div class="settings-header">
                <h2 class="settings-title">Settings</h2>
                <div class="settings-header-actions">
                    <button class="btn btn-save" @onclick="SaveAsync" disabled="@_saving">
                        @(_saving ? "Saving…" : "Save")
                    </button>
                    <button class="btn btn-cancel" @onclick="Cancel">Cancel</button>
                </div>
            </div>

            @if (_saved)
            {
                <div class="settings-banner settings-banner-success">
                    ✓ Settings saved. Some changes (e.g. Azure key, database) take effect after restart.
                </div>
            }

            @if (_error is not null)
            {
                <div class="settings-banner settings-banner-error">⚠ @_error</div>
            }

            <div class="settings-content">

                <!-- ── Azure Document Intelligence ───────────────────── -->
                <section class="settings-section">
                    <h3 class="settings-section-title">Azure Document Intelligence</h3>

                    <div class="settings-field">
                        <label class="settings-label">API Key</label>
                        <input type="password" class="settings-input"
                               @bind="_settings.AzureCognitiveServicesKey"
                               placeholder="Paste your Azure API key" />
                    </div>

                    <div class="settings-field">
                        <label class="settings-label">Endpoint URL</label>
                        <input type="url" class="settings-input"
                               @bind="_settings.AzureCognitiveServicesEndpoint"
                               placeholder="https://your-resource.cognitiveservices.azure.com/" />
                    </div>
                </section>

                <!-- ── OCR ────────────────────────────────────────────── -->
                <section class="settings-section">
                    <h3 class="settings-section-title">OCR</h3>

                    <div class="settings-field">
                        <label class="settings-label">Provider</label>
                        <select class="settings-select" @bind="_settings.OCRProvider">
                            <option value="Azure">Azure Document Intelligence</option>
                            <option value="Tesseract">Tesseract (local)</option>
                        </select>
                    </div>

                    <div class="settings-field">
                        <label class="settings-label">Max Concurrent Requests</label>
                        <input type="number" class="settings-input settings-input-narrow"
                               min="1" max="20" step="1"
                               @bind="_settings.MaxConcurrentRequests" />
                        <span class="settings-hint">How many OCR requests to run in parallel (1–20).</span>
                    </div>
                </section>

                <!-- ── Validation ─────────────────────────────────────── -->
                <section class="settings-section">
                    <h3 class="settings-section-title">Validation</h3>

                    <div class="settings-field">
                        <label class="settings-label">Min Confidence Threshold</label>
                        <input type="number" class="settings-input settings-input-narrow"
                               min="0" max="1" step="0.05"
                               @bind="_settings.MinConfidenceThreshold" />
                        <span class="settings-hint">
                            Fields whose Azure confidence score is below this value (0.0–1.0) are flagged.
                        </span>
                    </div>
                </section>

                <!-- ── Directories ────────────────────────────────────── -->
                <section class="settings-section">
                    <h3 class="settings-section-title">Directories</h3>

                    <div class="settings-field">
                        <label class="settings-label">Base Directory</label>
                        <div class="settings-browse-row">
                            <input type="text" class="settings-input"
                                   @bind="_settings.DefaultStartFolder"
                                   placeholder="/path/to/tenant-root" />
                            <button class="btn fpicker-browse-btn"
                                    @onclick="() => BrowseDirAsync(null)"
                                    title="Browse for folder">Browse…</button>
                        </div>
                        <span class="settings-hint">The root folder shown in the directory picker.</span>
                    </div>

                    <div class="settings-field">
                        <label class="settings-label">Artifacts Directory</label>
                        <div class="settings-browse-row">
                            <input type="text" class="settings-input"
                                   @bind="_settings.ProjectArtifacts"
                                   placeholder="Defaults to &lt;project&gt;/artifacts" />
                            <button class="btn fpicker-browse-btn"
                                    @onclick="() => BrowseDirAsync(true)"
                                    title="Browse for folder">Browse…</button>
                        </div>
                        <span class="settings-hint">Where processed JSON and export files are written.</span>
                    </div>
                </section>

                <!-- ── Database ───────────────────────────────────────── -->
                <section class="settings-section">
                    <h3 class="settings-section-title">Database</h3>

                    <div class="settings-field">
                        <label class="settings-label">Identity Connection String</label>
                        <input type="text" class="settings-input"
                               @bind="_settings.Database!.IdentityConnectionString"
                               placeholder="Data Source=kocr.db" />
                        <span class="settings-hint">Central identity database (users, roles, organisations). Per-org OCR databases are managed automatically.</span>
                    </div>

                    <div class="settings-field">
                        <label class="settings-label">Provider</label>
                        <select class="settings-select" @bind="_settings.Database!.Provider">
                            <option value="SQLite">SQLite</option>
                            <option value="SQLServer">SQL Server</option>
                            <option value="PostgreSQL">PostgreSQL</option>
                        </select>
                    </div>

                    <div class="settings-field settings-field-inline">
                        <label class="settings-label">WAL Mode</label>
                        <input type="checkbox" class="settings-checkbox"
                               @bind="_settings.Database!.UseWalMode" />
                        <span class="settings-hint">Enable SQLite WAL mode (avoid on external drives).</span>
                    </div>

                    <div class="settings-field settings-field-inline">
                        <label class="settings-label">Sensitive Data Logging</label>
                        <input type="checkbox" class="settings-checkbox"
                               @bind="_settings.Database!.EnableSensitiveDataLogging" />
                        <span class="settings-hint">Logs query parameter values — development only.</span>
                    </div>

                    <div class="settings-field settings-field-inline">
                        <label class="settings-label">Detailed Error Messages</label>
                        <input type="checkbox" class="settings-checkbox"
                               @bind="_settings.Database!.EnableDetailedErrors" />
                    </div>
                </section>

                <!-- ── Danger Zone ────────────────────────────────────── -->
                <section class="settings-section settings-danger-zone">
                    <h3 class="settings-section-title settings-danger-title">⚠ Danger Zone</h3>

                    <div class="settings-field settings-field-inline">
                        <div class="settings-danger-desc">
                            <strong>Clear All Data</strong>
                            <span class="settings-hint">Removes every OCR result and validated invoice from the database and deletes all artifact files. This cannot be undone.</span>
                        </div>
                        <button class="btn btn-danger" @onclick="ShowClearConfirmAsync" disabled="@_clearing">
                            @(_clearing ? "Clearing…" : "🗑 Clear All Data")
                        </button>
                    </div>
                </section>

            </div>

        </div>
    </div>

    <ConfirmDialog @ref="_confirmDialog"
                   Title="Clear All Data?"
                   Message="This will permanently delete every OCR result, validated invoice, and artifact file. This cannot be undone."
                   ConfirmLabel="Yes, clear everything"
                   Danger="true"
                   OnConfirmed="ClearAllDataAsync" />

}

<FolderPickerDialog @ref="_folderPicker" />


@code {
    private AppSettings _settings = new() { Database = new DatabaseSettings() };
    private bool _saving;
    private bool _saved;
    private bool _clearing;
    private bool _visible;
    private string? _error;
    private ConfirmDialog?       _confirmDialog;
    private FolderPickerDialog? _folderPicker;

    protected override void OnInitialized()
    {
        SettingsSvc.OpenRequested += OnOpenRequested;
    }

    public void Dispose()
    {
        SettingsSvc.OpenRequested -= OnOpenRequested;
    }

    private void OnOpenRequested()
    {
        _saved   = false;
        _error   = null;
        _visible = true;
        StateHasChanged();
        _ = LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var loaded = await ConfigService.LoadSettingsAsync();
            loaded.Database ??= new DatabaseSettings();
            _settings = loaded;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load settings: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancel()
    {
        _visible = false;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        _error = null;

        try
        {
            await ConfigService.SaveSettingsAsync(_settings);
            _saved = true;
            _visible = false;
        }
        catch (Exception ex)
        {
            _error = $"Failed to save settings: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private Task ShowClearConfirmAsync() =>
        _confirmDialog?.ShowAsync() ?? Task.CompletedTask;

    private async Task ClearAllDataAsync()
    {
        _clearing = true;
        try
        {
            // 1. Wipe the database
            await DatabaseSvc.ClearAllDataAsync();

            // 2. Delete all artifact files
            var settings = await ConfigService.LoadSettingsAsync();
            if (!string.IsNullOrEmpty(settings.ProjectArtifacts)
                && Directory.Exists(settings.ProjectArtifacts))
            {
                foreach (var f in Directory.EnumerateFiles(
                    settings.ProjectArtifacts, "*", SearchOption.AllDirectories))
                {
                    try { File.Delete(f); } catch { /* best-effort */ }
                }
            }

            // 3. Reset the in-memory file list so status dots are cleared
            var resetFiles = State.Files
                .Select(f => new FileListEntry
                {
                    FilePath         = f.FilePath,
                    FileName         = f.FileName,
                    IsProcessed      = false,
                    IsValidated      = false,
                    HasSuspectFields = false,
                })
                .ToList<FileListEntry>();
            State.SetDirectory(State.CurrentDirectory, resetFiles, "All data cleared.");
            State.SelectFile(null);

            Toast.ShowSuccess("All OCR data and artifacts cleared.");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Clear failed: {ex.Message}");
        }
        finally
        {
            _clearing = false;
        }
    }

    private async Task BrowseDirAsync(bool? isArtifactsDir)
    {
        if (_folderPicker is null) return;
        // Base directory: unconstrained — user picks the root itself
        // Artifacts directory: always unconstrained
        string? current = isArtifactsDir == true ? _settings.ProjectArtifacts : _settings.DefaultStartFolder;
        var chosen = await _folderPicker.ShowAsync(current, null);
        if (chosen is null) return;
        if (isArtifactsDir == true)
            _settings.ProjectArtifacts = chosen;
        else
            _settings.DefaultStartFolder = chosen;
    }
}
