@page "/settings"
@rendermode InteractiveServer
@using K_OCR.Configuration
@inject IConfigurationService ConfigService
@inject NavigationManager Nav

<PageTitle>Settings – K-OCR</PageTitle>

<div class="settings-page">
    <div class="settings-header">
        <h2 class="settings-title">Settings</h2>
        <div class="settings-header-actions">
            <button class="btn btn-save" @onclick="SaveAsync" disabled="@_saving">
                @(_saving ? "Saving…" : "Save")
            </button>
            <button class="btn btn-cancel" @onclick="Cancel">Cancel</button>
        </div>
    </div>

    @if (_saved)
    {
        <div class="settings-banner settings-banner-success">
            ✓ Settings saved. Some changes (e.g. Azure key, database) take effect after restart.
        </div>
    }

    @if (_error is not null)
    {
        <div class="settings-banner settings-banner-error">⚠ @_error</div>
    }

    <div class="settings-content">

        <!-- ── Azure Document Intelligence ───────────────────── -->
        <section class="settings-section">
            <h3 class="settings-section-title">Azure Document Intelligence</h3>

            <div class="settings-field">
                <label class="settings-label">API Key</label>
                <input type="password" class="settings-input"
                       @bind="_settings.AzureCognitiveServicesKey"
                       placeholder="Paste your Azure API key" />
            </div>

            <div class="settings-field">
                <label class="settings-label">Endpoint URL</label>
                <input type="url" class="settings-input"
                       @bind="_settings.AzureCognitiveServicesEndpoint"
                       placeholder="https://your-resource.cognitiveservices.azure.com/" />
            </div>
        </section>

        <!-- ── OCR ────────────────────────────────────────────── -->
        <section class="settings-section">
            <h3 class="settings-section-title">OCR</h3>

            <div class="settings-field">
                <label class="settings-label">Provider</label>
                <select class="settings-select" @bind="_settings.OCRProvider">
                    <option value="Azure">Azure Document Intelligence</option>
                    <option value="Tesseract">Tesseract (local)</option>
                </select>
            </div>

            <div class="settings-field">
                <label class="settings-label">Max Concurrent Requests</label>
                <input type="number" class="settings-input settings-input-narrow"
                       min="1" max="20" step="1"
                       @bind="_settings.MaxConcurrentRequests" />
                <span class="settings-hint">How many OCR requests to run in parallel (1–20).</span>
            </div>
        </section>

        <!-- ── Validation ─────────────────────────────────────── -->
        <section class="settings-section">
            <h3 class="settings-section-title">Validation</h3>

            <div class="settings-field">
                <label class="settings-label">Min Confidence Threshold</label>
                <input type="number" class="settings-input settings-input-narrow"
                       min="0" max="1" step="0.05"
                       @bind="_settings.MinConfidenceThreshold" />
                <span class="settings-hint">
                    Fields whose Azure confidence score is below this value (0.0–1.0) are flagged.
                </span>
            </div>
        </section>

        <!-- ── Directories ────────────────────────────────────── -->
        <section class="settings-section">
            <h3 class="settings-section-title">Directories</h3>

            <div class="settings-field">
                <label class="settings-label">Project Directory</label>
                <input type="text" class="settings-input"
                       @bind="_settings.ProjectDirectory"
                       placeholder="/path/to/invoices" />
                <span class="settings-hint">Root folder that K-OCR will open by default.</span>
            </div>

            <div class="settings-field">
                <label class="settings-label">Artifacts Directory</label>
                <input type="text" class="settings-input"
                       @bind="_settings.ProjectArtifacts"
                       placeholder="Defaults to &lt;project&gt;/artifacts" />
                <span class="settings-hint">Where processed JSON and export files are written.</span>
            </div>
        </section>

        <!-- ── Database ───────────────────────────────────────── -->
        <section class="settings-section">
            <h3 class="settings-section-title">Database</h3>

            <div class="settings-field">
                <label class="settings-label">Connection String</label>
                <input type="text" class="settings-input"
                       @bind="_settings.Database!.ConnectionString"
                       placeholder="Data Source=kocr.db" />
            </div>

            <div class="settings-field">
                <label class="settings-label">Provider</label>
                <select class="settings-select" @bind="_settings.Database!.Provider">
                    <option value="SQLite">SQLite</option>
                    <option value="SQLServer">SQL Server</option>
                    <option value="PostgreSQL">PostgreSQL</option>
                </select>
            </div>

            <div class="settings-field settings-field-inline">
                <label class="settings-label">WAL Mode</label>
                <input type="checkbox" class="settings-checkbox"
                       @bind="_settings.Database!.UseWalMode" />
                <span class="settings-hint">Enable SQLite WAL mode (avoid on external drives).</span>
            </div>

            <div class="settings-field settings-field-inline">
                <label class="settings-label">Sensitive Data Logging</label>
                <input type="checkbox" class="settings-checkbox"
                       @bind="_settings.Database!.EnableSensitiveDataLogging" />
                <span class="settings-hint">Logs query parameter values — development only.</span>
            </div>

            <div class="settings-field settings-field-inline">
                <label class="settings-label">Detailed Error Messages</label>
                <input type="checkbox" class="settings-checkbox"
                       @bind="_settings.Database!.EnableDetailedErrors" />
            </div>
        </section>

    </div>
</div>

@code {
    private AppSettings _settings = new() { Database = new DatabaseSettings() };
    private bool _saving;
    private bool _saved;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _settings = await ConfigService.LoadSettingsAsync();
        _settings.Database ??= new DatabaseSettings();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        _error = null;

        try
        {
            await ConfigService.SaveSettingsAsync(_settings);
            _saved = true;
        }
        catch (Exception ex)
        {
            _error = $"Failed to save settings: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => Nav.NavigateTo("/");
}
