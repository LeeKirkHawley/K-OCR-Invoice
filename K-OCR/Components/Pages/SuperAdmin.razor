@using K_OCR.Configuration
@using K_OCR.Models.Api.SuperAdmin
@inject WorkspaceState State
@inject ISuperAdminService SuperAdminSvc
@inject ToastService Toast
@inject SuperAdminDialogService SuperAdminDialogSvc
@inject EmailConfigDialogService EmailConfigDialogSvc
@implements IDisposable

@if (_visible)
{
<div class="superadmin-overlay" @onclick="Close">
    <div class="superadmin-dialog" @onclick:stopPropagation="true">
        <div class="superadmin-header">
            <h1 class="superadmin-title">Super Admin Console</h1>
            <button class="btn btn-cancel" @onclick="Close">✕</button>
        </div>
        <div class="superadmin-content">
    @if (!State.IsSuperAdmin)
    {
        <div class="alert alert-warning">
            Super admin privileges are required to view organizations.
        </div>
    }
    else
    {
        <p>Create organizations, issue temporary credentials, and revoke access.</p>
        <div class="admin-grid">
            <section class="admin-panel">
                <h2>Create organization</h2>
                <p>New organizations get an administrative user with a temporary password.</p>
                <EditForm Model="_createModel" OnValidSubmit="CreateOrganizationAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="mb-3">
                        <label class="form-label">Organization name</label>
                        <InputText class="form-control" @bind-Value="_createModel.Name" />
                        <ValidationMessage For="() => _createModel.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" @bind-Value="_createModel.Description" rows="2" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Admin name</label>
                        <InputText class="form-control" @bind-Value="_createModel.AdminName" placeholder="Full name" />
                        <ValidationMessage For="() => _createModel.AdminName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Admin email</label>
                        <InputText class="form-control" @bind-Value="_createModel.AdminEmail" />
                        <ValidationMessage For="() => _createModel.AdminEmail" />
                    </div>
                    <button type="submit" class="btn btn-primary" disabled="@_isCreating">
                        @(_isCreating ? "Creating…" : "Create organization")
                    </button>
                </EditForm>
                @if (_creationResult is not null)
                {
                    <div class="creation-result">
                        <h3>Organization created</h3>
                        @if (_creationResult.EmailSent)
                        {
                            <p class="text-success">
                                ✓ Invite email sent to <strong>@_creationResult.AdminEmail</strong>.
                            </p>
                        }
                        else
                        {
                            <p class="text-warning">
                                ⚠ Email could not be sent (check SMTP settings). Share this setup link manually:
                            </p>
                            <div class="mb-2">
                                <label class="form-label small">Setup link</label>
                                <input class="form-control form-control-sm font-monospace" readonly
                                       value="@_creationResult.SetupLink" />
                            </div>
                        }
                        <p class="small text-muted mt-2">
                            Admin: <strong>@_creationResult.AdminName</strong> &lt;@_creationResult.AdminEmail&gt;
                        </p>
                    </div>
                }
            </section>

            <section class="admin-panel">
                <h2>Organizations</h2>
                @if (_isLoading)
                {
                    <div class="text-muted">Loading organizations…</div>
                }
                else if (_organizations.Length == 0)
                {
                    <div class="text-muted">No organizations have been created yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Users</th>
                                    <th>Created</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var org in _organizations)
                                {
                                    <tr>
                                        <td><strong>@org.Name</strong><br /><small>@org.Description</small></td>
                                        <td>@org.UserCount</td>
                                        <td>@org.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                        <td>
                                            <span class="status-pill @(org.IsActive ? "status-active" : "status-inactive")">
                                                @(org.IsActive ? "Active" : "Revoked")
                                            </span>
                                        </td>
                                        <td class="d-flex gap-1">
                                            <button class="btn btn-sm btn-outline-danger"
                                                    disabled="@(!org.IsActive || _revokingOrgId == org.OrganizationId)"
                                                    @onclick="() => RevokeOrganizationAsync(org.OrganizationId)">
                                                @( _revokingOrgId == org.OrganizationId ? "Revoking…" : "Revoke" )
                                            </button>
                                            <button class="btn btn-sm btn-outline-success"
                                                    disabled="@(org.IsActive || _reEnablingOrgId == org.OrganizationId)"
                                                    @onclick="() => ReEnableOrganizationAsync(org.OrganizationId)">
                                                @( _reEnablingOrgId == org.OrganizationId ? "Enabling…" : "Re-enable" )
                                            </button>
                                            <button class="btn btn-sm btn-danger"
                                                    disabled="@(org.IsActive || _deletingOrgId == org.OrganizationId)"
                                                    @onclick="() => RequestDeleteOrganization(org.OrganizationId, org.Name)">
                                                @( _deletingOrgId == org.OrganizationId ? "Deleting…" : "Delete" )
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

        </div>
        <div style="padding:12px 16px;border-top:1px solid var(--border-color,#dee2e6);text-align:right">
            <button class="btn btn-sm btn-outline-secondary" @onclick="OpenEmailConfig">Email configuration…</button>
        </div>
    }
        </div>
    </div>
</div>
}

@if (_confirmDeleteOrgId is not null)
{
    <div class="confirm-delete-overlay" @onclick="CancelDelete">
        <div class="confirm-delete-dialog" @onclick:stopPropagation="true">
            <div class="confirm-delete-icon">&#9888;</div>
            <h2 class="confirm-delete-title">Delete organization?</h2>
            <p class="confirm-delete-body">
                You are about to permanently delete
                <strong>@_confirmDeleteOrgName</strong>
                and all of its users and data.
            </p>
            <p class="confirm-delete-body confirm-delete-warning">
                This action cannot be undone.
            </p>
            <div class="confirm-delete-actions">
                <button class="btn btn-outline-secondary" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-danger" disabled="@(_deletingOrgId is not null)"
                        @onclick="ConfirmDeleteAsync">
                    @(_deletingOrgId is not null ? "Deleting…" : "Yes, permanently delete")
                </button>
            </div>
        </div>
    </div>
}

@if (_errorDialogMessage is not null)
{
    <div class="confirm-delete-overlay" @onclick="CloseErrorDialog">
        <div class="confirm-delete-dialog" @onclick:stopPropagation="true">
            <div class="confirm-delete-icon">&#9888;</div>
            <h2 class="confirm-delete-title">Cannot create organization</h2>
            <p class="confirm-delete-body">@_errorDialogMessage</p>
            <div class="confirm-delete-actions">
                <button class="btn btn-outline-secondary" @onclick="CloseErrorDialog">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _visible;
    private readonly CreateOrganizationRequest _createModel = new();
    private OrganizationOverview[] _organizations = Array.Empty<OrganizationOverview>();
    private CreateOrganizationResult? _creationResult;
    private bool _isLoading;
    private bool _isCreating;
    private string? _revokingOrgId;
    private string? _reEnablingOrgId;
    private string? _deletingOrgId;
    private string? _confirmDeleteOrgId;
    private string? _confirmDeleteOrgName;
    private string? _errorDialogMessage;

    protected override void OnInitialized()
    {
        SuperAdminDialogSvc.OpenRequested += OnOpenRequested;
    }

    public void Dispose()
    {
        SuperAdminDialogSvc.OpenRequested -= OnOpenRequested;
    }

    private void OnOpenRequested()
    {
        _visible = true;
        StateHasChanged();
        _ = LoadDataAsync();
    }

    private void Close()
    {
        _visible = false;
        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        if (State.IsSuperAdmin)
        {
            await LoadOrganizationsAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadOrganizationsAsync()
    {
        _isLoading = true;
        try
        {
            _organizations = await SuperAdminSvc.ListOrganizationsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Unable to load organizations: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenEmailConfig()
    {
        _visible = false;
        EmailConfigDialogSvc.RequestOpen();
    }

    private async Task CreateOrganizationAsync()
    {
        _isCreating = true;
        try
        {
            _creationResult = await SuperAdminSvc.CreateOrganizationAsync(_createModel);
            Toast.ShowSuccess("Organization created" + (_creationResult.EmailSent ? " — invite email sent." : " — share the setup link manually."));
            _createModel.Name = string.Empty;
            _createModel.Description = string.Empty;
            _createModel.AdminName = string.Empty;
            _createModel.AdminEmail = string.Empty;
            await LoadOrganizationsAsync();
        }
        catch (DuplicateOrganizationNameException ex)
        {
            _errorDialogMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Create failed: {ex.Message}");
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task RevokeOrganizationAsync(string organizationId)
    {
        _revokingOrgId = organizationId;
        try
        {
            await SuperAdminSvc.RevokeOrganizationAsync(organizationId);
            Toast.ShowSuccess("Organization revoked.");
            await LoadOrganizationsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Revoke failed: {ex.Message}");
        }
        finally
        {
            _revokingOrgId = null;
        }
    }

    private async Task ReEnableOrganizationAsync(string organizationId)
    {
        _reEnablingOrgId = organizationId;
        try
        {
            await SuperAdminSvc.ReEnableOrganizationAsync(organizationId);
            Toast.ShowSuccess("Organization re-enabled.");
            await LoadOrganizationsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Re-enable failed: {ex.Message}");
        }
        finally
        {
            _reEnablingOrgId = null;
        }
    }

    private async Task DeleteOrganizationAsync(string organizationId)
    {
        _deletingOrgId = organizationId;
        _confirmDeleteOrgId = null;
        _confirmDeleteOrgName = null;
        try
        {
            await SuperAdminSvc.DeleteOrganizationAsync(organizationId);
            Toast.ShowSuccess("Organization deleted.");
            await LoadOrganizationsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Delete failed: {ex.Message}");
        }
        finally
        {
            _deletingOrgId = null;
        }
    }

    private void RequestDeleteOrganization(string organizationId, string orgName)
    {
        _confirmDeleteOrgId = organizationId;
        _confirmDeleteOrgName = orgName;
    }

    private void CancelDelete()
    {
        _confirmDeleteOrgId = null;
        _confirmDeleteOrgName = null;
    }

    private void CloseErrorDialog()
    {
        _errorDialogMessage = null;
    }

    private Task ConfirmDeleteAsync() => DeleteOrganizationAsync(_confirmDeleteOrgId!);
}
