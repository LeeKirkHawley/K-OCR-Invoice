@using System
@using K_OCR.Models.Api.OrganizationAdmin
@using K_OCR.Security
@inject WorkspaceState State
@inject IOrganizationAdminService OrgAdminSvc
@inject ToastService Toast
@inject OrgUserManagementDialogService OrgUserMgmtDialogSvc
@implements IDisposable

@if (_visible)
{
<div class="superadmin-overlay" @onclick="Close">
    <div class="superadmin-dialog" style="max-width:780px" @onclick:stopPropagation="true">
        <div class="superadmin-header">
            <h1 class="superadmin-title">Manage Users</h1>
            <button class="btn btn-cancel" @onclick="Close">✕</button>
        </div>
        <div class="superadmin-content">
    @if (!State.IsOrganizationAdmin)
    {
        <div class="alert alert-warning">
            Organization admin privileges are required to manage users.
        </div>
    }
    else
    {
        <div class="admin-grid">
            <!-- Invite panel -->
            <section class="admin-panel">
                <h2>Invite user</h2>
                <p>Invited users receive an email with a link to set their password. If email is not configured, a setup link is provided here for manual sharing.</p>
                <EditForm Model="_inviteModel" OnValidSubmit="InviteUserAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <InputText class="form-control" @bind-Value="_inviteModel.Name" placeholder="Jane Smith" />
                        <ValidationMessage For="() => _inviteModel.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="_inviteModel.Email" placeholder="jane@example.com" />
                        <ValidationMessage For="() => _inviteModel.Email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <InputSelect class="form-select" @bind-Value="_inviteModel.Role">
                            <option value="@RoleNames.OrganizationAdmin">Administrator</option>
                            <option value="@RoleNames.OrganizationValidator">Validator</option>
                            <option value="@RoleNames.OrganizationUser">User</option>
                        </InputSelect>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@_isInviting">
                        @(_isInviting ? "Inviting…" : "Send invite")
                    </button>
                </EditForm>
            </section>

            <!-- User list panel -->
            <section class="admin-panel">
                <h2>Current users</h2>
                @if (_isLoading)
                {
                    <div class="text-muted">Loading users…</div>
                }
                else if (_users.Length == 0)
                {
                    <div class="text-muted">No users have been invited yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in _users)
                                {
                                    var u = user;
                                    <tr>
                                        <td>@(u.FullName ?? "—")</td>
                                        <td>@u.Email</td>
                                        <td>@FriendlyRoles(u.Roles)</td>
                                        <td>
                                            <span class="status-pill @(u.IsActive ? "status-active" : "status-inactive")">
                                                @(u.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            @if (u.UserId != State.CurrentUserId)
                                            {
                                                <button class="btn btn-sm btn-danger"
                                                        @onclick="() => ConfirmRemoveUser(u)"
                                                        title="Remove user">
                                                    Remove
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
        </div>
    </div>
</div>
}

@* Setup-link dialog shown when SMTP is not configured *@
@if (_showSetupLink && _pendingSetupLink is not null)
{
    <div class="superadmin-overlay" @onclick="CloseSetupLink">
        <div class="superadmin-dialog" style="max-width:520px" @onclick:stopPropagation="true">
            <div class="superadmin-header">
                <h1 class="superadmin-title">Share this link</h1>
                <button class="btn btn-cancel" @onclick="CloseSetupLink">✕</button>
            </div>
            <div class="superadmin-content">
                <p>Email is not configured. Share the following link with <strong>@_pendingInviteeName</strong> so they can set their password:</p>
                <div class="input-group mb-3">
                    <input type="text" class="form-control" readonly value="@_pendingSetupLink" />
                    <button class="btn btn-outline-secondary" @onclick="CopySetupLink">Copy</button>
                </div>
                <p class="text-muted small">This link expires in 24 hours.</p>
            </div>
        </div>
    </div>
}

@* Remove-user confirmation dialog *@
@if (_userToRemove is not null)
{
    <div class="superadmin-overlay" @onclick="CancelRemove">
        <div class="superadmin-dialog" style="max-width:420px" @onclick:stopPropagation="true">
            <div class="superadmin-header">
                <h1 class="superadmin-title">Remove User</h1>
                <button class="btn btn-cancel" @onclick="CancelRemove">✕</button>
            </div>
            <div class="superadmin-content">
                <p>Remove <strong>@(_userToRemove.FullName ?? _userToRemove.Email)</strong> from the organization? This cannot be undone.</p>
                <div class="d-flex gap-2 justify-content-end mt-3">
                    <button class="btn btn-secondary" @onclick="CancelRemove">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecuteRemoveUserAsync">Remove</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _visible;
    private readonly InviteUserRequest _inviteModel = new();
    private OrganizationUserOverview[] _users = Array.Empty<OrganizationUserOverview>();
    private bool _isLoading;
    private bool _isInviting;

    // Setup-link dialog
    private bool _showSetupLink;
    private string? _pendingSetupLink;
    private string? _pendingInviteeName;

    // Remove confirmation
    private OrganizationUserOverview? _userToRemove;

    protected override void OnInitialized()
    {
        OrgUserMgmtDialogSvc.OpenRequested += OnOpenRequested;
    }

    public void Dispose()
    {
        OrgUserMgmtDialogSvc.OpenRequested -= OnOpenRequested;
    }

    private void OnOpenRequested()
    {
        _visible = true;
        StateHasChanged();
        if (State.IsOrganizationAdmin)
            _ = LoadUsersAsync();
    }

    private void Close()
    {
        _visible = false;
        StateHasChanged();
    }

    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        try
        {
            var tenantId = State.TenantId ?? string.Empty;
            _users = await OrgAdminSvc.GetOrgUsersAsync(tenantId);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Unable to load users: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task InviteUserAsync()
    {
        _isInviting = true;
        try
        {
            var tenantId = State.TenantId ?? throw new InvalidOperationException("No tenant context.");
            var result = await OrgAdminSvc.InviteUserAsync(tenantId, _inviteModel);

            if (result.EmailSent)
            {
                Toast.ShowSuccess($"Invitation sent to {_inviteModel.Email}.");
            }
            else
            {
                _pendingSetupLink  = result.SetupLink;
                _pendingInviteeName = _inviteModel.Name;
                _showSetupLink = true;
            }

            _inviteModel.Name  = string.Empty;
            _inviteModel.Email = string.Empty;
            _inviteModel.Role  = "OrganizationUser";
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Invite failed: {ex.Message}");
        }
        finally
        {
            _isInviting = false;
        }
    }

    private void CloseSetupLink()
    {
        _showSetupLink     = false;
        _pendingSetupLink  = null;
        _pendingInviteeName = null;
    }

    private async Task CopySetupLink()
    {
        // JS interop not injected here; just select all in the input via toast fallback
        Toast.ShowInfo("Copy the link from the text box above.");
        await Task.CompletedTask;
    }

    private void ConfirmRemoveUser(OrganizationUserOverview user)
    {
        _userToRemove = user;
    }

    private void CancelRemove()
    {
        _userToRemove = null;
    }

    private async Task ExecuteRemoveUserAsync()
    {
        if (_userToRemove is null) return;
        var removing = _userToRemove;
        _userToRemove = null;
        try
        {
            var tenantId = State.TenantId ?? throw new InvalidOperationException("No tenant context.");
            await OrgAdminSvc.RemoveUserAsync(removing.UserId, tenantId);
            Toast.ShowSuccess($"{removing.FullName ?? removing.Email} has been removed.");
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Remove failed: {ex.Message}");
        }
    }

    private static string FriendlyRoles(string[] roles)
    {
        if (roles.Length == 0) return "—";
        return string.Join(", ", roles.Select(r => r switch
        {
            "OrganizationAdmin"     => "Admin",
            "OrganizationValidator" => "Validator",
            "OrganizationUser"      => "User",
            _                       => r
        }));
    }
}
