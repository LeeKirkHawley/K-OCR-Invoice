@using System.Security.Claims
@using System.Text.RegularExpressions
@using K_OCR.Models.Api.SuperAdmin
@inject WorkspaceState State
@inject IBatchService BatchSvc
@inject ISuperAdminService SuperAdminSvc
@inject ToastService Toast
@inject BatchDialogService BatchDialogSvc
@implements IDisposable

@if (_visible)
{
<div class="superadmin-overlay" @onclick="Close">
    <div class="superadmin-dialog manage-batches-dialog" @onclick:stopPropagation="true">

        <div class="superadmin-header">
            <h1 class="superadmin-title">Manage Batches</h1>
            <button class="btn btn-cancel" @onclick="Close">✕</button>
        </div>

        <div class="superadmin-content">

            @if (!State.IsOrganizationAdmin)
            {
                <div class="alert alert-warning">
                    Organization admin privileges are required to manage batches.
                </div>
            }
            else
            {
                @* Error dialog *@
                @if (_errorMessage is not null)
                {
                    <div class="alert alert-danger d-flex align-items-start gap-2">
                        <span class="flex-grow-1">@_errorMessage</span>
                        <button class="btn btn-sm btn-close" @onclick="() => _errorMessage = null" aria-label="Dismiss"></button>
                    </div>
                }

                @* Batch list *@
                @if (_isLoading)
                {
                    <div class="text-muted mb-3">Loading batches…</div>
                }
                else if (_batches.Count == 0)
                {
                    <div class="text-muted mb-3">No batches found. Use the button below to create one.</div>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    @if (State.IsSuperAdmin)
                                    {
                                        <th>Organization</th>
                                    }
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Files</th>
                                    <th>All Validated</th>
                                    <th>Created</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var batch in _batches)
                                {
                                    <tr>
                                        @if (State.IsSuperAdmin)
                                        {
                                            <td>@(_orgNameMap.TryGetValue(batch.OrganizationId, out var n) ? n : batch.OrganizationId)</td>
                                        }
                                        <td>@batch.BatchNumber</td>
                                        <td>@batch.Name</td>
                                        <td>@batch.FileCount</td>
                                        <td>
                                            @if (batch.AllValidated)
                                            {
                                                <span class="text-success fw-bold">✓ Yes</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@batch.ValidatedCount / @batch.FileCount</span>
                                            }
                                        </td>
                                        <td>@batch.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                        <td class="batch-actions">
                                            @if (_confirmDeleteId == batch.BatchId)
                                            {
                                                <span class="me-1">Delete?</span>
                                                <button class="btn btn-xs btn-danger me-1"
                                                        disabled="@_isDeleting"
                                                        @onclick="() => ConfirmDeleteAsync(batch.BatchId)">
                                                    @(_isDeleting ? "…" : "Yes")
                                                </button>
                                                <button class="btn btn-xs btn-secondary"
                                                        disabled="@_isDeleting"
                                                        @onclick="() => _confirmDeleteId = null">
                                                    No
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-xs btn-outline-secondary me-1"
                                                        title="Process unprocessed invoices in this batch"
                                                        @onclick="() => TriggerOcrAsync(batch.BatchId)">
                                                    ▶ Process
                                                </button>
                                                <button class="btn btn-xs btn-outline-secondary me-1"
                                                        title="Export as CSV (not yet implemented)"
                                                        @onclick="() => ExportCsvStub(batch.BatchId)">
                                                    CSV
                                                </button>
                                                <button class="btn btn-xs btn-outline-secondary me-1"
                                                        title="Export as Excel (not yet implemented)"
                                                        @onclick="() => ExportExcelStub(batch.BatchId)">
                                                    Excel
                                                </button>
                                                <button class="btn btn-xs btn-outline-danger"
                                                        title="Delete this batch and all its files"
                                                        @onclick="() => _confirmDeleteId = batch.BatchId">
                                                    Delete
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* Inline create form *@
                @if (_showCreateForm)
                {
                    <div class="batch-create-form mb-3 p-3 border rounded">
                        <h2 class="h6 mb-2">Create New Batch</h2>
                        <div class="mb-2">
                            <label class="form-label mb-1">Batch Name</label>
                            <input class="form-control form-control-sm"
                                   value="@_newBatchName"
                                   @oninput="OnBatchNameInput"
                                   placeholder="e.g. Batch 1"
                                   disabled="@_isCreating" />
                            @if (_nameValidationMessage is not null)
                            {
                                <div class="@(_nameIsError ? "text-danger" : "text-warning") small mt-1">
                                    @_nameValidationMessage
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_newBatchName) && _nameValidationMessage is null)
                            {
                                <div class="text-muted small mt-1">
                                    Folder: <code>@_sanitizedPreview</code>
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-primary"
                                    disabled="@(_isCreating || _nameIsError || string.IsNullOrWhiteSpace(_newBatchName))"
                                    @onclick="CreateBatchAsync">
                                @(_isCreating ? "Creating…" : "Create")
                            </button>
                            <button class="btn btn-sm btn-secondary"
                                    disabled="@_isCreating"
                                    @onclick="CancelCreate">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <button class="btn btn-sm btn-primary" @onclick="ShowCreateForm">
                        + Create Batch
                    </button>
                }
            }
        </div>
    </div>
</div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _visible;
    private bool _isLoading;
    private bool _isCreating;
    private bool _isDeleting;
    private List<BatchDetail> _batches = new();
    private Dictionary<string, string> _orgNameMap = new();
    private string? _errorMessage;

    // Create form
    private bool _showCreateForm;
    private string _newBatchName = string.Empty;
    private string? _nameValidationMessage;
    private bool _nameIsError;
    private string _sanitizedPreview = string.Empty;

    // Delete confirmation
    private int? _confirmDeleteId;

    protected override void OnInitialized()
    {
        BatchDialogSvc.OpenRequested += OnOpenRequested;
    }

    public void Dispose()
    {
        BatchDialogSvc.OpenRequested -= OnOpenRequested;
    }

    private void OnOpenRequested()
    {
        _visible          = true;
        _showCreateForm   = false;
        _newBatchName     = string.Empty;
        _nameValidationMessage = null;
        _nameIsError      = false;
        _confirmDeleteId  = null;
        _errorMessage     = null;
        InvokeAsync(LoadBatchesAsync);
        StateHasChanged();
    }

    private async Task LoadBatchesAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            BatchSummary[] summaries;
            if (State.IsSuperAdmin)
            {
                summaries = await BatchSvc.GetAllBatchesAsync();
                var orgs = await SuperAdminSvc.ListOrganizationsAsync();
                _orgNameMap = orgs.ToDictionary(o => o.OrganizationId, o => o.Name);
            }
            else
            {
                var orgId = State.TenantId ?? string.Empty;
                summaries = await BatchSvc.GetBatchesForOrgAsync(orgId);
            }

            // Enrich each summary with file/validated counts
            var details = await Task.WhenAll(
                summaries.Select(async s =>
                {
                    var d = await BatchSvc.GetBatchDetailAsync(s.BatchId);
                    return d ?? new BatchDetail
                    {
                        BatchId        = s.BatchId,
                        OrganizationId = s.OrganizationId,
                        Name           = s.Name,
                        BatchNumber    = s.BatchNumber,
                        FolderPath     = s.FolderPath,
                        CreatedAtUtc   = s.CreatedAtUtc,
                        CreatedByUserId = s.CreatedByUserId,
                    };
                }));

            _batches = [.. details.OrderBy(b => b.OrganizationId).ThenBy(b => b.BatchNumber)];
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void Close()
    {
        _visible = false;
        StateHasChanged();
    }

    // ── Create ────────────────────────────────────────────────────────────────

    private async Task ShowCreateForm()
    {
        _showCreateForm = true;
        _nameIsError    = false;
        _nameValidationMessage = null;

        // Pre-fill as "Batch N"
        var nextNumber = _batches.Count > 0
            ? _batches.Where(b => b.OrganizationId == State.TenantId)
                      .Select(b => b.BatchNumber)
                      .DefaultIfEmpty(0)
                      .Max() + 1
            : await BatchSvc.GetNextBatchNumberAsync(State.TenantId ?? string.Empty);

        _newBatchName    = $"Batch {nextNumber}";
        _sanitizedPreview = SanitizePreview(_newBatchName);
    }

    private void CancelCreate()
    {
        _showCreateForm = false;
    }

    private void OnBatchNameInput(ChangeEventArgs e)
    {
        _newBatchName = e.Value?.ToString() ?? string.Empty;
        ValidateBatchName(_newBatchName);
    }

    private void ValidateBatchName(string name)
    {
        _sanitizedPreview = SanitizePreview(name);

        if (string.IsNullOrWhiteSpace(name))
        {
            _nameValidationMessage = "Batch name is required.";
            _nameIsError = true;
            return;
        }

        // Warn if name contains characters that will be replaced
        var hasIllegalChars = Regex.IsMatch(name, @"[^A-Za-z0-9 _\-]");
        if (hasIllegalChars)
        {
            _nameValidationMessage = "Name contains characters that will be replaced with \"_\" in the folder path.";
            _nameIsError = false; // warning only — not blocking
            return;
        }

        _nameValidationMessage = null;
        _nameIsError = false;
    }

    private static string SanitizePreview(string name) =>
        Regex.Replace(name ?? string.Empty, @"[^A-Za-z0-9_\-]", "_");

    private async Task CreateBatchAsync()
    {
        if (string.IsNullOrWhiteSpace(_newBatchName)) return;
        _isCreating = true;
        StateHasChanged();

        try
        {
            var userId = await GetUserIdAsync();
            var request = new CreateBatchRequest
            {
                OrganizationId  = State.TenantId ?? string.Empty,
                Name            = _newBatchName.Trim(),
                CreatedByUserId = userId,
                OrgName         = State.TenantName ?? string.Empty,
            };

            var result = await BatchSvc.CreateBatchAsync(request);
            if (result.Success)
            {
                Toast.ShowSuccess($"Batch \"{request.Name}\" created successfully.");
                _showCreateForm = false;
                await LoadBatchesAsync();
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Failed to create batch.";
            }
        }
        finally
        {
            _isCreating = false;
            StateHasChanged();
        }
    }

    // ── Delete ────────────────────────────────────────────────────────────────

    private async Task ConfirmDeleteAsync(int batchId)
    {
        _isDeleting = true;
        StateHasChanged();

        try
        {
            var userId = await GetUserIdAsync();
            await BatchSvc.DeleteBatchAsync(batchId, userId);
            Toast.ShowSuccess("Batch deleted.");
            _confirmDeleteId = null;
            await LoadBatchesAsync();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage    = ex.Message;
            _confirmDeleteId = null;
        }
        finally
        {
            _isDeleting = false;
            StateHasChanged();
        }
    }

    // ── OCR trigger ───────────────────────────────────────────────────────────

    private async Task TriggerOcrAsync(int batchId)
    {
        await BatchSvc.TriggerOcrAsync(batchId);
        Toast.ShowSuccess("OCR processing queued for unprocessed invoices.");
    }

    // ── Export stubs ──────────────────────────────────────────────────────────

    private void ExportCsvStub(int batchId)   => Toast.ShowInfo("Export not yet implemented (CSV).");
    private void ExportExcelStub(int batchId) => Toast.ShowInfo("Export not yet implemented (Excel).");

    // ── Helpers ───────────────────────────────────────────────────────────────

    private async Task<string> GetUserIdAsync()
    {
        var authState = await AuthStateTask;
        return authState.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
    }
}
