@page "/"
@rendermode InteractiveServer
@inject IFileService FileService
@inject DatabaseService DatabaseSvc
@inject WorkspaceState State
@inject IConfigurationService ConfigService
@inject IInvoiceProcessingService ProcessingService
@inject IBatchService BatchSvc
@inject ToastService Toast
@implements IDisposable

<PageTitle>K-OCR</PageTitle>

<div class="file-list-panel">

    <!-- ── Toolbar ──────────────────────────────────────────── -->
    <div class="file-list-toolbar">
        @if (State.IsAuthenticated && State.CurrentBatch is not null)
        {
            <label class="btn btn-open @(_uploading ? "disabled" : "")"
                   title="Upload files to current batch"
                   style="cursor:@(_uploading ? "not-allowed" : "pointer")">
                @(_uploading ? "Uploading…" : "⬆ Upload")
                <InputFile OnChange="OnFilesSelectedAsync"
                           multiple
                           accept=".pdf,.png,.jpg,.jpeg,.bmp,.tif,.tiff"
                           disabled="@_uploading"
                           style="display:none" />
            </label>
        }
        @if (State.Files.Count > 0)
        {
            <button class="btn btn-refresh"
                    @onclick="RefreshBatchFilesAsync"
                    disabled="@(_loading || State.IsOcrRunning || _uploading)"
                    title="Refresh">
                🔄
            </button>
            <div class="file-list-toolbar-sep"></div>
            @if (State.SelectedFilePath is not null)
            {
                <button class="btn btn-ocr-now"
                        @onclick="OcrNowAsync"
                        disabled="@(State.IsOcrRunning || _uploading)"
                        title="Run OCR on the selected file (ignores cache)">
                    ⚡ OCR Now
                </button>
            }
            <button class="btn btn-batch-ocr"
                    @onclick="BatchOcrAsync"
                    disabled="@(State.IsOcrRunning || _uploading)"
                    title="Run OCR on all unprocessed files">
                @(State.IsOcrRunning ? "Running…" : "⚡ Batch OCR")
            </button>
        }
    </div>

    <!-- ── Status messages ──────────────────────────────────── -->
    @if (_errorMessage is not null)
    {
        <div class="file-list-error">⚠ @_errorMessage</div>
    }

    @if (State.CurrentBatch is not null)
    {
        <div class="file-list-directory" title="@State.CurrentBatch.FolderPath">
            Batch: @State.CurrentBatch.Name
        </div>
    }
    else if (State.IsAuthenticated)
    {
        <div class="file-list-directory">No batch selected.</div>
    }

    @if (State.IsOcrRunning && State.OcrProgress.Count > 0)
    {
        var lastMsg = State.OcrProgress.Values.Last();
        <div class="file-list-ocr-progress">
            <span class="loading-spinner"></span> @lastMsg
        </div>
    }

    @if (_uploading)
    {
        <div class="file-list-ocr-progress">
            <span class="loading-spinner"></span> Uploading files…
        </div>
    }

    @if (_loading)
    {
        <div class="file-list-loading">
            <span class="loading-spinner"></span> Loading…
        </div>
    }

    <!-- ── File list ─────────────────────────────────────────── -->
    @if (!_loading)
    {
        @if (State.Files.Count == 0 && State.CurrentBatch is null)
        {
            <div class="file-list-empty">Select a batch to see files</div>
        }
        else if (State.Files.Count == 0)
        {
            <div class="file-list-empty">No files in this batch — upload some files</div>
        }
        else
        {
            <div class="file-list-items">
                @foreach (var file in State.Files)
                {
                    var progress = State.OcrProgress.GetValueOrDefault(file.FilePath);
                    <div class="file-list-item @(file.FilePath == State.SelectedFilePath ? "selected" : "")"
                         @onclick="() => SelectFileAsync(file)"
                         @oncontextmenu="(e) => OpenContextMenu(e, file)"
                         @oncontextmenu:preventDefault="true"
                         title="@file.FilePath">
                        <span class="file-status-dots">
                            <span class="file-status-dot @file.ProcessedDotClass" title="@file.ProcessedDotTitle"></span>
                            @if (!string.IsNullOrEmpty(file.ValidationDotClass))
                            {
                                <span class="file-status-dot @file.ValidationDotClass" title="@file.ValidationDotTitle"></span>
                            }
                        </span>
                        <span class="file-name">@file.FileName</span>
                        @if (progress is not null)
                        {
                            <span class="file-ocr-badge" title="@progress">⚡</span>
                        }
                    </div>
                }
            </div>
        }
    }

</div>

@if (_ctxMenuVisible)
{
    <div class="ctx-menu-backdrop" @onclick="CloseContextMenu"></div>
    <div class="ctx-menu" style="left:@(_ctxMenuX)px;top:@(_ctxMenuY)px">
        <button class="ctx-menu-item"
                disabled="@State.IsOcrRunning"
                @onclick="ContextOcrNowAsync">
            ⚡ OCR Now
        </button>
        <div class="ctx-menu-separator"></div>
        <button class="ctx-menu-item"
                @onclick="CopyPathToClipboard">
            📋 Copy path
        </button>
    </div>
}

@if (_uploadErrorVisible && _uploadErrorMessage is not null)
{
    <div class="superadmin-overlay" @onclick="CloseUploadError">
        <div class="superadmin-dialog" style="max-width:480px" @onclick:stopPropagation="true">
            <div class="superadmin-header">
                <h1 class="superadmin-title">Upload Error</h1>
            </div>
            <div class="superadmin-content">
                <p>@_uploadErrorMessage</p>
                @if (_uploadConflicts.Count > 0)
                {
                    <ul style="max-height:200px;overflow-y:auto;padding-left:1.5rem;">
                        @foreach (var name in _uploadConflicts)
                        {
                            <li>@name</li>
                        }
                    </ul>
                }
                <div class="d-flex justify-content-end mt-3">
                    <button class="btn btn-primary" @onclick="CloseUploadError">OK</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool    _loading;
    private bool    _uploading;
    private string? _errorMessage;

    // Upload error dialog
    private bool               _uploadErrorVisible;
    private string?            _uploadErrorMessage;
    private IReadOnlyList<string> _uploadConflicts = [];

    // ── Context menu ──────────────────────────────────────────────────────
    private bool           _ctxMenuVisible;
    private double         _ctxMenuX;
    private double         _ctxMenuY;
    private FileListEntry? _ctxMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, FileListEntry file)
    {
        _ctxMenuTarget  = file;
        _ctxMenuX       = e.ClientX;
        _ctxMenuY       = e.ClientY;
        _ctxMenuVisible = true;
    }

    private void CloseContextMenu()
    {
        _ctxMenuVisible = false;
        _ctxMenuTarget  = null;
    }

    private async Task ContextOcrNowAsync()
    {
        var file = _ctxMenuTarget;
        CloseContextMenu();
        if (file is null || State.IsOcrRunning) return;
        await SelectFileAsync(file);
        await OcrNowAsync();
    }

    private void CopyPathToClipboard()
    {
        if (_ctxMenuTarget is not null)
            State.SelectFile(_ctxMenuTarget.FilePath);
        CloseContextMenu();
    }

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    public void Dispose() => State.OnChange -= OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // ── Upload ────────────────────────────────────────────────────────────

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        if (State.CurrentBatch is null || State.CurrentUserId is null) return;
        _errorMessage = null;
        _uploading    = true;
        StateHasChanged();
        try
        {
            const long maxFileSize = 50 * 1024 * 1024; // 50 MB per file
            var uploads = e.GetMultipleFiles(maximumFileCount: 500)
                .Select(f => new FileUpload(f.Name, f.OpenReadStream(maxFileSize)))
                .ToList();
            try
            {
                var result = await BatchSvc.UploadFilesToBatchAsync(
                    State.CurrentBatch.BatchId, uploads, State.CurrentUserId);

                if (result.Success)
                {
                    Toast.ShowSuccess($"{result.FilesUploaded} file{(result.FilesUploaded == 1 ? "" : "s")} uploaded.");
                    await RefreshBatchFilesAsync();
                }
                else if (result.ConflictingFileNames.Count > 0)
                {
                    _uploadErrorMessage = result.ErrorMessage ?? "One or more files already exist in this batch.";
                    _uploadConflicts    = result.ConflictingFileNames;
                    _uploadErrorVisible = true;
                }
                else
                {
                    _uploadErrorMessage = result.ErrorMessage ?? "Upload failed.";
                    _uploadConflicts    = [];
                    _uploadErrorVisible = true;
                }
            }
            finally
            {
                foreach (var u in uploads) u.Content.Dispose();
            }
        }
        catch (Exception ex)
        {
            _uploadErrorMessage = $"Upload failed: {ex.Message}";
            _uploadConflicts    = [];
            _uploadErrorVisible = true;
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private void CloseUploadError()
    {
        _uploadErrorVisible = false;
        _uploadErrorMessage = null;
        _uploadConflicts    = [];
    }

    // ── Refresh current batch file list ───────────────────────────────────

    private async Task RefreshBatchFilesAsync()
    {
        if (State.CurrentBatch is null) return;
        _loading = true;
        _errorMessage = null;
        StateHasChanged();
        try
        {
            var batch      = State.CurrentBatch;
            var invoicesPath = Path.Combine(batch.FolderPath, "Invoices");
            var entries    = new List<FileListEntry>();

            if (Directory.Exists(invoicesPath))
            {
                var extensions = new[] { ".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff", ".pdf" };
                var allFiles   = FileService.LoadFiles(invoicesPath, extensions).ToList();

                var pdfBaseNames = new HashSet<string>(
                    allFiles.Where(f => Path.GetExtension(f).Equals(".pdf", StringComparison.OrdinalIgnoreCase))
                            .Select(Path.GetFileNameWithoutExtension)
                            .Where(n => n is not null)
                            .Select(n => n!),
                    StringComparer.OrdinalIgnoreCase);

                foreach (var filePath in allFiles)
                {
                    var ext      = Path.GetExtension(filePath);
                    var baseName = Path.GetFileNameWithoutExtension(filePath);
                    if (ext.Equals(".png", StringComparison.OrdinalIgnoreCase)
                        && baseName is not null && pdfBaseNames.Contains(baseName))
                        continue;

                    var entry   = new FileListEntry { FilePath = filePath, FileName = Path.GetFileName(filePath) };
                    var invoice = await DatabaseSvc.GetInvoiceByFilePathAsync(filePath);
                    if (invoice is not null)
                    {
                        entry.IsProcessed = true;
                        if (!string.IsNullOrEmpty(invoice.ValidatedOcrText))
                        {
                            try
                            {
                                K_OCR.Models.InvoiceDto? dto = null;
                                try   { dto = Newtonsoft.Json.JsonConvert.DeserializeObject<K_OCR.Models.InvoiceDto>(invoice.ValidatedOcrText); }
                                catch { var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<K_OCR.Models.InvoiceDto>>(invoice.ValidatedOcrText); dto = list?.FirstOrDefault(); }
                                if (dto is not null)
                                {
                                    entry.IsSavedOrAccepted = dto.IsValidationAccepted;
                                    if (!entry.IsSavedOrAccepted && dto.TesseractConfirmed?.Count > 0)
                                    {
                                        entry.HasSuspectFields =
                                            dto.TesseractConfirmed.Values.Any(v => !v)
                                            || (dto.MathConfirmed?.Values.Any(v => !v) ?? false)
                                            || (dto.ConfidenceConfirmed?.Values.Any(v => !v) ?? false);
                                        entry.IsValidated = !entry.HasSuspectFields;
                                    }
                                }
                            }
                            catch { /* non-fatal */ }
                        }
                    }
                    entries.Add(entry);
                }
            }

            State.SetDirectory(invoicesPath, entries);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to refresh: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // ── File selection — loads cached invoice from DB ──────────────────────
    private async Task SelectFileAsync(FileListEntry file)
    {
        State.SelectFile(file.FilePath);

        // Load cached invoice in background so the viewer can show it immediately
        try
        {
            var invoice  = await ProcessingService.LoadCachedInvoiceAsync(file.FilePath);
            State.SetSelectedInvoice(invoice);
        }
        catch { /* non-fatal — invoice panel will show empty */ }
    }

    // ── OCR Now — reprocess the selected file, ignoring cache ─────────────
    private async Task OcrNowAsync()
    {
        var filePath = State.SelectedFilePath;
        if (filePath is null || State.IsOcrRunning) return;

        State.SetOcrRunning(true);
        State.SetOcrProgress(filePath, $"Running OCR on {Path.GetFileName(filePath)}…");
        try
        {
            var settings     = await ConfigService.LoadSettingsAsync();
            var artifactsDir = State.CurrentBatch is not null
                ? Path.Combine(State.CurrentBatch.FolderPath, "Artifacts")
                : settings.ProjectArtifacts;
            var result   = await ProcessingService.ProcessFileAsync(filePath, useCache: false, artifactsDir);

            if (result.IsSuccess)
            {
                var updated = BuildEntry(filePath, result.Context?.Layout);
                State.UpdateFileEntry(updated);
                var invoice = await ProcessingService.LoadCachedInvoiceAsync(filePath);
                State.SetSelectedInvoice(invoice);
                State.SetOcrProgress(filePath, "Done");
            }
            else
            {
                State.SetOcrProgress(filePath, $"Error: {result.Error?.Message}");
            }
        }
        catch (Exception ex)
        {
            State.SetOcrProgress(filePath, $"Error: {ex.Message}");
        }
        finally
        {
            State.SetOcrRunning(false);
        }
    }

    // ── Batch OCR — process all files, skipping those already cached ──────
    private async Task BatchOcrAsync()
    {
        if (State.IsOcrRunning || State.Files.Count == 0) return;

        State.SetOcrRunning(true, $"Batch OCR starting ({State.Files.Count} files)…");
        var settings     = await ConfigService.LoadSettingsAsync();
        var artifactsDir = State.CurrentBatch is not null
            ? Path.Combine(State.CurrentBatch.FolderPath, "Artifacts")
            : settings.ProjectArtifacts;
        var total    = State.Files.Count;
        var done     = 0;
        var errors   = 0;

        try
        {
            foreach (var file in State.Files.ToList())
            {
                State.SetOcrProgress(file.FilePath, $"Processing {file.FileName} ({done + 1}/{total})…");
                try
                {
                    var result = await ProcessingService.ProcessFileAsync(
                        file.FilePath, useCache: true, artifactsDir);

                    if (result.IsSuccess)
                    {
                        var updated = BuildEntry(file.FilePath, result.Context?.Layout);
                        State.UpdateFileEntry(updated);
                        State.SetOcrProgress(file.FilePath, "Done");
                    }
                    else
                    {
                        errors++;
                        State.SetOcrProgress(file.FilePath, $"Error: {result.Error?.Message}");
                    }
                }
                catch (Exception ex)
                {
                    errors++;
                    State.SetOcrProgress(file.FilePath, $"Error: {ex.Message}");
                }

                done++;
                State.SetStatus($"Batch OCR: {done}/{total} complete{(errors > 0 ? $", {errors} errors" : "")}");
            }
        }
        finally
        {
            State.SetOcrRunning(false, $"Batch done — {done - errors}/{total} succeeded{(errors > 0 ? $", {errors} failed" : "")}");
        }
    }

    // ── Shared helper: derive FileListEntry status from a pipeline layout ─
    private static FileListEntry BuildEntry(string filePath, object? layout)
    {
        var entry = new FileListEntry
        {
            FilePath    = filePath,
            FileName    = Path.GetFileName(filePath),
            IsProcessed = true
        };

        List<InvoiceDto>? invoices = null;
        if (layout is List<InvoiceDto> list)
            invoices = list;
        else if (layout is Newtonsoft.Json.Linq.JArray jArray)
        {
            try { invoices = jArray.ToObject<List<InvoiceDto>>(); } catch { }
        }

        var invoice = invoices?.FirstOrDefault();
        if (invoice?.TesseractConfirmed?.Count > 0)
        {
            entry.HasSuspectFields =
                invoice.TesseractConfirmed.Values.Any(v => !v)
                || (invoice.MathConfirmed?.Values.Any(v => !v) ?? false)
                || (invoice.ConfidenceConfirmed?.Values.Any(v => !v) ?? false);
            entry.IsValidated = !entry.HasSuspectFields;
        }
        if (invoice != null)
            entry.IsSavedOrAccepted = invoice.IsValidationAccepted;
        return entry;
    }
}
