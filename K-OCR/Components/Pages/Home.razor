@page "/"
@rendermode InteractiveServer
@inject IFileService FileService
@inject DatabaseService DatabaseSvc
@inject WorkspaceState State
@inject IConfigurationService ConfigService
@inject IInvoiceProcessingService ProcessingService

<PageTitle>K-OCR</PageTitle>

<FolderPickerDialog @ref="_folderPicker" />

<div class="file-list-panel">

    <!-- ── Toolbar ──────────────────────────────────────────── -->
    <div class="file-list-toolbar">
        <input type="text"
               class="folder-input"
               placeholder="/path/to/invoices"
               @bind="_folderPath"
               @bind:event="oninput"
               @onkeydown="OnFolderKeyDown"
               disabled="@_loading"
               title="Folder path" />
        <button class="btn btn-open"
                @onclick="OpenFolderPickerAsync"
                disabled="@_loading"
                title="Open folder">
            📂
        </button>
        @if (State.Files.Count > 0)
        {
            <button class="btn btn-refresh"
                    @onclick="LoadDirectoryAsync"
                    disabled="@(_loading || State.IsOcrRunning)"
                    title="Refresh">
                🔄
            </button>
            <div class="file-list-toolbar-sep"></div>
            @if (State.SelectedFilePath is not null)
            {
                <button class="btn btn-ocr-now"
                        @onclick="OcrNowAsync"
                        disabled="@State.IsOcrRunning"
                        title="Run OCR on the selected file (ignores cache)">
                    ⚡ OCR Now
                </button>
            }
            <button class="btn btn-batch-ocr"
                    @onclick="BatchOcrAsync"
                    disabled="@State.IsOcrRunning"
                    title="Run OCR on all unprocessed files">
                @(State.IsOcrRunning ? "Running…" : "⚡ Batch OCR")
            </button>
        }
    </div>

    <!-- ── Status messages ──────────────────────────────────── -->
    @if (_errorMessage is not null)
    {
        <div class="file-list-error">⚠ @_errorMessage</div>
    }

    @if (State.CurrentDirectory is not null)
    {
        <div class="file-list-directory" title="@State.CurrentDirectory">
            @TruncatePath(State.CurrentDirectory)
        </div>
    }

    @if (State.IsOcrRunning && State.OcrProgress.Count > 0)
    {
        var lastMsg = State.OcrProgress.Values.Last();
        <div class="file-list-ocr-progress">
            <span class="loading-spinner"></span> @lastMsg
        </div>
    }

    @if (_loading)
    {
        <div class="file-list-loading">
            <span class="loading-spinner"></span> Loading…
        </div>
    }

    <!-- ── File list ─────────────────────────────────────────── -->
    @if (!_loading)
    {
        @if (State.Files.Count == 0 && State.CurrentDirectory is null)
        {
            <div class="file-list-empty">Open a folder to see files</div>
        }
        else if (State.Files.Count == 0)
        {
            <div class="file-list-empty">No supported files in this folder</div>
        }
        else
        {
            <div class="file-list-items">
                @foreach (var file in State.Files)
                {
                    var progress = State.OcrProgress.GetValueOrDefault(file.FilePath);
                    <div class="file-list-item @(file.FilePath == State.SelectedFilePath ? "selected" : "")"
                         @onclick="() => SelectFileAsync(file)"
                         @oncontextmenu="(e) => OpenContextMenu(e, file)"
                         @oncontextmenu:preventDefault="true"
                         title="@file.FilePath">
                        <span class="file-status-dots">
                            <span class="file-status-dot @file.ProcessedDotClass" title="@file.ProcessedDotTitle"></span>
                            @if (!string.IsNullOrEmpty(file.ValidationDotClass))
                            {
                                <span class="file-status-dot @file.ValidationDotClass" title="@file.ValidationDotTitle"></span>
                            }
                        </span>
                        <span class="file-name">@file.FileName</span>
                        @if (progress is not null)
                        {
                            <span class="file-ocr-badge" title="@progress">⚡</span>
                        }
                    </div>
                }
            </div>
        }
    }

</div>

@if (_ctxMenuVisible)
{
    <div class="ctx-menu-backdrop" @onclick="CloseContextMenu"></div>
    <div class="ctx-menu" style="left:@(_ctxMenuX)px;top:@(_ctxMenuY)px">
        <button class="ctx-menu-item"
                disabled="@State.IsOcrRunning"
                @onclick="ContextOcrNowAsync">
            ⚡ OCR Now
        </button>
        <div class="ctx-menu-separator"></div>
        <button class="ctx-menu-item"
                @onclick="CopyPathToClipboard">
            📋 Copy path
        </button>
    </div>
}

@code {
    private string  _folderPath   = string.Empty;
    private bool    _loading;
    private string? _errorMessage;
    private FolderPickerDialog? _folderPicker;

    // ── Context menu ──────────────────────────────────────────────────────
    private bool           _ctxMenuVisible;
    private double         _ctxMenuX;
    private double         _ctxMenuY;
    private FileListEntry? _ctxMenuTarget;

    private void OpenContextMenu(MouseEventArgs e, FileListEntry file)
    {
        _ctxMenuTarget  = file;
        _ctxMenuX       = e.ClientX;
        _ctxMenuY       = e.ClientY;
        _ctxMenuVisible = true;
    }

    private void CloseContextMenu()
    {
        _ctxMenuVisible = false;
        _ctxMenuTarget  = null;
    }

    private async Task ContextOcrNowAsync()
    {
        var file = _ctxMenuTarget;
        CloseContextMenu();
        if (file is null || State.IsOcrRunning) return;
        await SelectFileAsync(file);
        await OcrNowAsync();
    }

    private void CopyPathToClipboard()
    {
        if (_ctxMenuTarget is not null)
            State.SelectFile(_ctxMenuTarget.FilePath);
        CloseContextMenu();
    }

    private async Task OpenFolderPickerAsync()
    {
        if (_folderPicker is null) return;
        var settings  = await ConfigService.LoadSettingsAsync();
        // Root at the configured base directory; fall back to ProjectDirectory if base isn't set.
        var rootPath  = !string.IsNullOrWhiteSpace(settings.DefaultStartFolder) ? settings.DefaultStartFolder
                      : !string.IsNullOrWhiteSpace(settings.ProjectDirectory)   ? settings.ProjectDirectory
                      : null;
        var startPath = !string.IsNullOrWhiteSpace(_folderPath) ? _folderPath
                      : rootPath;
        var chosen = await _folderPicker.ShowAsync(startPath, rootPath);
        if (chosen is not null)
        {
            _folderPath = chosen;
            await LoadDirectoryAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Auto-load the project directory from settings if set
        var settings = await ConfigService.LoadSettingsAsync();
        if (!string.IsNullOrEmpty(settings.ProjectDirectory))
        {
            _folderPath = settings.ProjectDirectory;
            await LoadDirectoryAsync();
        }
    }

    private async Task OnFolderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadDirectoryAsync();
    }

    // ── File selection — loads cached invoice from DB ──────────────────────
    private async Task SelectFileAsync(FileListEntry file)
    {
        State.SelectFile(file.FilePath);

        // Load cached invoice in background so the viewer can show it immediately
        try
        {
            var settings = await ConfigService.LoadSettingsAsync();
            var invoice  = await ProcessingService.LoadCachedInvoiceAsync(file.FilePath, settings.ProjectArtifacts);
            State.SetSelectedInvoice(invoice);
        }
        catch { /* non-fatal — invoice panel will show empty */ }
    }

    // ── OCR Now — reprocess the selected file, ignoring cache ─────────────
    private async Task OcrNowAsync()
    {
        var filePath = State.SelectedFilePath;
        if (filePath is null || State.IsOcrRunning) return;

        State.SetOcrRunning(true);
        State.SetOcrProgress(filePath, $"Running OCR on {Path.GetFileName(filePath)}…");
        try
        {
            var settings = await ConfigService.LoadSettingsAsync();
            var result   = await ProcessingService.ProcessFileAsync(filePath, useCache: false, settings.ProjectArtifacts);

            if (result.IsSuccess)
            {
                var updated = BuildEntry(filePath, result.Context?.Layout);
                State.UpdateFileEntry(updated);
                var invoice = await ProcessingService.LoadCachedInvoiceAsync(filePath, settings.ProjectArtifacts);
                State.SetSelectedInvoice(invoice);
                State.SetOcrProgress(filePath, "Done");
            }
            else
            {
                State.SetOcrProgress(filePath, $"Error: {result.Error?.Message}");
            }
        }
        catch (Exception ex)
        {
            State.SetOcrProgress(filePath, $"Error: {ex.Message}");
        }
        finally
        {
            State.SetOcrRunning(false);
        }
    }

    // ── Batch OCR — process all files, skipping those already cached ──────
    private async Task BatchOcrAsync()
    {
        if (State.IsOcrRunning || State.Files.Count == 0) return;

        State.SetOcrRunning(true, $"Batch OCR starting ({State.Files.Count} files)…");
        var settings = await ConfigService.LoadSettingsAsync();
        var total    = State.Files.Count;
        var done     = 0;
        var errors   = 0;

        try
        {
            foreach (var file in State.Files.ToList())
            {
                State.SetOcrProgress(file.FilePath, $"Processing {file.FileName} ({done + 1}/{total})…");
                try
                {
                    var result = await ProcessingService.ProcessFileAsync(
                        file.FilePath, useCache: true, settings.ProjectArtifacts);

                    if (result.IsSuccess)
                    {
                        var updated = BuildEntry(file.FilePath, result.Context?.Layout);
                        State.UpdateFileEntry(updated);
                        State.SetOcrProgress(file.FilePath, "Done");
                    }
                    else
                    {
                        errors++;
                        State.SetOcrProgress(file.FilePath, $"Error: {result.Error?.Message}");
                    }
                }
                catch (Exception ex)
                {
                    errors++;
                    State.SetOcrProgress(file.FilePath, $"Error: {ex.Message}");
                }

                done++;
                State.SetStatus($"Batch OCR: {done}/{total} complete{(errors > 0 ? $", {errors} errors" : "")}");
            }
        }
        finally
        {
            State.SetOcrRunning(false, $"Batch done — {done - errors}/{total} succeeded{(errors > 0 ? $", {errors} failed" : "")}");
        }
    }

    // ── Shared helper: derive FileListEntry status from a pipeline layout ─
    private static FileListEntry BuildEntry(string filePath, object? layout)
    {
        var entry = new FileListEntry
        {
            FilePath    = filePath,
            FileName    = Path.GetFileName(filePath),
            IsProcessed = true
        };

        List<InvoiceDto>? invoices = null;
        if (layout is List<InvoiceDto> list)
            invoices = list;
        else if (layout is Newtonsoft.Json.Linq.JArray jArray)
        {
            try { invoices = jArray.ToObject<List<InvoiceDto>>(); } catch { }
        }

        var invoice = invoices?.FirstOrDefault();
        if (invoice?.TesseractConfirmed?.Count > 0)
        {
            entry.HasSuspectFields =
                invoice.TesseractConfirmed.Values.Any(v => !v)
                || (invoice.MathConfirmed?.Values.Any(v => !v) ?? false)
                || (invoice.ConfidenceConfirmed?.Values.Any(v => !v) ?? false);
            entry.IsValidated = !entry.HasSuspectFields;
        }
        if (invoice != null)
            entry.IsSavedOrAccepted = invoice.IsValidationAccepted;
        return entry;
    }

    private async Task LoadDirectoryAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_folderPath))
        {
            _errorMessage = "Enter a folder path.";
            return;
        }

        if (!Directory.Exists(_folderPath))
        {
            _errorMessage = $"Directory not found: {_folderPath}";
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            var extensions = new[] { ".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff", ".pdf" };
            var allFiles   = FileService.LoadFiles(_folderPath, extensions).ToList();

            // Suppress PDF-derived PNG files (e.g. invoice.pdf → invoice.png)
            var pdfBaseNames = new HashSet<string>(
                allFiles.Where(f => Path.GetExtension(f).Equals(".pdf", StringComparison.OrdinalIgnoreCase))
                        .Select(Path.GetFileNameWithoutExtension)
                        .Where(n => n is not null)
                        .Select(n => n!),
                StringComparer.OrdinalIgnoreCase);

            var entries = new List<FileListEntry>();

            foreach (var filePath in allFiles)
            {
                var ext      = Path.GetExtension(filePath);
                var baseName = Path.GetFileNameWithoutExtension(filePath);

                if (ext.Equals(".png", StringComparison.OrdinalIgnoreCase)
                    && baseName is not null && pdfBaseNames.Contains(baseName))
                    continue;

                var entry = new FileListEntry
                {
                    FilePath = filePath,
                    FileName = Path.GetFileName(filePath)
                };

                // Check DB for OCR / validation status
                var ocrFile = await DatabaseSvc.GetOCRFileByPathAsync(filePath);
                if (ocrFile is not null)
                {
                    entry.IsProcessed = true;

                    if (!string.IsNullOrEmpty(ocrFile.ValidatedOcrText))
                    {
                        try
                        {
                            K_OCR.Models.InvoiceDto? invoice = null;
                            try
                            {
                                invoice = Newtonsoft.Json.JsonConvert.DeserializeObject<K_OCR.Models.InvoiceDto>(
                                    ocrFile.ValidatedOcrText);
                            }
                            catch
                            {
                                var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<K_OCR.Models.InvoiceDto>>(
                                    ocrFile.ValidatedOcrText);
                                invoice = list?.FirstOrDefault();
                            }

                            if (invoice != null)
                                entry.IsSavedOrAccepted = invoice.IsValidationAccepted;

                            if (!entry.IsSavedOrAccepted && invoice?.TesseractConfirmed?.Count > 0)
                            {
                                entry.HasSuspectFields =
                                    invoice.TesseractConfirmed.Values.Any(v => !v)
                                    || (invoice.MathConfirmed?.Values.Any(v => !v) ?? false)
                                    || (invoice.ConfidenceConfirmed?.Values.Any(v => !v) ?? false);
                                entry.IsValidated = !entry.HasSuspectFields;
                            }
                        }
                        catch { /* ignore parse errors */ }
                    }
                }

                entries.Add(entry);
            }

            State.SetDirectory(_folderPath, entries);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load folder: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string TruncatePath(string path, int maxLen = 36)
    {
        if (path.Length <= maxLen) return path;
        var parts = path.Split(Path.DirectorySeparatorChar, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length <= 2) return "…" + path[^maxLen..];
        return $"…{Path.DirectorySeparatorChar}{parts[^2]}{Path.DirectorySeparatorChar}{parts[^1]}";
    }
}
