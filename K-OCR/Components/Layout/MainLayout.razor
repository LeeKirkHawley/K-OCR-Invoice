@inherits LayoutComponentBase
@using System.Security.Claims
@using K_OCR.Security
@inject IJSRuntime JS
@inject WorkspaceState State
@inject IInvoiceProcessingService ProcessingService

@inject ToastService Toast
@inject SettingsDialogService SettingsSvc
@inject AuthDialogService AuthSvc
@inject SuperAdminDialogService SuperAdminDialogSvc
@inject OrgUserManagementDialogService OrgUserMgmtDialogSvc
@inject BatchDialogService BatchDialogSvc
@inject NavigationManager Navigation
@inject IBatchService BatchSvc
@inject DatabaseService DatabaseSvc
@inject IFileService FileService
@implements IAsyncDisposable

<PageTitle>@(State.SelectedFile?.FileName is { } fn ? $"{fn} — K-OCR" : "K-OCR")</PageTitle>

<div class="kocr-top-bar">
    <div class="kocr-top-left">
        <span class="kocr-title">K-OCR</span>
        <span class="kocr-status">@State.StatusMessage</span>
        @if (State.IsAuthenticated && State.TenantId is not null)
        {
            <div class="batch-selector @(_batchDropdownOpen ? "open" : "")">
                <button class="batch-selector-btn" @onclick="ToggleBatchDropdownAsync">
                    <span class="batch-selector-label">@(State.CurrentBatch?.Name ?? "Select a batch…")</span>
                    <span class="batch-selector-caret">▾</span>
                </button>
                @if (_batchDropdownOpen)
                {
                    <div class="batch-selector-backdrop" @onclick="CloseBatchDropdown"></div>
                    <div class="batch-selector-dropdown">
                        @if (_orgBatches.Length == 0)
                        {
                            <div class="batch-selector-empty">No batches found.</div>
                        }
                        else
                        {
                            @foreach (var b in _orgBatches)
                            {
                                var batchItem = b;
                                <button class="batch-selector-item @(State.CurrentBatch?.BatchId == batchItem.BatchId ? "active" : "")"
                                        @onclick="() => SelectBatchAsync(batchItem)">
                                    @batchItem.Name
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
    <div class="kocr-top-right">
        @if (State.IsAuthenticated)
        {
            <span class="kocr-user-email">@State.CurrentUserEmail</span>
            <span class="kocr-user-tenant">Tenant: @(State.TenantName ?? "Global")</span>
            <button class="btn btn-sm btn-outline-light ms-2" @onclick="Logout">Sign out</button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-light" @onclick="() => AuthSvc.RequestOpen()">Sign in</button>
        }
    </div>
    <nav class="navbar navbar-expand-lg kocr-menu-bar">
        <div class="container-fluid px-0">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#kocrMenu" aria-controls="kocrMenu"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="kocrMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <!-- File menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="javascript:void(0)" id="fileMenu"
                        role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            File
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="fileMenu">
                            <li>
                                <a class="dropdown-item" href="#" @onclick="Exit">
                                    Exit
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Export menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="javascript:void(0)" id="exportMenu"
                        role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Export
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="exportMenu">
                            <li>
                                <a class="dropdown-item" href="#" @onclick="ExportDocx">
                                    Docx
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Tools menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="javascript:void(0)" id="toolsMenu"
                        role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Tools
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="toolsMenu">
                            @if (State.IsSuperAdmin)
                            {
                                <li>
                                    <button class="dropdown-item" @onclick="() => SuperAdminDialogSvc.RequestOpen()">
                                        Super Admin Console
                                    </button>
                                </li>
                            }

                            @if (State.IsOrganizationAdmin)
                            {
                                <li>
                                    <button class="dropdown-item" @onclick="() => BatchDialogSvc.RequestOpen()">
                                        Manage Batches
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="() => OrgUserMgmtDialogSvc.RequestOpen()">
                                        Manage Users
                                    </button>
                                </li>
                            }

                            <li>
                                <button class="dropdown-item" @onclick="() => AuthSvc.RequestOpen()">
                                    Authentication Setup
                                </button>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <button class="dropdown-item" @onclick="OpenSettingsAsync">
                                    Settings
                                </button>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" href="#" @onclick="ClearAllData">
                                    Clear All Data…
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Help menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="javascript:void(0)" id="helpMenu"
                        role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Help
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="helpMenu">
                            <li>
                                <a class="dropdown-item" href="#" @onclick="ShowAbout">
                                    About
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</div>

<div class="kocr-shell" @ref="_shellRef">
    <!-- Left pane — @Body renders here (file list) -->
    <div class="kocr-pane kocr-pane-left">
        @Body
    </div>

    <!-- Left splitter -->
    <div class="splitter splitter-left" title="Drag to resize"></div>

    <!-- Center pane — document image viewer -->
    <div class="kocr-pane kocr-pane-center">
        @if (State.SelectedFile is { } selected)
        {
            <div class="kocr-file-preview-header">
                <button class="file-nav-btn"
                        @onclick="() => NavigateFileAsync(-1)"
                        disabled="@(!State.CanNavigatePrev)"
                        aria-label="Previous file"
                        title="Previous file (Alt+←)">◀</button>
                <span class="file-status-dots">
                    <span class="file-status-dot @selected.ProcessedDotClass" title="@selected.ProcessedDotTitle"></span>
                    @if (!string.IsNullOrEmpty(selected.ValidationDotClass))
                    {
                        <span class="file-status-dot @selected.ValidationDotClass" title="@selected.ValidationDotTitle"></span>
                    }
                </span>
                <span class="kocr-file-preview-name" title="@selected.FilePath">@selected.FileName</span>
                <button class="file-nav-btn"
                        @onclick="() => NavigateFileAsync(+1)"
                        disabled="@(!State.CanNavigateNext)"
                        aria-label="Next file"
                        title="Next file (Alt+→)">▶</button>
            </div>
        }
        <DocumentViewer />
    </div>

    <!-- Right splitter -->
    <div class="splitter splitter-right" title="Drag to resize"></div>

    <!-- Right pane — validation / data panel -->
    <div class="kocr-pane kocr-pane-right">
        <InvoicePanel @ref="_invoicePanel" />
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<Settings />
<Auth />
<SuperAdmin />
<EmailConfig />
<OrgUserManagement />
<ManageBatches />
<ToastContainer />

@if (_showUnsavedConfirm)
{
    <div class="superadmin-overlay" @onclick="CancelBatchSwitch">
        <div class="superadmin-dialog" style="max-width:420px" @onclick:stopPropagation="true">
            <div class="superadmin-header">
                <h1 class="superadmin-title">Unsaved Changes</h1>
            </div>
            <div class="superadmin-content">
                <p>You have unsaved changes in the current invoice. Save before switching batches?</p>
                <div class="d-flex gap-2 justify-content-end mt-3">
                    <button class="btn btn-secondary" @onclick="CancelBatchSwitch">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmBatchSwitchAsync">Save &amp; Switch</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ElementReference _shellRef;
    private DotNetObjectReference<MainLayout>? _selfRef;
    private InvoicePanel? _invoicePanel;

    // Batch selector state
    private BatchSummary[] _orgBatches = [];
    private bool _batchDropdownOpen;
    private BatchSummary? _pendingBatch;
    private bool _showUnsavedConfirm;
    private bool _shouldOpenBatchDialog;

    private void OpenSettingsAsync() => SettingsSvc.RequestOpen();

    // ── Batch initialisation (5a) ─────────────────────────────────────────

    private async Task InitializeBatchAsync()
    {
        if (State.TenantId is null || State.CurrentUserId is null) return;

        _orgBatches = await BatchSvc.GetBatchesForOrgAsync(State.TenantId);

        var lastBatchId = await BatchSvc.GetUserLastBatchIdAsync(State.CurrentUserId, State.TenantId);
        if (lastBatchId is not null)
        {
            var summary = _orgBatches.FirstOrDefault(b => b.BatchId == lastBatchId);
            if (summary is not null)
            {
                await LoadBatchFilesAsync(summary, persistSession: false);
                return;
            }
        }

        if (State.IsOrganizationAdmin)
            _shouldOpenBatchDialog = true;
        else
            State.SetStatus("No batch selected. Contact your organization administrator.");
    }

    private async Task LoadBatchFilesAsync(BatchSummary batch, bool persistSession = true)
    {
        var invoicesPath = Path.Combine(batch.FolderPath, "Invoices");

        var entries = new List<FileListEntry>();
        if (Directory.Exists(invoicesPath))
        {
            var extensions = new[] { ".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff", ".pdf" };
            var allFiles   = FileService.LoadFiles(invoicesPath, extensions).ToList();

            var pdfBaseNames = new HashSet<string>(
                allFiles.Where(f => Path.GetExtension(f).Equals(".pdf", StringComparison.OrdinalIgnoreCase))
                        .Select(Path.GetFileNameWithoutExtension)
                        .Where(n => n is not null)
                        .Select(n => n!),
                StringComparer.OrdinalIgnoreCase);

            foreach (var filePath in allFiles)
            {
                var ext      = Path.GetExtension(filePath);
                var baseName = Path.GetFileNameWithoutExtension(filePath);
                if (ext.Equals(".png", StringComparison.OrdinalIgnoreCase)
                    && baseName is not null && pdfBaseNames.Contains(baseName))
                    continue;

                var entry = new FileListEntry { FilePath = filePath, FileName = Path.GetFileName(filePath) };
                var ocrFile = await DatabaseSvc.GetInvoiceByFilePathAsync(filePath);
                if (ocrFile is not null)
                {
                    entry.IsProcessed = true;
                    if (!string.IsNullOrEmpty(ocrFile.ValidatedOcrText))
                    {
                        try
                        {
                            K_OCR.Models.InvoiceDto? invoice = null;
                            try
                            {
                                invoice = Newtonsoft.Json.JsonConvert.DeserializeObject<K_OCR.Models.InvoiceDto>(ocrFile.ValidatedOcrText);
                            }
                            catch
                            {
                                var list = Newtonsoft.Json.JsonConvert.DeserializeObject<List<K_OCR.Models.InvoiceDto>>(ocrFile.ValidatedOcrText);
                                invoice = list?.FirstOrDefault();
                            }
                            if (invoice is not null)
                            {
                                entry.IsSavedOrAccepted = invoice.IsValidationAccepted;
                                if (!entry.IsSavedOrAccepted && invoice.TesseractConfirmed?.Count > 0)
                                {
                                    entry.HasSuspectFields =
                                        invoice.TesseractConfirmed.Values.Any(v => !v)
                                        || (invoice.MathConfirmed?.Values.Any(v => !v) ?? false)
                                        || (invoice.ConfidenceConfirmed?.Values.Any(v => !v) ?? false);
                                    entry.IsValidated = !entry.HasSuspectFields;
                                }
                            }
                        }
                        catch { /* non-fatal */ }
                    }
                }
                entries.Add(entry);
            }
        }

        State.SetCurrentBatch(batch);
        State.SetDirectory(invoicesPath, entries);
        if (persistSession && State.CurrentUserId is not null && State.TenantId is not null)
            await BatchSvc.SetUserLastBatchAsync(State.CurrentUserId, State.TenantId, batch.BatchId);
    }

    // ── Batch selector (5b) ───────────────────────────────────────────────

    private async Task ToggleBatchDropdownAsync()
    {
        if (!_batchDropdownOpen && State.TenantId is not null)
            _orgBatches = await BatchSvc.GetBatchesForOrgAsync(State.TenantId);
        _batchDropdownOpen = !_batchDropdownOpen;
    }

    private void CloseBatchDropdown() => _batchDropdownOpen = false;

    private async Task SelectBatchAsync(BatchSummary batch)
    {
        CloseBatchDropdown();
        if (State.CurrentBatch?.BatchId == batch.BatchId) return;

        if (State.HasUnsavedEdits)
        {
            _pendingBatch = batch;
            _showUnsavedConfirm = true;
            return;
        }

        await LoadBatchFilesAsync(batch);
        State.SelectFile(null);
    }

    private async Task ConfirmBatchSwitchAsync()
    {
        _showUnsavedConfirm = false;
        var batch = _pendingBatch;
        _pendingBatch = null;
        if (batch is null) return;

        if (_invoicePanel is not null)
            await _invoicePanel.TriggerSaveAsync();

        await LoadBatchFilesAsync(batch);
        State.SelectFile(null);
    }

    private void CancelBatchSwitch()
    {
        _showUnsavedConfirm = false;
        _pendingBatch = null;
    }

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;

        // Re-hydrate WorkspaceState from the auth cookie on every new circuit.
        // This is what makes authentication survive a browser refresh: the cookie
        // is validated by RevalidatingAuthenticationStateProvider and the claims
        // (including custom OrganizationId / TenantName added by
        // ApplicationUserClaimsPrincipalFactory) are used to restore session state.
        var authState = await AuthStateTask;
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var principal  = authState.User;
            var userId     = principal.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            var email      = principal.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
            var tenantId   = principal.FindFirstValue(AppClaimTypes.OrganizationId);
            var tenantName = principal.FindFirstValue(AppClaimTypes.TenantName);
            var roles      = principal.FindAll(ClaimTypes.Role).Select(c => c.Value).ToArray();
            State.SetAuthentication(userId, tenantId, tenantName, email, roles);
            await InitializeBatchAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("kocrLayout.initSplitters", _selfRef);
            await JS.InvokeVoidAsync("kocrKeyboard.init", _selfRef);
            if (!State.IsAuthenticated)
                AuthSvc.RequestOpen();
            else if (_shouldOpenBatchDialog)
            {
                _shouldOpenBatchDialog = false;
                BatchDialogSvc.RequestOpen();
            }
        }
    }

    private void OnStateChanged() =>
        InvokeAsync(StateHasChanged);

    [JSInvokable]
    public void OnPaneWidthsChanged(double left, double right)
    {
        // Pane widths are persisted by JS in localStorage; nothing to do server-side yet.
    }

    /// <summary>
    /// Dispatches a keyboard shortcut action from the global JS keydown handler.
    /// Called by <c>window.kocrKeyboard.init</c> in kocr.js.
    /// </summary>
    [JSInvokable]
    public Task OnKeyboardShortcut(string shortcut) => shortcut switch
    {
        "save"       => _invoicePanel?.TriggerSaveAsync()        ?? Task.CompletedTask,
        "export"     => _invoicePanel?.TriggerExportAsync()      ?? Task.CompletedTask,
        "escape"     => _invoicePanel?.TriggerEscapeAsync()      ?? InvokeAsync(() => State.SetSelectedField(null)),
        "next-field" => _invoicePanel?.CycleSuspectFieldAsync(+1) ?? Task.CompletedTask,
        "prev-field" => _invoicePanel?.CycleSuspectFieldAsync(-1) ?? Task.CompletedTask,
        "prev-file"  => NavigateFileAsync(-1),
        "next-file"  => NavigateFileAsync(+1),
        _ when shortcut.StartsWith("field-focused:") =>
            _invoicePanel?.OnNavRowFocusedAsync(shortcut["field-focused:".Length..]) ?? Task.CompletedTask,
        _            => Task.CompletedTask
    };

    /// <summary>
    /// Moves file selection by <paramref name="delta"/> (+1 or -1), then loads the
    /// cached invoice from the database so the viewer and panel update immediately.
    /// </summary>
    private async Task NavigateFileAsync(int delta)
    {
        var file = State.NavigateFile(delta);
        if (file is null) return;
        try
        {
            var invoice  = await ProcessingService.LoadCachedInvoiceAsync(file.FilePath);
            State.SetSelectedInvoice(invoice);
        }
        catch (Exception ex) { Toast.ShowError($"Could not load file data: {ex.Message}"); }
    }

    // --- Menu handler stubs ---
    private async Task ExportDocx()
    {
        // TODO: Implement export to Docx logic
        await Task.CompletedTask;
    }

    private async Task Copy()
    {
        // TODO: Implement copy logic
        await Task.CompletedTask;
    }

    private async Task Paste()
    {
        // TODO: Implement paste logic
        await Task.CompletedTask;
    }

    private void Exit()
    {
        // TODO: Implement exit logic (clear state or redirect)
    }

    private void Logout()
    {
        State.ClearAuthentication();
        Navigation.NavigateTo("/account/logout", forceLoad: true);
    }

    private async Task ClearAllData()
    {
        // TODO: Implement clear all data logic
        await Task.CompletedTask;
    }

    private async Task ShowAbout()
    {
        // TODO: Implement about dialog logic
        await Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        State.OnChange -= OnStateChanged;
        _selfRef?.Dispose();
        await ValueTask.CompletedTask;
    }
}
