@inject StartupErrorState StartupErr

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["K-OCR.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @if (StartupErr.HasError)
    {
        <div class="d-flex align-items-center justify-content-center vh-100">
            <div class="text-center p-4 border rounded bg-danger-subtle">
                <h1 class="text-danger">Configuration Error</h1>
                <p class="mt-3">@StartupErr.ErrorMessage</p>
                <p class="text-muted">Edit appsettings.json and restart the application.</p>
            </div>
        </div>
    }
    else
    {
        <Routes @rendermode="InteractiveServer" />
    }
    <ReconnectModal />
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="kocr.js"></script>
</body>

</html>
