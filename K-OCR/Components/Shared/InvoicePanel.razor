@inject WorkspaceState State
@inject IInvoiceProcessingService ProcessingService
@inject IConfigurationService ConfigService
@inject IDocumentExportService ExportService
@inject IJSRuntime JS
@inject DatabaseService DatabaseSvc
@inject ToastService Toast
@implements IDisposable

<div class="invoice-panel">
    @if (_invoice is { } inv)
    {
        @* ── Tab bar ─────────────────────────────────────────────── *@
        <div class="inv-tabs">
            <button class="inv-tab-btn @(_activeTab == "validation" ? "active" : "")"
                    @onclick='() => SwitchTabAsync("validation")'>Validation</button>
            <button class="inv-tab-btn @(_activeTab == "raw" ? "active" : "")"
                    @onclick='() => SwitchTabAsync("raw")'>Raw JSON</button>
            <button class="inv-tab-btn @(_activeTab == "validated" ? "active" : "")"
                    @onclick='() => SwitchTabAsync("validated")'>Validated JSON</button>
        </div>

        @if (_activeTab == "raw")
        {
            @* ── Raw JSON tab ─────────────────────────────── *@
            @if (_rawJsonLoading)
            {
                <div class="inv-empty"><span class="loading-spinner"></span> Loading…</div>
            }
            else if (_rawJson is null)
            {
                <div class="inv-empty">(no data)</div>
            }
            else
            {
                <pre class="raw-json-pre">@_rawJson</pre>
            }
        }
        else if (_activeTab == "validated")
        {
            @* ── Validated JSON tab ───────────────────────── *@
            @if (_validatedJsonLoading)
            {
                <div class="inv-empty"><span class="loading-spinner"></span> Loading…</div>
            }
            else if (_validatedJson is null)
            {
                <div class="inv-empty">Not yet validated — save fields to populate.</div>
            }
            else
            {
                <pre class="raw-json-pre">@_validatedJson</pre>
            }
        }
        else
        {

        @* ── Status banner ──────────────────────────────────────────── *@
        @if (inv.IsValidationAccepted)
        {
            <div class="inv-status-banner inv-banner-accepted">
                <span class="inv-banner-icon">✓</span> Validation accepted
            </div>
        }
        else if (inv.IsEditedByUser)
        {
            <div class="inv-status-banner inv-banner-edited">
                <span class="inv-banner-icon">✓</span> Edited by user
            </div>
        }
        else if (_suspectCount > 0)
        {
            <div class="inv-status-banner inv-banner-suspect">
                <span class="inv-banner-icon">⚠</span>
                @_suspectCount suspect field@(_suspectCount == 1 ? "" : "s")
            </div>
        }

        @* ── Action toolbar ─────────────────────────────────────────── *@
        <div class="inv-actions">
            <button class="btn inv-btn-save" @onclick="SaveAsync" disabled="@_saving">
                @(_saving ? "Saving…" : "💾 Save")
            </button>
            @if (!inv.IsValidationAccepted)
            {
                <button class="btn inv-btn-accept" @onclick="AcceptValidationAsync" disabled="@_saving">
                    ✓ Validation Accepted
                </button>
            }
            <button class="btn inv-btn-export" @onclick="ExportDocxAsync" disabled="@_exporting"
                    title="Download invoice as Word document">
                @(_exporting ? "Exporting…" : "⬇ DOCX")
            </button>
        </div>

        @* ── Header fields ──────────────────────────────────────────── *@
        <div class="inv-fields-section">
            @foreach (var (key, label) in _headerFields)
            {
                var k       = key;
                var suspect = IsFieldSuspect(k);
                var isOk    = IsFieldChecked(k);
                var tip     = GetFieldTooltip(k);
                var isSel   = State.SelectedFieldName == k;
                <div class="inv-field-row @(suspect ? "inv-suspect" : isOk ? "inv-ok" : "") @(isSel ? "inv-field-selected" : "")"
                     tabindex="0"
                     role="button"
                     data-nav-row="@k"
                     @onclick="() => SelectField(k)"
                     title="@tip">
                    <label class="inv-field-label @(suspect ? "inv-suspect-label" : "")">@label</label>
                    @if (State.SelectedFieldName == k)
                    {
                        <input type="text"
                               class="inv-field-input @(suspect ? "inv-suspect-input" : "")"
                               tabindex="-1"
                               data-edit-field="@k"
                               value="@_editValues.GetValueOrDefault(k, string.Empty)"
                               @oninput="@(e => _editValues[k] = e.Value?.ToString() ?? string.Empty)"
                               @onclick:stopPropagation="true" />
                    }
                    else
                    {
                        <span class="inv-field-value @(suspect ? "inv-suspect-text" : "")">
                            @(string.IsNullOrEmpty(_editValues.GetValueOrDefault(k)) ? "—" : _editValues[k])
                        </span>
                    }
                </div>
            }
        </div>

        @* ── Line items ─────────────────────────────────────────────── *@
        @if (inv.Items.Count > 0)
        {
            <div class="inv-line-items-section">
                <div class="inv-section-title">Line Items (@inv.Items.Count)</div>

                @for (int i = 0; i < inv.Items.Count; i++)
                {
                    var idx       = i;
                    var item      = inv.Items[idx];
                    var liSuspect = IsLineItemSuspect(item);
                    var descKey   = $"Item_{idx}_Desc";
                    var qtyKey    = $"Item_{idx}_Qty";
                    var upKey     = $"Item_{idx}_UnitPrice";
                    var amtKey    = $"Item_{idx}_Amt";
                    var liSel     = State.SelectedFieldName is { } _sf
                                 && _sf.StartsWith($"Item_{idx}_");

                    <div class="inv-line-item @(liSuspect ? "inv-li-suspect" : "") @(liSel ? "inv-li-selected" : "")">
                        <div class="inv-li-row inv-li-desc-row"
                             tabindex="0"
                             data-nav-row="@descKey"
                             @onclick="() => SelectField(descKey)">
                            <span class="inv-li-label">Description</span>
                            @if (State.SelectedFieldName == descKey)
                            {
                                <input type="text"
                                       class="inv-field-input"
                                       tabindex="-1"
                                       data-edit-field="@descKey"
                                       value="@item.Description"
                                       @oninput="@(e => inv.Items[idx].Description = e.Value?.ToString() ?? string.Empty)"
                                       @onclick:stopPropagation="true" />
                            }
                            else
                            {
                                <span class="inv-li-value">
                                    @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                                </span>
                            }
                        </div>

                        <div class="inv-li-row inv-li-nums-row">
                            <div class="inv-li-num-col"
                                 tabindex="0"
                                 data-nav-row="@qtyKey"
                                 @onclick="() => SelectField(qtyKey)">
                                <span class="inv-li-label">Qty</span>
                                @if (State.SelectedFieldName == qtyKey)
                                {
                                    <input type="text"
                                           class="inv-field-input inv-input-num"
                                           tabindex="-1"
                                           data-edit-field="@qtyKey"
                                           value="@(inv.Items[idx].Quantity?.ToString("G"))"
                                           @oninput="@(e => { if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) inv.Items[idx].Quantity = v; })"
                                           @onclick:stopPropagation="true" />
                                }
                                else
                                {
                                    <span class="inv-num">@(item.Quantity?.ToString("G") ?? "—")</span>
                                }
                            </div>
                            <div class="inv-li-num-col"
                                 tabindex="0"
                                 data-nav-row="@upKey"
                                 @onclick="() => SelectField(upKey)">
                                <span class="inv-li-label">Unit Price</span>
                                @if (State.SelectedFieldName == upKey)
                                {
                                    <input type="text"
                                           class="inv-field-input inv-input-num"
                                           tabindex="-1"
                                           data-edit-field="@upKey"
                                           value="@(inv.Items[idx].UnitPrice?.ToString("F2"))"
                                           @oninput="@(e => { if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) inv.Items[idx].UnitPrice = v; })"
                                           @onclick:stopPropagation="true" />
                                }
                                else
                                {
                                    <span class="inv-num">@(item.UnitPrice?.ToString("C") ?? "—")</span>
                                }
                            </div>
                            <div class="inv-li-num-col"
                                 tabindex="0"
                                 data-nav-row="@amtKey"
                                 @onclick="() => SelectField(amtKey)">
                                <span class="inv-li-label">Amount</span>
                                @if (State.SelectedFieldName == amtKey)
                                {
                                    <input type="text"
                                           class="inv-field-input inv-input-num"
                                           tabindex="-1"
                                           data-edit-field="@amtKey"
                                           value="@(inv.Items[idx].Amount?.ToString("F2"))"
                                           @oninput="@(e => { if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)) inv.Items[idx].Amount = v; })"
                                           @onclick:stopPropagation="true" />
                                }
                                else
                                {
                                    <span class="inv-num inv-num-bold">@(item.Amount?.ToString("C") ?? "—")</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        } @* end validation tab *@
    }
    else if (State.SelectedFilePath is not null)
    {
        <div class="inv-empty">No invoice data — run OCR first.</div>
    }
    else
    {
        <div class="inv-empty">Select a file to view data.</div>
    }
</div>

@code {
    private InvoiceDto? _invoice;
    private bool        _saving;
    private bool        _exporting;
    private int         _suspectCount;
    private bool        _shouldFocusFirstField;   // set true to focus first field row after render
    private string?     _fieldToFocusInput;       // key of input to auto-focus after next render
    private string      _activeTab = "validation"; // "validation" | "raw" | "validated"
    private string?     _rawJson;                 // lazy-loaded original OCR text (OcrText)
    private bool        _rawJsonLoading;
    private string?     _validatedJson;           // lazy-loaded validated JSON text (ValidatedOcrText)
    private bool        _validatedJsonLoading;
    private bool        _lineItemsCollapsed;      // true = line items body is hidden

    // Header field definitions — Key matches InvoiceDto property name exactly
    private static readonly (string Key, string Label)[] _headerFields =
    [
        ("VendorName",    "Vendor"),
        ("CustomerName",  "Customer"),
        ("InvoiceId",     "Invoice #"),
        ("InvoiceDate",   "Invoice Date"),
        ("DueDate",       "Due Date"),
        ("PurchaseOrder", "PO #"),
        ("Subtotal",      "Subtotal"),
        ("TotalTax",      "Tax"),
        ("Shipping",      "Shipping"),
        ("Total",         "Total"),
    ];

    // String-backed mutable state — display + edit values share this dictionary
    private readonly Dictionary<string, string> _editValues = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
        _invoice = State.SelectedInvoice;
        PopulateEditValues();
        ComputeSuspectCount();
    }

    public void Dispose() => State.OnChange -= OnStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_fieldToFocusInput is not null)
        {
            var key = _fieldToFocusInput;
            _fieldToFocusInput = null;
            await JS.InvokeVoidAsync("kocrFields.focusEditInput", key);
        }
        else if (_shouldFocusFirstField)
        {
            _shouldFocusFirstField = false;
            await JS.InvokeVoidAsync("kocrFields.focusFirst");
        }
    }

    private void OnStateChanged() => InvokeAsync(() =>
    {
        if (!ReferenceEquals(State.SelectedInvoice, _invoice))
        {
            _invoice            = State.SelectedInvoice;
            _saving             = false;
            _activeTab          = "validation";
            _rawJson            = null;
            _validatedJson      = null;
            _lineItemsCollapsed = false;
            _shouldFocusFirstField = _invoice is not null;
            PopulateEditValues();
            ComputeSuspectCount();
        }
        StateHasChanged();
    });

    // ── Helpers ───────────────────────────────────────────────────────────────

    private void PopulateEditValues()
    {
        _editValues.Clear();
        if (_invoice is null) return;

        _editValues["VendorName"]    = _invoice.VendorName    ?? string.Empty;
        _editValues["CustomerName"]  = _invoice.CustomerName  ?? string.Empty;
        _editValues["InvoiceId"]     = _invoice.InvoiceId     ?? string.Empty;
        _editValues["InvoiceDate"]   = _invoice.InvoiceDate   ?? string.Empty;
        _editValues["DueDate"]       = _invoice.DueDate       ?? string.Empty;
        _editValues["PurchaseOrder"] = _invoice.PurchaseOrder ?? string.Empty;
        _editValues["Subtotal"]      = _invoice.Subtotal?.ToString("F2")  ?? string.Empty;
        _editValues["TotalTax"]      = _invoice.TotalTax?.ToString("F2")  ?? string.Empty;
        _editValues["Shipping"]      = _invoice.Shipping?.ToString("F2")  ?? string.Empty;
        _editValues["Total"]         = _invoice.Total?.ToString("F2")     ?? string.Empty;
    }

    private void ComputeSuspectCount()
    {
        if (_invoice is null || _invoice.IsValidationAccepted || _invoice.IsEditedByUser)
        {
            _suspectCount = 0;
            return;
        }
        _suspectCount = _headerFields.Count(f => IsFieldSuspect(f.Key))
                      + (_invoice.Items?.Count(IsLineItemSuspect) ?? 0);
    }

    private bool IsFieldSuspect(string fieldName)
    {
        if (_invoice is null || _invoice.IsValidationAccepted || _invoice.IsEditedByUser) return false;
        if (_invoice.TesseractConfirmed.TryGetValue(fieldName,  out var t) && !t) return true;
        if (_invoice.ConfidenceConfirmed.TryGetValue(fieldName, out var c) && !c) return true;
        if (_invoice.MathConfirmed.TryGetValue(fieldName,       out var m) && !m) return true;
        return false;
    }

    private bool IsFieldChecked(string fieldName)
    {
        if (_invoice is null) return false;
        return _invoice.TesseractConfirmed.ContainsKey(fieldName)
            || _invoice.ConfidenceConfirmed.ContainsKey(fieldName)
            || _invoice.MathConfirmed.ContainsKey(fieldName);
    }

    private string? GetFieldTooltip(string fieldName)
    {
        if (_invoice is null) return null;
        var reasons = new List<string>();
        if (_invoice.TesseractConfirmed.TryGetValue(fieldName,  out var t) && !t) reasons.Add("Tesseract mismatch");
        if (_invoice.ConfidenceConfirmed.TryGetValue(fieldName, out var c) && !c) reasons.Add("Low Azure confidence");
        if (_invoice.MathConfirmed.TryGetValue(fieldName,       out var m) && !m) reasons.Add("Math error");
        return reasons.Count > 0 ? string.Join(" · ", reasons) : null;
    }

    private bool IsLineItemSuspect(InvoiceItemDto item)
    {
        if (_invoice?.IsValidationAccepted == true || _invoice?.IsEditedByUser == true) return false;
        return item.TesseractConfirmed.Values.Any(v => !v)
            || item.ConfidenceConfirmed.Values.Any(v => !v);
    }

    // ── Field selection & inline editing ─────────────────────────────────────

    /// <summary>
    /// Selects a field for inline editing and bbox highlighting.
    /// Triggers auto-focus of the corresponding input after the next render.
    /// </summary>
    private void SelectField(string fieldName)
    {
        State.SetSelectedField(fieldName);
        _fieldToFocusInput = fieldName;
    }
    // ── Actions ───────────────────────────────────────────────────────────────

    /// <summary>
    /// Saves current field values to the database. Called by the Save button and Ctrl+S.
    /// </summary>
    private async Task SaveAsync()
    {
        if (_invoice is null || State.SelectedFilePath is null || _saving) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var updated = BuildUpdatedInvoice();
            var settings = await ConfigService.LoadSettingsAsync();
            await ProcessingService.SaveInvoiceAsync(State.SelectedFilePath, updated, settings.ProjectArtifacts);

            // Update reference without resetting _editValues (user may still be editing)
            _invoice = updated;
            State.SetSelectedInvoice(updated);
            ComputeSuspectCount();
            _validatedJson = null;
            if (_activeTab == "validated") await LoadValidatedJsonAsync();
        }
        catch (Exception ex) { Toast.ShowError($"Save failed: {ex.Message}"); }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private InvoiceDto BuildUpdatedInvoice()
    {
        decimal? ParseDec(string key) =>
            decimal.TryParse(_editValues.GetValueOrDefault(key),
                             System.Globalization.NumberStyles.Any,
                             System.Globalization.CultureInfo.InvariantCulture,
                             out var v) ? v : null;

        return new InvoiceDto
        {
            VendorName           = _editValues.GetValueOrDefault("VendorName",    string.Empty),
            CustomerName         = _editValues.GetValueOrDefault("CustomerName",  string.Empty),
            InvoiceId            = _editValues.GetValueOrDefault("InvoiceId",     string.Empty),
            InvoiceDate          = _editValues.GetValueOrDefault("InvoiceDate",   string.Empty),
            DueDate              = _editValues.GetValueOrDefault("DueDate",       string.Empty),
            PurchaseOrder        = _editValues.GetValueOrDefault("PurchaseOrder", string.Empty),
            Subtotal             = ParseDec("Subtotal"),
            TotalTax             = ParseDec("TotalTax"),
            Shipping             = ParseDec("Shipping"),
            Total                = ParseDec("Total"),
            Items                = _invoice!.Items,
            FieldBoundingBoxes   = _invoice.FieldBoundingBoxes,
            FieldConfidences     = _invoice.FieldConfidences,
            OriginalPageWidth    = _invoice.OriginalPageWidth,
            OriginalPageHeight   = _invoice.OriginalPageHeight,
            PageCount            = _invoice.PageCount,
            TesseractConfirmed   = _invoice.TesseractConfirmed,
            ConfidenceConfirmed  = _invoice.ConfidenceConfirmed,
            MathConfirmed        = _invoice.MathConfirmed,
            IsEditedByUser       = true,
            IsValidationAccepted = false,
        };
    }

    private async Task AcceptValidationAsync()
    {
        if (_invoice is null || State.SelectedFilePath is null) return;
        _saving = true;
        try
        {
            _invoice.IsValidationAccepted = true;
            var settings = await ConfigService.LoadSettingsAsync();
            await ProcessingService.SaveInvoiceAsync(State.SelectedFilePath, _invoice, settings.ProjectArtifacts);
            State.SetSelectedInvoice(_invoice);
            _suspectCount = 0;
            _validatedJson = null;
            if (_activeTab == "validated") await LoadValidatedJsonAsync();
        }
        catch (Exception ex) { Toast.ShowError($"Accept failed: {ex.Message}"); }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    // ── DOCX export ───────────────────────────────────────────────────────────

    private async Task ExportDocxAsync()
    {
        if (_invoice is null || State.SelectedFilePath is null || _exporting) return;
        _exporting = true;
        StateHasChanged();
        try
        {
            // Build a minimal OCRFile so DocumentExportService can write the DOCX.
            var ocrFile = new K_OCR.Models.OCRFile
            {
                FilePath         = State.SelectedFilePath,
                OcrText          = string.Empty,
                ValidatedOcrText = Newtonsoft.Json.JsonConvert.SerializeObject(_invoice),
            };

            // ExportToDocxAsync writes to a file path; use a temp file then read it back.
            var tmp = System.IO.Path.Combine(
                System.IO.Path.GetTempPath(),
                System.IO.Path.GetFileNameWithoutExtension(State.SelectedFilePath) + ".docx");

            await ExportService.ExportToDocxAsync(ocrFile, tmp);

            var bytes    = await System.IO.File.ReadAllBytesAsync(tmp);
            var base64   = Convert.ToBase64String(bytes);
            var fileName = System.IO.Path.GetFileNameWithoutExtension(State.SelectedFilePath) + ".docx";
            const string mime = "application/vnd.openxmlformats-officedocument.wordprocessingml.document";

            await JS.InvokeVoidAsync("kocrExport.saveAs", base64, fileName, mime);

            try { System.IO.File.Delete(tmp); } catch { /* best-effort cleanup */ }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Export failed: {ex.Message}");
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    // ── Keyboard shortcut entry points (called from MainLayout via JS interop) ───

    /// <summary>Ctrl+S — saves current field values immediately.</summary>
    public Task TriggerSaveAsync() => SaveAsync();

    /// <summary>Ctrl+E — exports the current invoice as DOCX.</summary>
    public Task TriggerExportAsync() => ExportDocxAsync();

    /// <summary>Escape — deselects the currently focused/editing field.</summary>
    public Task TriggerEscapeAsync() =>
        InvokeAsync(() => State.SetSelectedField(null));

    /// <summary>
    /// Tab / Shift+Tab — moves the bbox highlight to the next (+1) or previous (-1)
    /// suspect field that has a bounding box.  Does nothing when in edit mode.
    /// </summary>
    public Task CycleSuspectFieldAsync(int delta)
    {
        if (_invoice is null) return Task.CompletedTask;

        return InvokeAsync(() =>
        {
            var suspects = _headerFields
                .Where(f => IsFieldSuspect(f.Key)
                         && _invoice?.FieldBoundingBoxes.ContainsKey(f.Key) == true)
                .Select(f => f.Key)
                .ToList();

            if (suspects.Count == 0) return;

            var currentIdx = suspects.IndexOf(State.SelectedFieldName ?? string.Empty);
            var nextIdx    = ((currentIdx + delta) % suspects.Count + suspects.Count) % suspects.Count;
            State.SetSelectedField(suspects[nextIdx]);
        });
    }
    // ── Nav-row focus (Tab navigation → highlight matching bbox) ─────────────────────

    /// <summary>
    /// Called by the JS Tab handler (and focusNavRow) whenever focus moves to a
    /// [data-nav-row] element.  Selects the field for editing and bbox highlight.
    /// </summary>
    public Task OnNavRowFocusedAsync(string key) => InvokeAsync(() =>
    {
        if (_invoice is null) return;
        State.SetSelectedField(key);
        _fieldToFocusInput = key;
    });
    // ── Raw JSON tab ─────────────────────────────────────────────────────────

    private async Task SwitchTabAsync(string tab)
    {
        _activeTab = tab;
        if (tab == "raw" && _rawJson is null && !_rawJsonLoading)
            await ReloadRawJsonAsync();
        else if (tab == "validated" && _validatedJson is null && !_validatedJsonLoading)
            await LoadValidatedJsonAsync();
    }

    private async Task ReloadRawJsonAsync()
    {
        if (State.SelectedFilePath is null) return;
        _rawJsonLoading = true;
        StateHasChanged();
        try
        {
            var ocrFile = await DatabaseSvc.GetOCRFileByPathAsync(State.SelectedFilePath);
            if (ocrFile is not null)
            {
                var raw = ocrFile.OcrText; // always the original OCR output
                if (!string.IsNullOrWhiteSpace(raw))
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(raw);
                        _rawJson = System.Text.Json.JsonSerializer.Serialize(
                            doc.RootElement,
                            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                    }
                    catch { _rawJson = raw; }
                }
                else
                {
                    _rawJson = "(no OCR text stored for this file)";
                }
            }
            else
            {
                _rawJson = "(file not found in database)";
            }
        }
        catch (Exception ex) { _rawJson = $"Error loading raw data: {ex.Message}"; }
        finally { _rawJsonLoading = false; }
    }

    private async Task LoadValidatedJsonAsync()
    {
        if (State.SelectedFilePath is null) return;
        _validatedJsonLoading = true;
        StateHasChanged();
        try
        {
            var ocrFile = await DatabaseSvc.GetOCRFileByPathAsync(State.SelectedFilePath);
            if (ocrFile is null)
            {
                _validatedJson = "(file not found in database)";
                return;
            }

            if (string.IsNullOrWhiteSpace(ocrFile.ValidatedOcrText))
            {
                _validatedJson = null; // "not yet validated" shown by UI
                return;
            }

            // ValidatedOcrText contains only the Layout array (List<InvoiceDto>).
            // For display, merge it back into the full PipelineContext from OcrText so
            // the Validated JSON tab shows the same top-level shape as the Raw JSON tab.
            try
            {
                var rawOptions = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };

                if (!string.IsNullOrWhiteSpace(ocrFile.OcrText))
                {
                    // Parse the raw context as a generic JSON object so we can swap Layout
                    var rawObj = Newtonsoft.Json.Linq.JObject.Parse(ocrFile.OcrText);
                    var valLayout = Newtonsoft.Json.Linq.JToken.Parse(ocrFile.ValidatedOcrText);
                    rawObj["Layout"] = valLayout;
                    _validatedJson = rawObj.ToString(Newtonsoft.Json.Formatting.Indented);
                }
                else
                {
                    // No raw context — just pretty-print the validated JSON as-is
                    using var doc = System.Text.Json.JsonDocument.Parse(ocrFile.ValidatedOcrText);
                    _validatedJson = System.Text.Json.JsonSerializer.Serialize(doc.RootElement, rawOptions);
                }
            }
            catch
            {
                _validatedJson = ocrFile.ValidatedOcrText;
            }
        }
        catch (Exception ex) { _validatedJson = $"Error loading validated data: {ex.Message}"; }
        finally { _validatedJsonLoading = false; }
    }
}
