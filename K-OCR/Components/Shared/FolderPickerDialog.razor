@*  FolderPickerDialog.razor — server-side directory browser.
    Usage:
      <FolderPickerDialog @ref="_folderPicker" />
      ...
      var chosen = await _folderPicker!.ShowAsync(_settings.ProjectDirectory);
      if (chosen is not null) _settings.ProjectDirectory = chosen;
*@

@if (_visible)
{
    <div class="fpicker-overlay" @onclick="Cancel" role="dialog"
         aria-modal="true" aria-labelledby="fpicker-title">
        <div class="fpicker-dialog" @onclick:stopPropagation="true">

            <!-- ── Header ─────────────────────────────────── -->
            <div class="fpicker-header">
                <span id="fpicker-title" class="fpicker-title">Select Folder</span>
                <button class="fpicker-close" @onclick="Cancel" aria-label="Close">✕</button>
            </div>

            <!-- ── Current path ───────────────────────────── -->
            <div class="fpicker-path" title="@_currentPath">
                <span class="fpicker-path-icon">📁</span>
                <span class="fpicker-path-text">@_currentPath</span>
            </div>

            <!-- ── Toolbar: Up + New Folder ───────────────── -->
            <div class="fpicker-toolbar">
                <button class="btn fpicker-btn fpicker-up-btn"
                        @onclick="GoUp"
                        disabled="@(!CanGoUp)"
                        aria-label="Go to parent directory">
                    ↑ Up
                </button>
                <div class="fpicker-newfolder">
                    <input class="fpicker-input"
                           type="text"
                           placeholder="New folder name…"
                           @bind="_newFolderName"
                           @bind:event="oninput"
                           @onkeydown="OnNewFolderKeyDown" />
                    <button class="btn fpicker-btn"
                            @onclick="CreateFolderAsync"
                            disabled="@(string.IsNullOrWhiteSpace(_newFolderName) || _creating)">
                        @(_creating ? "Creating…" : "+ New Folder")
                    </button>
                </div>
            </div>

            <!-- ── Error banner ───────────────────────────── -->
            @if (_error is not null)
            {
                <div class="fpicker-error">⚠ @_error</div>
            }

            <!-- ── Directory listing ──────────────────────── -->
            <div class="fpicker-list" role="listbox" aria-label="Subdirectories">
                @if (_loading)
                {
                    <div class="fpicker-empty">Loading…</div>
                }
                else if (_entries.Count == 0)
                {
                    <div class="fpicker-empty">No sub-folders in this directory.</div>
                }
                else
                {
                    @foreach (var entry in _entries)
                    {
                        var localEntry = entry;
                        <div class="fpicker-entry"
                             role="option"
                             tabindex="0"
                             @onclick="() => NavigateTo(localEntry)"
                             @onkeydown="(e) => OnEntryKeyDown(e, localEntry)"
                             title="@localEntry">
                            📁 @FolderName(localEntry)
                        </div>
                    }
                }
            </div>

            <!-- ── Footer ─────────────────────────────────── -->
            <div class="fpicker-footer">
                <span class="fpicker-selected-label" title="@_currentPath">
                    @_currentPath
                </span>
                <div class="fpicker-footer-actions">
                    <button class="btn fpicker-btn-cancel" @onclick="Cancel">Cancel</button>
                    <button class="btn fpicker-btn-select"
                            @onclick="Select"
                            disabled="@string.IsNullOrEmpty(_currentPath)">
                        Select This Folder
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    private bool   _visible;
    private bool   _loading;
    private bool   _creating;
    private string _currentPath  = string.Empty;
    private string _newFolderName = string.Empty;
    private string? _error;
    private List<string> _entries = new();
    private TaskCompletionSource<string?>? _tcs;

    private bool CanGoUp =>
        !string.IsNullOrEmpty(_currentPath) &&
        Directory.GetParent(_currentPath) is not null;

    // ── Public API ────────────────────────────────────────────────────────────

    /// <summary>
    /// Show the picker starting at <paramref name="startPath"/> (falls back to
    /// the user's home directory).  Returns the chosen path, or null if the
    /// user cancels.
    /// </summary>
    public Task<string?> ShowAsync(string? startPath = null)
    {
        _tcs = new TaskCompletionSource<string?>();

        _currentPath = Directory.Exists(startPath)
            ? startPath!
            : Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);

        _newFolderName = string.Empty;
        _error         = null;
        _visible       = true;

        LoadEntries();
        InvokeAsync(StateHasChanged);
        return _tcs.Task;
    }

    // ── Navigation ────────────────────────────────────────────────────────────

    private void NavigateTo(string path)
    {
        _error = null;
        _currentPath = path;
        LoadEntries();
        StateHasChanged();
    }

    private void GoUp()
    {
        var parent = Directory.GetParent(_currentPath)?.FullName;
        if (parent is not null)
            NavigateTo(parent);
    }

    private void LoadEntries()
    {
        _loading = true;
        try
        {
            _entries = Directory.Exists(_currentPath)
                ? Directory.GetDirectories(_currentPath)
                            .OrderBy(d => FolderName(d), StringComparer.OrdinalIgnoreCase)
                            .ToList()
                : new List<string>();
        }
        catch (UnauthorizedAccessException)
        {
            _entries = new();
            _error   = "Access denied.";
        }
        catch (Exception ex)
        {
            _entries = new();
            _error   = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // ── New Folder ────────────────────────────────────────────────────────────

    private async Task CreateFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(_newFolderName)) return;

        _creating = true;
        _error    = null;
        StateHasChanged();

        try
        {
            var newPath = Path.Combine(_currentPath, _newFolderName.Trim());
            Directory.CreateDirectory(newPath);
            _newFolderName = string.Empty;
            _currentPath   = newPath;       // navigate into the new folder
            LoadEntries();
        }
        catch (Exception ex)
        {
            _error = $"Could not create folder: {ex.Message}";
        }
        finally
        {
            _creating = false;
            StateHasChanged();
        }
    }

    // ── Selection ─────────────────────────────────────────────────────────────

    private void Select()
    {
        _visible = false;
        var result = _currentPath;
        StateHasChanged();
        _tcs?.TrySetResult(result);
    }

    private void Cancel()
    {
        _visible = false;
        StateHasChanged();
        _tcs?.TrySetResult(null);
    }

    // ── Keyboard ──────────────────────────────────────────────────────────────

    private void OnEntryKeyDown(KeyboardEventArgs e, string path)
    {
        if (e.Key is "Enter" or " ")
            NavigateTo(path);
    }

    private async Task OnNewFolderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CreateFolderAsync();
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string FolderName(string path) =>
        Path.GetFileName(path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
        is { Length: > 0 } name ? name : path;
}
