@*  FolderPickerDialog.razor — server-side directory browser.
    Usage:
      <FolderPickerDialog @ref="_folderPicker" />
      ...
      var chosen = await _folderPicker!.ShowAsync(_settings.DefaultStartFolder);
      if (chosen is not null) _settings.DefaultStartFolder = chosen;
*@

@if (_visible)
{
    <div class="fpicker-overlay" @onclick="Cancel" role="dialog"
         aria-modal="true" aria-labelledby="fpicker-title">
        <div class="fpicker-dialog" @onclick:stopPropagation="true">

            <!-- ── Header ─────────────────────────────────── -->
            <div class="fpicker-header">
                <span id="fpicker-title" class="fpicker-title">Select Folder</span>
                <button class="fpicker-close" @onclick="Cancel" aria-label="Close">✕</button>
            </div>

            <!-- ── Current path ───────────────────────────── -->
            <div class="fpicker-path" title="@_currentPath">
                @if (_rootPath is not null)
                {
                    <span class="fpicker-path-icon">🏠</span>
                    <span class="fpicker-path-root" title="@_rootPath">@FolderName(_rootPath)</span>
                    @if (!string.Equals(_currentPath, _rootPath, StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="fpicker-path-sep"> / </span>
                        <span class="fpicker-path-text">@RelativePath</span>
                    }
                }
                else
                {
                    <span class="fpicker-path-icon">📁</span>
                    <span class="fpicker-path-text">@_currentPath</span>
                }
            </div>

            <!-- ── Toolbar: Up + New Folder ───────────────── -->
            <div class="fpicker-toolbar">
                @if (_rootPath is null && _drives.Count > 0)
                {
                    <select class="fpicker-input" style="width:auto; margin-right:8px; cursor:pointer;" 
                            @onchange="OnDriveChanged">
                        @foreach (var drive in _drives)
                        {
                            <option value="@drive.Name" selected="@IsDriveSelected(drive)">
                                @drive.Name
                            </option>
                        }
                    </select>
                }
                <button class="btn fpicker-btn fpicker-up-btn"
                        @onclick="GoUp"
                        disabled="@(!CanGoUp)"
                        aria-label="Go to parent directory">
                    ↑ Up
                </button>
                <div class="fpicker-newfolder">
                    <input class="fpicker-input"
                           type="text"
                           placeholder="New folder name…"
                           @bind="_newFolderName"
                           @bind:event="oninput"
                           @onkeydown="OnNewFolderKeyDown" />
                    <button class="btn fpicker-btn"
                            @onclick="CreateFolderAsync"
                            disabled="@(string.IsNullOrWhiteSpace(_newFolderName) || _creating)">
                        @(_creating ? "Creating…" : "+ New Folder")
                    </button>
                </div>
            </div>

            <!-- ── Error banner ───────────────────────────── -->
            @if (_error is not null)
            {
                <div class="fpicker-error">⚠ @_error</div>
            }

            <!-- ── Directory listing ──────────────────────── -->
            <div class="fpicker-list" role="listbox" aria-label="Subdirectories">
                @if (_loading)
                {
                    <div class="fpicker-empty">Loading…</div>
                }
                else if (_entries.Count == 0)
                {
                    <div class="fpicker-empty">No sub-folders in this directory.</div>
                }
                else
                {
                    @foreach (var entry in _entries)
                    {
                        var localEntry = entry;
                        <div class="fpicker-entry"
                             role="option"
                             tabindex="0"
                             @onclick="() => NavigateTo(localEntry)"
                             @onkeydown="(e) => OnEntryKeyDown(e, localEntry)"
                             title="@localEntry">
                            📁 @FolderName(localEntry)
                        </div>
                    }
                }
            </div>

            <!-- ── Footer ─────────────────────────────────── -->
            <div class="fpicker-footer">
                <span class="fpicker-selected-label" title="@_currentPath">
                    @_currentPath
                </span>
                <div class="fpicker-footer-actions">
                    <button class="btn fpicker-btn-cancel" @onclick="Cancel">Cancel</button>
                    <button class="btn fpicker-btn-select"
                            @onclick="Select"
                            disabled="@string.IsNullOrEmpty(_currentPath)">
                        Select This Folder
                    </button>
                </div>
            </div>

        </div>
    </div>
}

@code {
    private bool   _visible;
    private bool   _loading;
    private bool   _creating;
    private string _currentPath  = string.Empty;
    private string? _rootPath;         // when set, navigation cannot go above this directory
    private string _newFolderName = string.Empty;
    private string? _error;
    private List<string> _entries = new();
    private TaskCompletionSource<string?>? _tcs;

    // Up is allowed only when there is a parent and we haven't reached the root
    private bool CanGoUp =>
        !string.IsNullOrEmpty(_currentPath) &&
        Directory.GetParent(_currentPath) is not null &&
        (_rootPath is null || !string.Equals(_currentPath, _rootPath, StringComparison.OrdinalIgnoreCase));

    // Path shown in the breadcrumb: relative to root when rooted, full otherwise
    private string RelativePath =>
        _rootPath is not null &&
        _currentPath.StartsWith(_rootPath, StringComparison.OrdinalIgnoreCase)
            ? _currentPath[_rootPath.Length..]
                .TrimStart(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
            : _currentPath;

    // ── Public API ────────────────────────────────────────────────────────────

    /// <summary>
    /// Show the picker starting at <paramref name="startPath"/>.
    /// When <paramref name="rootPath"/> is provided the dialog is constrained to
    /// that directory — the user cannot navigate above it, and paths are shown
    /// relative to it.  Falls back to the user's home directory if neither is
    /// a valid existing path.
    /// </summary>
    public Task<string?> ShowAsync(string? startPath = null, string? rootPath = null)
    {
        _tcs = new TaskCompletionSource<string?>();

        _rootPath = Directory.Exists(rootPath) ? rootPath : null;

        _currentPath = Directory.Exists(startPath)
            ? startPath!
            : _rootPath ?? Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);

        // If startPath is outside the root, reset to root
        if (_rootPath is not null &&
            !_currentPath.StartsWith(_rootPath, StringComparison.OrdinalIgnoreCase))
            _currentPath = _rootPath;

        _newFolderName = string.Empty;
        _error         = null;
        _visible       = true;

        if (_rootPath is null) LoadDrives();
        
        LoadEntries();
        InvokeAsync(StateHasChanged);
        return _tcs.Task;
    }

    // ── Navigation ────────────────────────────────────────────────────────────

    private void NavigateTo(string path)
    {
        _error = null;
        _currentPath = path;
        LoadEntries();
        StateHasChanged();
    }

    private void GoUp()
    {
        var parent = Directory.GetParent(_currentPath)?.FullName;
        if (parent is not null)
            NavigateTo(parent);
    }

    private void LoadEntries()
    {
        _loading = true;
        try
        {
            _entries = Directory.Exists(_currentPath)
                ? Directory.GetDirectories(_currentPath)
                            .OrderBy(d => FolderName(d), StringComparer.OrdinalIgnoreCase)
                            .ToList()
                : new List<string>();
        }
        catch (UnauthorizedAccessException)
        {
            _entries = new();
            _error   = "Access denied.";
        }
        catch (Exception ex)
        {
            _entries = new();
            _error   = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
    
    // ── Drives ────────────────────────────────────────────────────────────────
    
    private List<DriveInfo> _drives = new();
    
    private void LoadDrives()
    {
        try 
        {
            _drives = DriveInfo.GetDrives().Where(d => d.IsReady).ToList();
        }
        catch 
        { 
            _drives = new(); 
        }
    }

    private void OnDriveChanged(ChangeEventArgs e)
    {
        var driveName = e.Value?.ToString();
        if (!string.IsNullOrEmpty(driveName))
        {
            NavigateTo(driveName);
        }
    }
    
    private bool IsDriveSelected(DriveInfo drive) =>
        _currentPath.StartsWith(drive.Name, StringComparison.OrdinalIgnoreCase);

    // ── New Folder ────────────────────────────────────────────────────────────

    private async Task CreateFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(_newFolderName)) return;

        _creating = true;
        _error    = null;
        StateHasChanged();

        try
        {
            var newPath = Path.Combine(_currentPath, _newFolderName.Trim());
            Directory.CreateDirectory(newPath);
            _newFolderName = string.Empty;
            _currentPath   = newPath;       // navigate into the new folder
            LoadEntries();
        }
        catch (Exception ex)
        {
            _error = $"Could not create folder: {ex.Message}";
        }
        finally
        {
            _creating = false;
            StateHasChanged();
        }
    }

    // ── Selection ─────────────────────────────────────────────────────────────

    private void Select()
    {
        _visible = false;
        var result = _currentPath;
        StateHasChanged();
        _tcs?.TrySetResult(result);
    }

    private void Cancel()
    {
        _visible = false;
        StateHasChanged();
        _tcs?.TrySetResult(null);
    }

    // ── Keyboard ──────────────────────────────────────────────────────────────

    private void OnEntryKeyDown(KeyboardEventArgs e, string path)
    {
        if (e.Key is "Enter" or " ")
            NavigateTo(path);
    }

    private async Task OnNewFolderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CreateFolderAsync();
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string FolderName(string path) =>
        Path.GetFileName(path.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
        is { Length: > 0 } name ? name : path;
}
