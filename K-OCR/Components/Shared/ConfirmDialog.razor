@* Reusable confirmation modal.
   Usage:
     <ConfirmDialog @ref="_confirmDialog"
                    Title="Delete everything?"
                    Message="This cannot be undone."
                    ConfirmLabel="Yes, delete"
                    OnConfirmed="HandleConfirmedAsync" />
   Then call: await _confirmDialog.ShowAsync();
*@

@if (_visible)
{
    <div class="confirm-overlay" @onclick="HandleOverlayClick" role="dialog"
         aria-modal="true" aria-labelledby="confirm-title">
        <div class="confirm-dialog" @onclick:stopPropagation="true">
            <div class="confirm-header">
                <span id="confirm-title" class="confirm-title">@Title</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="confirm-body">@Message</div>
            }
            <div class="confirm-actions">
                <button class="btn confirm-btn-cancel" @onclick="Cancel" disabled="@_busy">Cancel</button>
                <button class="btn confirm-btn-confirm @(Danger ? "confirm-btn-danger" : "")"
                        @onclick="Confirm" disabled="@_busy">
                    @(_busy ? "Working…" : ConfirmLabel)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Title        { get; set; } = "Are you sure?";
    [Parameter] public string Message      { get; set; } = string.Empty;
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm";
    [Parameter] public bool   Danger       { get; set; } = false;
    [Parameter] public EventCallback OnConfirmed { get; set; }

    private bool _visible;
    private bool _busy;
    private TaskCompletionSource<bool>? _tcs;

    /// <summary>Show the dialog and asynchronously wait for the user's choice.</summary>
    public Task<bool> ShowAsync()
    {
        _tcs     = new TaskCompletionSource<bool>();
        _visible = true;
        _busy    = false;
        InvokeAsync(StateHasChanged);
        return _tcs.Task;
    }

    private async Task Confirm()
    {
        _busy = true;
        StateHasChanged();
        await OnConfirmed.InvokeAsync();
        _visible = false;
        _busy    = false;
        _tcs?.TrySetResult(true);
    }

    private void Cancel()
    {
        _visible = false;
        _tcs?.TrySetResult(false);
        StateHasChanged();
    }

    private void HandleOverlayClick() => Cancel();
}
