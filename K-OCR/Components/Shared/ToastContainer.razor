@inject ToastService Toast
@implements IDisposable

@if (_toasts.Count > 0)
{
    <div class="toast-container" role="status" aria-live="polite" aria-atomic="false">
        @foreach (var t in _toasts)
        {
            var cssLevel = t.Level.ToString().ToLowerInvariant();
            <div class="toast toast-@cssLevel" role="alert">
                <span class="toast-icon" aria-hidden="true">@IconFor(t.Level)</span>
                <span class="toast-text">@t.Text</span>
                <button class="toast-close" @onclick="() => Dismiss(t.Id)"
                        aria-label="Dismiss notification">×</button>
            </div>
        }
    </div>
}

@code {
    private readonly List<ToastMessage> _toasts = [];

    protected override void OnInitialized() =>
        Toast.OnToast += OnToastReceived;

    public void Dispose() =>
        Toast.OnToast -= OnToastReceived;

    private void OnToastReceived(ToastMessage msg)
    {
        InvokeAsync(async () =>
        {
            _toasts.Add(msg);
            StateHasChanged();
            await Task.Delay(5000);
            Dismiss(msg.Id);
        });
    }

    private void Dismiss(Guid id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        InvokeAsync(StateHasChanged);
    }

    private static string IconFor(ToastLevel level) => level switch
    {
        ToastLevel.Success => "✓",
        ToastLevel.Warning => "⚠",
        ToastLevel.Error   => "✕",
        _                  => "ℹ",
    };
}
