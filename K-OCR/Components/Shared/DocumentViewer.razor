@inject WorkspaceState State
@inject IImageService ImageService
@inject IConfigurationService ConfigService
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_loading)
{
    <div class="viewer-loading">
        <span class="loading-spinner"></span> Loading document…
    </div>
}
else if (_error is not null)
{
    <div class="viewer-error">⚠ @_error</div>
}
else if (_pages.Count == 0)
{
    <div class="kocr-center-placeholder">
        <span>Select a file to view the document</span>
    </div>
}
else
{
    <!-- Toolbar -->
    <div class="viewer-toolbar">
        <button class="viewer-btn" @onclick="ZoomOut" aria-label="Zoom out" title="Zoom out (−)">−</button>
        <span class="viewer-zoom-label">@ZoomLabel</span>
        <button class="viewer-btn" @onclick="ZoomIn"  aria-label="Zoom in" title="Zoom in (+)">+</button>
        <button class="viewer-btn viewer-btn-fit" @onclick="ZoomFit" aria-label="Fit to width" title="Fit to width">⊞ Fit</button>
        @if (_pages.Count > 1)
        {
            <span class="viewer-page-count">@_pages.Count pages</span>
        }
    </div>

    <!-- Pages -->
    <div class="viewer-scroll">
        @for (int i = 0; i < _pages.Count; i++)
        {
            var page  = _pages[i];
            var label = i + 1;
            @if (_pages.Count > 1)
            {
                <div class="viewer-page-label">Page @label</div>
            }
            <div class="viewer-page-wrap">
                <div class="viewer-img-wrap"
                     style="width: @(_zoomPct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%">
                    <img class="viewer-page-img"
                         src="/api/image?path=@Uri.EscapeDataString(page)"
                         alt="Page @label"
                         loading="lazy" />
                    @{
                        var inv = State.SelectedInvoice;
                        var hasFieldBoxes = inv?.FieldBoundingBoxes.Count > 0;
                        var hasItemBoxes  = inv?.Items.Any(it => it.BoundingBoxes.Count > 0) == true;
                        if ((hasFieldBoxes || hasItemBoxes) && inv?.OriginalPageWidth > 0)
                        {
                            var pageNo = label;
                            var pw = inv.OriginalPageWidth.ToString("G9",  System.Globalization.CultureInfo.InvariantCulture);
                            var ph = inv.OriginalPageHeight.ToString("G9", System.Globalization.CultureInfo.InvariantCulture);
                            <svg class="viewer-bbox-overlay"
                                 viewBox="0 0 @pw @ph"
                                 xmlns="http://www.w3.org/2000/svg">
                                @foreach (var kvp in inv.FieldBoundingBoxes)
                                {
                                    var fld        = kvp.Key;
                                    var isSelected = fld == State.SelectedFieldName;
                                    var isSuspect  = BboxIsSuspect(inv, fld);
                                    var bboxClass  = isSelected ? "bbox-selected"
                                                   : isSuspect  ? "bbox-suspect"
                                                   :              "bbox-ok";
                                    foreach (var box in kvp.Value.Where(b => b.PageNumber == pageNo))
                                    {
                                        <polygon points="@FormatBboxPoints(box.Points)"
                                                 class="viewer-bbox @bboxClass"
                                                 style="pointer-events:all;cursor:pointer"
                                                 @onclick="() => OnBboxClickedAsync(fld)"
                                                 @onclick:stopPropagation="true" />
                                    }
                                }
                                @for (int ii = 0; ii < inv.Items.Count; ii++)
                                {
                                    var itemIdx  = ii;
                                    var lineItem = inv.Items[itemIdx];
                                    if (lineItem.BoundingBoxes.Count == 0) { continue; }
                                    var itemKey      = $"Item_{itemIdx}_Desc";
                                    var sel          = State.SelectedFieldName;
                                    var itemSelected = sel is not null && sel.StartsWith($"Item_{itemIdx}_");
                                    var itemSuspect  = ItemIsSuspect(inv, lineItem);
                                    var itemClass    = itemSelected ? "bbox-selected"
                                                     : itemSuspect  ? "bbox-suspect"
                                                     :                "bbox-ok";
                                    foreach (var box in lineItem.BoundingBoxes.Where(b => b.PageNumber == pageNo))
                                    {
                                        <polygon points="@FormatBboxPoints(box.Points)"
                                                 class="viewer-bbox @itemClass"
                                                 style="pointer-events:all;cursor:pointer"
                                                 @onclick="() => OnBboxClickedAsync(itemKey)"
                                                 @onclick:stopPropagation="true" />
                                    }
                                }
                            </svg>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<string> _pages    = new();
    private bool         _loading;
    private string?      _error;
    private double       _zoomPct  = 100.0;
    private string?      _lastPath;
    private string?      _lastSelectedField;
    private bool         _needsScrollToBbox;

    private string ZoomLabel => _zoomPct == 100.0 ? "100%" : $"{_zoomPct:0}%";

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        await LoadPagesAsync(State.SelectedFilePath);
    }

    private void OnStateChanged() =>
        InvokeAsync(async () =>
        {
            await CheckAndLoadAsync();
            if (State.SelectedFieldName != _lastSelectedField)
            {
                _lastSelectedField = State.SelectedFieldName;
                if (_lastSelectedField is not null)
                    _needsScrollToBbox = true;
            }
            StateHasChanged();
        });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsScrollToBbox)
        {
            _needsScrollToBbox = false;
            await JS.InvokeVoidAsync("kocrFields.scrollBboxIntoView");
        }
    }

    private async Task CheckAndLoadAsync()
    {
        var path = State.SelectedFilePath;
        if (path == _lastPath) return;
        await LoadPagesAsync(path);
    }

    // ── Image loading ─────────────────────────────────────────────────────────

    private async Task LoadPagesAsync(string? filePath)
    {
        _lastPath = filePath;
        _pages.Clear();
        _error = null;

        if (filePath is null)
        {
            _loading = false;
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            var ext = Path.GetExtension(filePath).ToLowerInvariant();

            if (ext == ".pdf")
            {
                var settings  = await ConfigService.LoadSettingsAsync();
                var artifacts = settings.ProjectArtifacts;

                if (string.IsNullOrEmpty(artifacts))
                {
                    // Fall back to an "artifacts" sub-folder beside the PDF
                    artifacts = Path.Combine(
                        Path.GetDirectoryName(filePath) ?? string.Empty,
                        "artifacts");
                }

                var pages = await ImageService.ConvertPdfToAllPngsAsync(filePath, artifacts);
                _pages = pages;

                if (_pages.Count == 0)
                    _error = "PDF could not be converted — no pages were produced.";
            }
            else
            {
                if (!File.Exists(filePath))
                    _error = "File not found.";
                else
                    _pages = new List<string> { filePath };
            }

            _zoomPct = 100.0;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load document: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Bbox click → select field + focus matching validation row ─────────────

    private async Task OnBboxClickedAsync(string key)
    {
        State.SetSelectedField(key);
        await JS.InvokeVoidAsync("kocrFields.focusNavRow", key);
    }

    // ── Zoom controls ─────────────────────────────────────────────────────────

    private void ZoomIn()  => _zoomPct = Math.Min(_zoomPct * 1.25, 500.0);
    private void ZoomOut() => _zoomPct = Math.Max(_zoomPct / 1.25,  20.0);
    private void ZoomFit() => _zoomPct = 100.0;

    // ── Bounding box helpers ───────────────────────────────────────────────────

    /// <summary>Convert Azure polygon float pairs to SVG "x,y" point string.</summary>
    private static string FormatBboxPoints(List<float> pts)
    {
        var sb = new System.Text.StringBuilder();
        for (int j = 0; j + 1 < pts.Count; j += 2)
        {
            if (j > 0) sb.Append(' ');
            sb.Append(pts[j].ToString("G6",     System.Globalization.CultureInfo.InvariantCulture));
            sb.Append(',');
            sb.Append(pts[j + 1].ToString("G6", System.Globalization.CultureInfo.InvariantCulture));
        }
        return sb.ToString();
    }

    /// <summary>True if the field has any failed validation check (and acceptance has not been set).</summary>
    private static bool BboxIsSuspect(InvoiceDto inv, string fieldName)
    {
        if (inv.IsValidationAccepted || inv.IsEditedByUser) return false;
        if (inv.TesseractConfirmed.TryGetValue(fieldName,  out var t) && !t) return true;
        if (inv.ConfidenceConfirmed.TryGetValue(fieldName, out var c) && !c) return true;
        if (inv.MathConfirmed.TryGetValue(fieldName,       out var m) && !m) return true;
        return false;
    }

    /// <summary>True if a line item has any failed per-field validation check.</summary>
    private static bool ItemIsSuspect(InvoiceDto inv, InvoiceItemDto item)
    {
        if (inv.IsValidationAccepted || inv.IsEditedByUser) return false;
        return item.TesseractConfirmed.Values.Any(v => !v)
            || item.ConfidenceConfirmed.Values.Any(v => !v);
    }

    // ── Cleanup ───────────────────────────────────────────────────────────────

    public ValueTask DisposeAsync()
    {
        State.OnChange -= OnStateChanged;
        return ValueTask.CompletedTask;
    }
}
