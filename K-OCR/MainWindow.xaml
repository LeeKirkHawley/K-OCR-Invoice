<Window x:Class="K_OCR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K-OCR"
        Width="1800"
        Height="800"
        MinWidth="800"
        MinHeight="600">
    <DockPanel>
        <!-- Menu bar at top -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Click="OnOpenClick"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy"/>
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- Main content area -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top content row fixed at 20px -->
                <RowDefinition Height="20"/>
                <!-- Bottom panel fills remaining space -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top content (20px tall) -->
            <TextBlock Grid.Row="0"
                       Text="Welcome to K-OCR"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Bottom panel: two panes with a vertical splitter centered -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Padding="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image Name="ImagePanel"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              Background="#FFE0E0E0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True"/>

                <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" Padding="8">
                    <RichTextBox Name="OCRdTextPanel" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>