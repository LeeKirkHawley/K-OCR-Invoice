<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>K_OCR</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Correct native output directory -->
  <PropertyGroup>
    <NativeOutputDir>..\K-OCRLib\x64\$(Configuration)</NativeOutputDir>
  </PropertyGroup>

  <!-- Clean stale native files -->
  <Target Name="CleanOldNativeOutputs" BeforeTargets="Build">
    <ItemGroup>
      <OldNative Include="$(TargetDir)K-OCRLib.dll" Condition="Exists('$(TargetDir)K-OCRLib.dll')" />
      <OldNative Include="$(TargetDir)K-OCRLib.pdb" Condition="Exists('$(TargetDir)K-OCRLib.pdb')" />
    </ItemGroup>
    <Delete Files="@(OldNative)" Condition="@(OldNative) != ''" />
  </Target>

