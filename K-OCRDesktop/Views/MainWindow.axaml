<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:K_OCRDesktop.ViewModels"
        xmlns:converters="using:K_OCRDesktop.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="800"
        x:Class="K_OCRDesktop.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="K-OCR Desktop"
        Width="1800"
        Height="800"
        MinWidth="800"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:ValidatedStatusToColorConverter x:Key="ValidatedStatusToColorConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:ValidationTextColorConverter x:Key="ValidationTextColorConverter"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Custom TextBox style for Validation tab - yellow background like image highlight -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#50FFFF00"/>
            <Setter Property="BorderBrush" Value="#FFFFA500"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <!-- Light selection highlight so text is readable -->
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="#60ADD8E6"/>
            <Setter Property="SelectionForegroundBrush" Value="Black"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Menu bar at top -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Batch Process..." Click="OnBatchProcess"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="_Docx" Command="{Binding ExportDocxCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings" Click="OnSettings"/>
                <Separator/>
                <MenuItem Header="_Clear All Data..." Click="OnClearAllData"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Main content area -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top content row fixed at 20px -->
                <RowDefinition Height="20"/>
                <!-- Current directory row -->
                <RowDefinition Height="Auto"/>
                <!-- Bottom panel fills remaining space -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top content (20px tall) -->
            <TextBlock Grid.Row="0"
                       Text="{Binding FileCaption}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
            
            <!-- Current Directory Display -->
            <Border Grid.Row="1"
                    BorderBrush="LightGray"
                    BorderThickness="0,0,0,1"
                    Padding="10,5"
                    Background="#F9F9F9">
                <TextBlock FontSize="11">
                    <Run Text="Current Directory: " FontWeight="SemiBold"/>
                    <Run Text="{Binding CurrentDirectory}" />
                </TextBlock>
            </Border>

            <!-- Bottom panel: three panes with vertical splitters -->
            <Grid Grid.Row="2" x:Name="MainContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- File browser panel (leftmost) -->
                <Border Grid.Column="0" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Folder selection button -->
                        <Button Grid.Row="0" 
                                Content="📁 Select Folder" 
                                Click="SelectFolderButton_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,5"/>
                        
                        <!-- File list -->
                        <ListBox Grid.Row="1"
                                Name="FileListBox"
                                ItemsSource="{Binding ImageFiles}"
                                SelectedItem="{Binding SelectedImageFile}"
                                Background="White">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="OCR Now"
                                              Command="{Binding DataContext.OcrNowCommand, ElementName=RootWindow}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- Status indicator circle (Processed) -->
                                        <Ellipse Width="10" Height="10" 
                                                VerticalAlignment="Center"
                                                Fill="{Binding IsProcessed, Converter={StaticResource BoolToColorConverter}}">
                                            <ToolTip.Tip>
                                                <TextBlock Text="Processed" IsVisible="{Binding IsProcessed}"/>
                                            </ToolTip.Tip>
                                        </Ellipse>
                                        <!-- Status indicator circle (Validated) -->
                                        <Ellipse Width="10" Height="10" 
                                                VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <MultiBinding Converter="{StaticResource ValidatedStatusToColorConverter}">
                                                    <Binding Path="IsValidated"/>
                                                    <Binding Path="HasSuspectFields"/>
                                                </MultiBinding>
                                            </Ellipse.Fill>
                                            <ToolTip.Tip>
                                                <TextBlock Text="Validated" IsVisible="{Binding IsValidated}"/>
                                            </ToolTip.Tip>
                                        </Ellipse>
                                        <!-- File name -->
                                        <TextBlock Text="{Binding FileName}" 
                                                  TextWrapping="NoWrap"
                                                  ToolTip.Tip="{Binding FileName}"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Splitter between file list and image -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              Background="#FFE0E0E0"
                              ResizeDirection="Columns"/>

                <!-- Center panel: Original image with zoom controls -->
                <Border Grid.Column="2" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Zoom controls toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <Button Content="🔍+" Width="40" Height="30" Margin="2" 
                                    Command="{Binding ZoomInCommand}"
                                    ToolTip.Tip="Zoom In (Ctrl++)"/>
                            <Button Content="🔍−" Width="40" Height="30" Margin="2" 
                                    Command="{Binding ZoomOutCommand}"
                                    ToolTip.Tip="Zoom Out (Ctrl+-)"/>
                            <Button Content="⬜" Width="40" Height="30" Margin="2" 
                                    Command="{Binding ZoomFitCommand}"
                                    ToolTip.Tip="Fit to Window (Ctrl+0)"/>
                            <TextBlock Text="{Binding ImageZoom, StringFormat={}{0:P0}}" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0,0,0"
                                      FontWeight="Bold"/>
                        </StackPanel>
                        
                        <!-- Image display area -->
                        <ScrollViewer Grid.Row="1"
                                     HorizontalScrollBarVisibility="Auto" 
                                     VerticalScrollBarVisibility="Auto"
                                     Name="ImageScrollViewer">
                            <Grid>
                                <!-- Image -->
                                <Image Source="{Binding OriginalImageSource}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       RenderTransformOrigin="0,0"
                                       Name="DisplayImage"
                                       PointerPressed="OnImageClick">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ImageZoom}" 
                                                       ScaleY="{Binding ImageZoom}"/>
                                    </Image.RenderTransform>
                                </Image>
                                
                                <!-- Overlay Canvas for highlighting bounding boxes -->
                                <Canvas Name="HighlightCanvas"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Width="{Binding CanvasWidth}"
                                       Height="{Binding CanvasHeight}"
                                       RenderTransformOrigin="0,0"
                                       IsHitTestVisible="False"
                                       PointerPressed="OnImageClick">
                                    <Canvas.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ImageZoom}" 
                                                       ScaleY="{Binding ImageZoom}"/>
                                    </Canvas.RenderTransform>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Splitter between image and JSON -->
                <GridSplitter Grid.Column="3"
                              Width="6"
                              Background="#FFE0E0E0"
                              ResizeDirection="Columns"/>

                <!-- Right panel: Tabbed view with Validation and OCR tabs -->
                <Border Grid.Column="4" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <TabControl Name="ResultsTabControl" Focusable="True">
                        <!-- Validation Tab (default) -->
                        <TabItem Header="Validation" Name="ValidationTab">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Save Button at top -->
                                <Button Grid.Row="0" 
                                       Content="💾 Save Validated Data" 
                                       HorizontalAlignment="Center"
                                       Margin="10,10,10,5"
                                       Padding="20,8"
                                       FontWeight="Bold"
                                       Click="OnSaveValidatedData"
                                       IsVisible="{Binding DocumentFields.Count}"/>
                                
                                <!-- Dynamic document fields display -->
                                <ScrollViewer Grid.Row="1"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             IsVisible="{Binding DocumentFields.Count}"
                                             Name="ValidationScrollViewer"
                                             Focusable="True">
                                    <StackPanel Margin="10">
                                        <!-- Document Fields -->
                                        <ItemsControl ItemsSource="{Binding DocumentFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="150,*" Margin="0,5">
                                                        <!-- Field Name -->
                                                        <TextBlock Grid.Column="0" 
                                                                  Text="{Binding DisplayName, StringFormat={}{0}:}" 
                                                                  FontWeight="Bold" 
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{Binding IsValidationFailed, Converter={StaticResource ValidationTextColorConverter}}"/>
                                                        
                                                        <!-- Field Value (Editable TextBox) -->
                                                        <TextBox Grid.Column="1" 
                                                                Text="{Binding Value, Mode=TwoWay}" 
                                                                HorizontalAlignment="Stretch"
                                                                Padding="8,5"
                                                                Margin="5,0"
                                                                GotFocus="OnFieldGotFocus"
                                                                KeyDown="OnFieldTextBoxKeyDown"
                                                                Tag="{Binding Name}"
                                                                Foreground="{Binding IsValidationFailed, Converter={StaticResource ValidationTextColorConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Line Items (if present) -->
                                        <Border BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,20,0,0"
                                               IsVisible="{Binding HasLineItems}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LineItemsCount, StringFormat='Line Items: ({0})'}" 
                                                          FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding LineItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5,10" Margin="0,5">
                                                                <Grid ColumnDefinitions="*,100,100,100" RowDefinitions="Auto,Auto,Auto,Auto">
                                                                    <!-- Column Headers (only show for first item) - TODO: implement proper header -->
                                                                    
                                                                    <!-- Description -->
                                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                                        <TextBlock Text="Description:" FontWeight="SemiBold" FontSize="11"/>
                                                                        <TextBox Text="{Binding Description, Mode=TwoWay}" 
                                                                                TextWrapping="Wrap"
                                                                                GotFocus="OnLineItemGotFocus"
                                                                                KeyDown="OnFieldTextBoxKeyDown"/>
                                                                    </StackPanel>
                                                                    
                                                                    <!-- Quantity -->
                                                                    <StackPanel Grid.Column="1" Spacing="3" Margin="5,0">
                                                                        <TextBlock Text="Quantity:" FontWeight="SemiBold" FontSize="11"/>
                                                                        <TextBox Text="{Binding Quantity, Mode=TwoWay}" 
                                                                                TextAlignment="Right"
                                                                                GotFocus="OnLineItemGotFocus"
                                                                                KeyDown="OnFieldTextBoxKeyDown"/>
                                                                    </StackPanel>
                                                                    
                                                                    <!-- Unit Price -->
                                                                    <StackPanel Grid.Column="2" Spacing="3" Margin="5,0">
                                                                        <TextBlock Text="Unit Price:" FontWeight="SemiBold" FontSize="11"/>
                                                                        <TextBox Text="{Binding UnitPrice, Mode=TwoWay, StringFormat={}{0:F2}}" 
                                                                                TextAlignment="Right"
                                                                                GotFocus="OnLineItemGotFocus"
                                                                                KeyDown="OnFieldTextBoxKeyDown"/>
                                                                    </StackPanel>
                                                                    
                                                                    <!-- Line Total (Read-only) -->
                                                                    <StackPanel Grid.Column="3" Spacing="3" Margin="5,0">
                                                                        <TextBlock Text="Line Total:" FontWeight="SemiBold" FontSize="11"/>
                                                                        <TextBox Text="{Binding LineTotal, StringFormat={}{0:C}, Mode=OneWay}" 
                                                                                TextAlignment="Right"
                                                                                FontWeight="Bold"
                                                                                IsReadOnly="True"
                                                                                Background="#F0F0F0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <!-- Show message when no document data -->
                                <TextBlock Text="No document data available"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="Gray"
                                          FontSize="14">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="DocumentFields.Count" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="0"/>
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                            </Grid>
                        </TabItem>
                        
                        <!-- OCR Tab (JSON output) -->
                        <TabItem Header="OCR">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Radio buttons for OCR text selection -->
                                <StackPanel Grid.Row="0" 
                                           Orientation="Horizontal" 
                                           Margin="0,0,0,10"
                                           Spacing="20">
                                    <RadioButton Content="Original OCR" 
                                                IsChecked="{Binding ShowOriginalOcr}"
                                                GroupName="OcrTextType"/>
                                    <RadioButton Content="Validated OCR" 
                                                IsChecked="{Binding !ShowOriginalOcr}"
                                                GroupName="OcrTextType"/>
                                </StackPanel>
                                
                                <!-- OCR text display -->
                                <ScrollViewer Grid.Row="1" 
                                             HorizontalScrollBarVisibility="Auto" 
                                             VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding OcrJsonText}"
                                            IsReadOnly="True"
                                            FontFamily="Courier New"
                                            FontSize="12"
                                            TextWrapping="NoWrap"
                                            AcceptsReturn="True"
                                            Background="#F5F5F5"/>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
