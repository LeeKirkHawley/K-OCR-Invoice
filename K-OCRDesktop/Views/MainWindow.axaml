<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:K_OCRDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="800"
        x:Class="K_OCRDesktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="K-OCR Desktop"
        Width="1800"
        Height="800"
        MinWidth="800"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Menu bar at top -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="_Docx" Command="{Binding ExportDocxCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Main content area -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top content row fixed at 20px -->
                <RowDefinition Height="20"/>
                <!-- Bottom panel fills remaining space -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top content (20px tall) -->
            <TextBlock Grid.Row="0"
                       Text="{Binding FileCaption}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>

            <!-- Bottom panel: three panes with vertical splitters -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- File browser panel (leftmost) -->
                <Border Grid.Column="0" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Folder selection button -->
                        <Button Grid.Row="0" 
                                Content="📁 Select Folder" 
                                Command="{Binding SelectFolderCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,5"/>
                        
                        <!-- File list -->
                        <ListBox Grid.Row="1"
                                Name="FileListBox"
                                ItemsSource="{Binding ImageFiles}"
                                SelectedItem="{Binding SelectedImageFile}"
                                Background="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                              TextWrapping="NoWrap"
                                              ToolTip.Tip="{Binding}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Splitter between file list and image -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              Background="#FFE0E0E0"
                              ResizeDirection="Columns"/>

                <!-- Center panel: Original image with zoom controls -->
                <Border Grid.Column="2" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Zoom controls toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <Button Content="🔍+" Width="40" Height="30" Margin="2" 
                                    Command="{Binding ZoomInCommand}"
                                    ToolTip.Tip="Zoom In (Ctrl++)"/>
                            <Button Content="🔍−" Width="40" Height="30" Margin="2" 
                                    Command="{Binding ZoomOutCommand}"
                                    ToolTip.Tip="Zoom Out (Ctrl+-)"/>
                            <Button Content="⬜" Width="40" Height="30" Margin="2" 
                                    Command="{Binding ZoomFitCommand}"
                                    ToolTip.Tip="Fit to Window (Ctrl+0)"/>
                            <TextBlock Text="{Binding ImageZoom, StringFormat={}{0:P0}}" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0,0,0"
                                      FontWeight="Bold"/>
                        </StackPanel>
                        
                        <!-- Image display area -->
                        <ScrollViewer Grid.Row="1"
                                     HorizontalScrollBarVisibility="Auto" 
                                     VerticalScrollBarVisibility="Auto"
                                     Name="ImageScrollViewer">
                            <Grid>
                                <!-- Image -->
                                <Image Source="{Binding OriginalImageSource}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       RenderTransformOrigin="0,0"
                                       Name="DisplayImage">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ImageZoom}" 
                                                       ScaleY="{Binding ImageZoom}"/>
                                    </Image.RenderTransform>
                                </Image>
                                
                                <!-- Overlay Canvas for highlighting bounding boxes -->
                                <Canvas Name="HighlightCanvas"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Width="{Binding CanvasWidth}"
                                       Height="{Binding CanvasHeight}"
                                       RenderTransformOrigin="0,0"
                                       IsHitTestVisible="False">
                                    <Canvas.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding ImageZoom}" 
                                                       ScaleY="{Binding ImageZoom}"/>
                                    </Canvas.RenderTransform>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Splitter between image and JSON -->
                <GridSplitter Grid.Column="3"
                              Width="6"
                              Background="#FFE0E0E0"
                              ResizeDirection="Columns"/>

                <!-- Right panel: Tabbed view with Validation and OCR tabs -->
                <Border Grid.Column="4" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <TabControl>
                        <!-- Validation Tab (default) -->
                        <TabItem Header="Validation">
                            <Grid>
                                <!-- Dynamic document fields display -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             IsVisible="{Binding DocumentFields.Count}">
                                    <StackPanel Margin="10">
                                        <!-- Document Fields -->
                                        <ItemsControl ItemsSource="{Binding DocumentFields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="150,*" Margin="0,5">
                                                        <!-- Field Name -->
                                                        <TextBlock Grid.Column="0" 
                                                                  Text="{Binding DisplayName, StringFormat={}{0}:}" 
                                                                  FontWeight="Bold" 
                                                                  VerticalAlignment="Center"/>
                                                        
                                                        <!-- Field Value (Clickable) -->
                                                        <Button Grid.Column="1" 
                                                               HorizontalAlignment="Stretch" 
                                                               HorizontalContentAlignment="Left"
                                                               Background="Transparent" 
                                                               BorderThickness="0" 
                                                               Padding="10,5"
                                                               Click="OnFieldClicked"
                                                               Tag="{Binding Name}">
                                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        
                                        <!-- Line Items (if present) -->
                                        <Border BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,20,0,0"
                                               IsVisible="{Binding CurrentInvoice.Items.Count}">
                                            <StackPanel>
                                                <TextBlock Text="Line Items:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding CurrentInvoice.Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                   Background="Transparent" BorderThickness="0" Padding="5"
                                                                   Click="OnLineItemClicked">
                                                                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1">
                                                                    <Grid ColumnDefinitions="*,100,100,100">
                                                                        <TextBlock Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" TextAlignment="Right" Margin="5,0"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:C}}" TextAlignment="Right" Margin="5,0"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}{0:C}}" TextAlignment="Right" Margin="5,0" FontWeight="Bold"/>
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <!-- Show message when no document data -->
                                <TextBlock Text="No document data available"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="Gray"
                                          FontSize="14">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="DocumentFields.Count" Converter="{x:Static ObjectConverters.Equal}" ConverterParameter="0"/>
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                            </Grid>
                        </TabItem>
                        
                        <!-- OCR Tab (JSON output) -->
                        <TabItem Header="OCR">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                         VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding OcrJsonText}"
                                        IsReadOnly="True"
                                        FontFamily="Courier New"
                                        FontSize="12"
                                        TextWrapping="NoWrap"
                                        AcceptsReturn="True"
                                        Background="#F5F5F5"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
