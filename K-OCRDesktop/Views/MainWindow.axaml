<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:K_OCRDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="800"
        x:Class="K_OCRDesktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="K-OCR Desktop"
        Width="1800"
        Height="800"
        MinWidth="800"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Menu bar at top -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="_Docx" Command="{Binding ExportDocxCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Main content area -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top content row fixed at 20px -->
                <RowDefinition Height="20"/>
                <!-- Bottom panel fills remaining space -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top content (20px tall) -->
            <TextBlock Grid.Row="0"
                       Text="{Binding FileCaption}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>

            <!-- Bottom panel: two panes with a vertical splitter -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel: Original image -->
                <Border Grid.Column="0" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto">
                        <Image Source="{Binding OriginalImageSource}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              Background="#FFE0E0E0"
                              ResizeDirection="Columns"/>

                <!-- Right panel: OCR JSON result -->
                <Border Grid.Column="2" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding OcrJsonText}"
                                 IsReadOnly="True"
                                 FontFamily="Courier New"
                                 FontSize="12"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 Background="#F5F5F5"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
