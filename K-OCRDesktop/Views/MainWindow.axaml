<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:K_OCRDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="800"
        x:Class="K_OCRDesktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="K-OCR Desktop"
        Width="1800"
        Height="800"
        MinWidth="800"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Menu bar at top -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem Header="_Docx" Command="{Binding ExportDocxCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Main content area -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Top content row fixed at 20px -->
                <RowDefinition Height="20"/>
                <!-- Bottom panel fills remaining space -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top content (20px tall) -->
            <TextBlock Grid.Row="0"
                       Text="{Binding FileCaption}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>

            <!-- Bottom panel: three panes with vertical splitters -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- File browser panel (leftmost) -->
                <Border Grid.Column="0" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Folder selection button -->
                        <Button Grid.Row="0" 
                                Content="📁 Select Folder" 
                                Command="{Binding SelectFolderCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,5"/>
                        
                        <!-- File list -->
                        <ListBox Grid.Row="1"
                                Name="FileListBox"
                                ItemsSource="{Binding ImageFiles}"
                                SelectedItem="{Binding SelectedImageFile}"
                                Background="White">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                              TextWrapping="NoWrap"
                                              ToolTip.Tip="{Binding}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Splitter between file list and image -->
                <GridSplitter Grid.Column="1"
                              Width="6"
                              Background="#FFE0E0E0"
                              ResizeDirection="Columns"/>

                <!-- Center panel: Original image with zoom controls -->
                <Border Grid.Column="2" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Zoom controls toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <Button Content="🔍+" Width="40" Height="30" Margin="2" 
                                    Command="{Binding ZoomInCommand}"
                                    ToolTip.Tip="Zoom In (Ctrl++)"/>
                            <Button Content="🔍−" Width="40" Height="30" Margin="2" 
                                    Command="{Binding ZoomOutCommand}"
                                    ToolTip.Tip="Zoom Out (Ctrl+-)"/>
                            <Button Content="⬜" Width="40" Height="30" Margin="2" 
                                    Command="{Binding ZoomFitCommand}"
                                    ToolTip.Tip="Fit to Window (Ctrl+0)"/>
                            <TextBlock Text="{Binding ImageZoom, StringFormat={}{0:P0}}" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0,0,0"
                                      FontWeight="Bold"/>
                        </StackPanel>
                        
                        <!-- Image display area -->
                        <ScrollViewer Grid.Row="1"
                                     HorizontalScrollBarVisibility="Auto" 
                                     VerticalScrollBarVisibility="Auto"
                                     Name="ImageScrollViewer">
                            <Image Source="{Binding OriginalImageSource}"
                                   Stretch="None"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   RenderTransformOrigin="0,0">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding ImageZoom}" 
                                                   ScaleY="{Binding ImageZoom}"/>
                                </Image.RenderTransform>
                            </Image>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Splitter between image and JSON -->
                <GridSplitter Grid.Column="3"
                              Width="6"
                              Background="#FFE0E0E0"
                              ResizeDirection="Columns"/>

                <!-- Right panel: OCR JSON result -->
                <Border Grid.Column="4" 
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding OcrJsonText}"
                                 IsReadOnly="True"
                                 FontFamily="Courier New"
                                 FontSize="12"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 Background="#F5F5F5"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
