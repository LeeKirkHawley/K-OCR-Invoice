<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="250"
        x:Class="K_OCRDesktop.Views.SettingsDialog"
        Title="Settings"
        Width="600"
        Height="250"
        MinWidth="500"
        MinHeight="200"
        CanResize="true"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Application Settings"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Default Start Directory -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Default Start Directory:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,5"/>

            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                     Name="DirectoryTextBox"
                     Watermark="Select a default directory..."
                     Margin="0,0,10,0"/>

            <Button Grid.Row="1" Grid.Column="2"
                    Content="Browse..."
                    Click="OnBrowseDirectory"
                    Width="100"/>

            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="Max Concurrent Azure Requests:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,5"/>

            <NumericUpDown Grid.Row="4" Grid.Column="0"
                           Name="MaxConcurrentTextBox"
                           Minimum="1"
                           Maximum="10"
                           Value="3"
                           Increment="1"
                           Width="200"
                           HorizontalAlignment="Left"/>
        </Grid>

        <!-- Spacer -->
        <Border Grid.Row="2"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="Save"
                    Click="OnSave"
                    Width="100"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Click="OnCancel"
                    Width="100"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
