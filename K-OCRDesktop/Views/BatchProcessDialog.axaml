<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="K_OCRDesktop.Views.BatchProcessDialog"
        Title="Batch Process Invoices"
        Width="700"
        Height="500"
        MinWidth="600"
        MinHeight="400"
        CanResize="true"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Select invoices to process"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- File selection buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Content="📁 Select Folder" Click="OnSelectFolder" Width="150"/>
            <Button Content="📄 Select Files" Click="OnSelectFiles" Width="150"/>
            <Button Content="Clear All" Click="OnClearAll" Width="100"/>
        </StackPanel>

        <!-- File list -->
        <Border Grid.Row="2" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                Padding="5"
                Margin="0,0,0,10">
            <ListBox Name="FileListBox"
                     SelectionMode="Multiple"
                     SelectionChanged="OnSelectionChanged"
                     Background="White">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                                  TextWrapping="NoWrap"
                                  ToolTip.Tip="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Bottom buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0"
                       Name="FileCountText"
                       Text="0 files selected"
                       VerticalAlignment="Center"
                       FontStyle="Italic"/>
            
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="▶ RUN"
                        Name="RunButton"
                        Click="OnRun"
                        Width="120"
                        IsEnabled="False"
                        FontWeight="Bold"/>
                <Button Content="Cancel"
                        Click="OnCancel"
                        Width="100"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
