{
  "AllowDuplicateEmails": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "BaseUrl": "https://localhost:5001"
  },
  "Kocr": {
    "BaseDirectory": "D:\\KOCRBase"
  },
  "AzureCognitiveServicesKey": null,
  "AzureCognitiveServicesEndpoint": "https://KirksOCRService.cognitiveservices.azure.com/",
  "OCRProvider": "Azure",
  "GuestMaxBatches": 2,
  "Limits": {
    "User": {
      "MaxInvoicesPerBatch": 100,
      "MaxPagesPerInvoice": 20
    },
    "Guest": {
      "MaxBatches": 2,
      "MaxInvoicesPerBatch": 20,
      "MaxPagesPerInvoice": 20
    },
    "Beta": {
      "MaxOcrPages": 500
    }
  },
  "GuestAccountRetentionDays": 1,
  "DeletedOrgRetentionDays": 1,
  "DeletedBatchRetentionDays": 14,
  "DefaultStartFolder": "/media/kirk-hawley/Elements/Datasets",
  "MaxConcurrentRequests": 3,
  "MinConfidenceThreshold": 0.8,
"Email": {
    "SmtpHost": "smtp.fatcow.com",
    "Port": 587,
    "EnableSsl": true,
    "SkipCertificateValidation": true,
    "Username": "kirk@kirkhawley.com",
    "Password": null,
    "FromAddress": "kirk@kirkhawley.com",
    "FromName": "Hardscrabble Invoice"
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=KOCRIdentity;Trusted_Connection=True;TrustServerCertificate=True;",
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": true
  },
  "OcrQueue": {
    "MaxJobsPerWindow": 10,
    "WindowSeconds": 60,
    "MaxConcurrentJobs": 3
  },
  "Bootstrap": {
    "ResetIdentityDatabaseIfMissingMultiOrgMembership": false
  }
}
