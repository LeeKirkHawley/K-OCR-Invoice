@using K_OCR.Configuration
@model AppSettings
@{
    ViewData["Title"] = "Settings";
    ViewData["MetaDescription"] = "Configure OCR, retention, and application settings for Hardscrabble Invoice.";
}

<h1 class="h4 mb-4">Settings</h1>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" asp-action="Save" asp-controller="Settings">
    @Html.AntiForgeryToken()

    <!-- Azure Document Intelligence -->
    <div class="card mb-3">
        <div class="card-header"><strong>Azure Document Intelligence</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="AzureCognitiveServicesEndpoint" class="form-label">Endpoint URL</label>
                    <input asp-for="AzureCognitiveServicesEndpoint" type="url"
                           class="form-control"
                           placeholder="https://your-resource.cognitiveservices.azure.com/" />
                    <div class="form-text">The API key is managed via environment variable <code>AzureCognitiveServicesKey</code>.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- OCR -->
    <div class="card mb-3">
        <div class="card-header"><strong>OCR</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="OCRProvider" class="form-label">Provider</label>
                    <select asp-for="OCRProvider" class="form-select">
                        <option value="Azure">Azure Document Intelligence</option>
                        <option value="Tesseract">Tesseract</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxConcurrentRequests" class="form-label">Max Concurrent Requests</label>
                    <input asp-for="MaxConcurrentRequests" type="number"
                           class="form-control" min="1" max="20" />
                </div>
            </div>
        </div>
    </div>

    <!-- Limits -->
    <div class="card mb-3">
        <div class="card-header"><strong>Limits</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <h6 class="mb-2">Regular Users</h6>
                </div>
                <div class="col-md-4">
                    <label asp-for="Limits.User.MaxInvoicesPerBatch" class="form-label">Max Invoices per Batch</label>
                    <input asp-for="Limits.User.MaxInvoicesPerBatch" type="number"
                           class="form-control" min="1" max="10000" />
                    <div class="form-text">Maximum number of invoices per batch for regular users.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Limits.User.MaxPagesPerInvoice" class="form-label">Max Pages per Invoice</label>
                    <input asp-for="Limits.User.MaxPagesPerInvoice" type="number"
                           class="form-control" min="1" max="1000" />
                    <div class="form-text">Invoices exceeding this page count are grayed out and skipped during OCR.</div>
                </div>
                <div class="col-12 mt-3">
                    <h6 class="mb-2">Guest Users</h6>
                </div>
                <div class="col-md-3">
                    <label asp-for="Limits.Guest.MaxBatches" class="form-label">Max Active Batches</label>
                    <input asp-for="Limits.Guest.MaxBatches" type="number"
                           class="form-control" min="1" max="100" />
                    <div class="form-text">Maximum number of active batches a guest can have.</div>
                </div>
                <div class="col-md-3">
                    <label asp-for="Limits.Guest.MaxInvoicesPerBatch" class="form-label">Max Invoices per Batch</label>
                    <input asp-for="Limits.Guest.MaxInvoicesPerBatch" type="number"
                           class="form-control" min="1" max="10000" />
                    <div class="form-text">Maximum number of invoices per batch for guest users.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="Limits.Guest.MaxPagesPerInvoice" class="form-label">Max Pages per Invoice</label>
                    <input asp-for="Limits.Guest.MaxPagesPerInvoice" type="number"
                           class="form-control" min="1" max="1000" />
                    <div class="form-text">Invoices exceeding this page count are grayed out and skipped during OCR.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Retention -->
    <div class="card mb-3">
        <div class="card-header"><strong>Retention</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="GuestAccountRetentionDays" class="form-label">Guest Account Retention (Days)</label>
                    <input asp-for="GuestAccountRetentionDays" type="number"
                           class="form-control" min="0" />
                    <div class="form-text">Expired guest accounts are revoked and deleted automatically. Set to 0 to disable cleanup.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="DeletedBatchRetentionDays" class="form-label">Batch Retention (Days)</label>
                    <input asp-for="DeletedBatchRetentionDays" type="number"
                           class="form-control" min="1" />
                    <div class="form-text">Soft-deleted batches are permanently removed after this many days.</div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="SoftDeleteBatchOnExport" type="checkbox" class="form-check-input" />
                        <label asp-for="SoftDeleteBatchOnExport" class="form-check-label">Soft-delete batch after export</label>
                    </div>
                    <div class="form-text">When enabled, a batch is automatically soft-deleted after a successful JSON or Excel export.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Paths -->
    <div class="card mb-3">
        <div class="card-header"><strong>Paths</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DefaultStartFolder" class="form-label">Base Directory</label>
                    <input asp-for="DefaultStartFolder" type="text"
                           class="form-control" readonly />
                    <div class="form-text">Configured at startup; changes require restart.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics -->
    <div class="card mb-3">
        <div class="card-header"><strong>Analytics</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="GoogleAnalyticsMeasurementId" class="form-label">Google Analytics Measurement ID</label>
                    <input asp-for="GoogleAnalyticsMeasurementId" type="text"
                           class="form-control" placeholder="G-XXXXXXXXXX" />
                    <div class="form-text">Enables GA4 on public and authenticated pages when set.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="SearchConsoleVerificationToken" class="form-label">Search Console Verification Token</label>
                    <input asp-for="SearchConsoleVerificationToken" type="text"
                           class="form-control" placeholder="google-site-verification token" />
                    <div class="form-text">Adds the Google site verification meta tag when set.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save Settings</button>
        <a asp-controller="EmailConfig" asp-action="Index" class="btn btn-outline-secondary">📧 Email Config</a>
    </div>
</form>
