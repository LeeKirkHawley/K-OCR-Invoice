@using K_OCR.Configuration
@using K_OCR.Models.Api.SuperAdmin
@using K_OCR.Security
@model OrgConfig
@{
    ViewData["Title"] = "Organization Configuration";
    var allOrgs       = ViewBag.AllOrgs as OrganizationOverview[];
    var selectedOrgId = ViewBag.SelectedOrgId as string;
    var orgName       = ViewBag.OrgName as string;
    bool isSuperAdmin = User.IsInRole(RoleNames.SuperAdmin);
}

<h4 class="mb-4">Organization Configuration</h4>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Org selector for SuperAdmin — changing org reloads the page *@
@if (isSuperAdmin && allOrgs is { Length: > 0 })
{
    <div class="card mb-3">
        <div class="card-header"><strong>Organization</strong></div>
        <div class="card-body">
            <form method="get" asp-action="Index" asp-controller="OrgConfig" class="d-flex align-items-center gap-3">
                <label class="form-label mb-0 text-nowrap">Select Organization:</label>
                <select name="orgId" class="form-select w-auto" onchange="this.form.submit()">
                    @foreach (var org in allOrgs)
                    {
                        <option value="@org.OrganizationId"
                                selected="@(org.OrganizationId == selectedOrgId ? "selected" : null)">
                            @org.Name
                        </option>
                    }
                </select>
            </form>
        </div>
    </div>
}
else if (!isSuperAdmin)
{
    <p class="text-muted small mb-3">Configuring: <strong>@orgName</strong></p>
}

@* Pass selected orgId to JS *@
<span id="selectedOrgId" data-value="@selectedOrgId" style="display:none"></span>

<!-- ── Manage Users ───────────────────────────────────────────────────────── -->
<div class="card mb-4">
    <div class="card-header"><strong>Invite User</strong></div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-sm-4">
                <input type="text" id="inviteName" class="form-control" placeholder="Full name" maxlength="200" />
            </div>
            <div class="col-sm-4">
                <input type="email" id="inviteEmail" class="form-control" placeholder="Email address" />
            </div>
            <div class="col-sm-3">
                <select id="inviteRole" class="form-select">
                    <option value="OrganizationUser">User</option>
                    <option value="OrganizationValidator">Validator</option>
                    <option value="OrganizationAdmin">Admin</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" id="inviteBtn" onclick="inviteUser()">Invite</button>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Current Users</strong>
        <button class="btn btn-sm btn-outline-secondary" onclick="loadUsers()">🔄 Refresh</button>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">Loading…</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Setup link modal -->
<div class="modal fade" id="setupLinkModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">User Setup Link</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Email was not sent. Share this setup link with the user:</p>
                <input type="text" id="setupLinkInput" class="form-control mb-2" readonly />
                <button class="btn btn-sm btn-outline-secondary" onclick="copySetupLink()">Copy</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Configuration ──────────────────────────────────────────────────────── -->
<form method="post" asp-action="Save" asp-controller="OrgConfig">
    @Html.AntiForgeryToken()
    @if (selectedOrgId is not null)
    {
        <input type="hidden" name="orgId" value="@selectedOrgId" />
    }

    <!-- Validation -->
    <div class="card mb-3">
        <div class="card-header"><strong>Validation</strong></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <label asp-for="MinConfidenceThreshold" class="form-label">
                        Min Confidence Threshold:
                        <span id="confidenceLabel">@Model.MinConfidenceThreshold.ToString("F2")</span>
                    </label>
                    <input asp-for="MinConfidenceThreshold" type="range"
                           class="form-range" min="0" max="1" step="0.01"
                           oninput="document.getElementById('confidenceLabel').textContent =
                                    parseFloat(this.value).toFixed(2);" />
                    <div class="d-flex justify-content-between small text-muted">
                        <span>0.00 (low)</span><span>1.00 (strict)</span>
                    </div>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="RequireBatchValidationForExport" class="form-check-input" type="checkbox" />
                        <label asp-for="RequireBatchValidationForExport" class="form-check-label">
                            Require all invoices to be validated before export
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
<script>
    const ROLE_LABELS = {
        OrganizationAdmin: 'Admin',
        OrganizationValidator: 'Validator',
        OrganizationUser: 'User',
        SuperAdmin: 'Super Admin'
    };

    // orgId appended as query param so SuperAdmin requests are scoped to the right org
    function orgParam() {
        const val = document.getElementById('selectedOrgId')?.dataset.value;
        return val ? '?orgId=' + encodeURIComponent(val) : '';
    }

    document.addEventListener('DOMContentLoaded', loadUsers);

    async function loadUsers() {
        try {
            const resp = await fetch('/orgconfig/getusers' + orgParam());
            const users = await resp.json();
            renderUsers(users);
        } catch (err) {
            showToast('Failed to load users: ' + err.message, 'error');
        }
    }

    function renderUsers(users) {
        const tbody = document.getElementById('usersTableBody');
        if (!users || users.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No users.</td></tr>';
            return;
        }

        let html = '';
        for (const u of users) {
            const primaryRole = u.roles?.[0] ?? 'OrganizationUser';
            html += `<tr id="user-row-${escapeHtml(u.userId)}">
                <td>${escapeHtml(u.fullName ?? '—')}</td>
                <td>${escapeHtml(u.email ?? '—')}</td>
                <td>
                    <select class="form-select form-select-sm" style="width:auto;"
                            onchange="changeRole('${escapeHtml(u.userId)}', this.value)">
                        <option value="OrganizationUser"      ${primaryRole === 'OrganizationUser'      ? 'selected' : ''}>User</option>
                        <option value="OrganizationValidator" ${primaryRole === 'OrganizationValidator' ? 'selected' : ''}>Validator</option>
                        <option value="OrganizationAdmin"     ${primaryRole === 'OrganizationAdmin'     ? 'selected' : ''}>Admin</option>
                    </select>
                </td>
                <td>${u.isActive ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>'}</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-danger"
                            onclick="removeUser('${escapeHtml(u.userId)}', this)">Remove</button>
                </td>
            </tr>`;
        }
        tbody.innerHTML = html;
    }

    async function inviteUser() {
        const name  = document.getElementById('inviteName').value.trim();
        const email = document.getElementById('inviteEmail').value.trim();
        const role  = document.getElementById('inviteRole').value;

        if (!name || !email) {
            showToast('Name and email are required.', 'warning');
            return;
        }

        const btn = document.getElementById('inviteBtn');
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/orgconfig/inviteuser' + orgParam(), { name, email, role });
            if (result.success) {
                showToast('User invited.');
                if (result.setupLink && !result.emailSent) {
                    document.getElementById('setupLinkInput').value = result.setupLink;
                    new bootstrap.Modal(document.getElementById('setupLinkModal')).show();
                }
                document.getElementById('inviteName').value = '';
                document.getElementById('inviteEmail').value = '';
                await loadUsers();
            } else {
                showToast(result.error ?? 'Invite failed.', 'error');
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        } finally {
            setButtonLoading(btn, false);
        }
    }

    async function removeUser(userId, btn) {
        if (!confirm('Remove this user from the organization?')) return;
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/orgconfig/removeuser' + orgParam(), { userId });
            if (result.success) {
                document.getElementById('user-row-' + userId)?.remove();
                showToast('User removed.');
            } else {
                showToast(result.error ?? 'Remove failed.', 'error');
                setButtonLoading(btn, false);
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
            setButtonLoading(btn, false);
        }
    }

    async function changeRole(userId, newRole) {
        try {
            const result = await postJson('/orgconfig/changerole' + orgParam(), { userId, newRole });
            if (result.success) {
                showToast('Role updated.');
            } else {
                showToast(result.error ?? 'Role change failed.', 'error');
                await loadUsers();
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        }
    }

    function copySetupLink() {
        const input = document.getElementById('setupLinkInput');
        input.select();
        navigator.clipboard.writeText(input.value).then(() => showToast('Copied!'));
    }
</script>
}
