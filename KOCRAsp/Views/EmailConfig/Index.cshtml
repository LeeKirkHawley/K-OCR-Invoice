@using K_OCR.Configuration
@model EmailSettings
@{
    ViewData["Title"] = "Email Configuration";
}

<h4 class="mb-4">Email Configuration</h4>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- SMTP settings form -->
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><strong>SMTP Settings</strong></div>
            <div class="card-body">
                <form method="post" asp-action="Save" asp-controller="EmailConfig">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="SmtpHost" class="form-label">SMTP Host</label>
                            <input asp-for="SmtpHost" type="text" class="form-control"
                                   placeholder="smtp.example.com" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Port" class="form-label">Port</label>
                            <input asp-for="Port" type="number" class="form-control"
                                   min="1" max="65535" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label">Username</label>
                            <input asp-for="Username" type="text" class="form-control"
                                   autocomplete="username" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control"
                                   autocomplete="new-password"
                                   placeholder="@(Model?.Password != null ? "(unchanged)" : "Enter password")" />
                            @if (Model?.Password != null)
                            {
                                <div class="form-text">Leave blank to keep the current password.</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FromAddress" class="form-label">From Address</label>
                            <input asp-for="FromAddress" type="email" class="form-control"
                                   placeholder="noreply@example.com" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FromName" class="form-label">From Name</label>
                            <input asp-for="FromName" type="text" class="form-control"
                                   placeholder="K-OCR" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-2">
                                <input asp-for="EnableSsl" class="form-check-input" type="checkbox" />
                                <label asp-for="EnableSsl" class="form-check-label">Enable SSL/TLS</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-2">
                                <input asp-for="SkipCertificateValidation" class="form-check-input" type="checkbox" />
                                <label asp-for="SkipCertificateValidation" class="form-check-label">
                                    Skip Certificate Validation
                                </label>
                                <div class="form-text">Use only with trusted hosts that have mismatched certificates.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Test email -->
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><strong>Send Test Email</strong></div>
            <div class="card-body">
                <p class="text-muted small">
                    Send a test message to verify your SMTP configuration is working.
                    Make sure to save your settings first.
                </p>
                <div class="input-group">
                    <input type="email" id="testEmailInput" class="form-control"
                           placeholder="recipient@example.com" />
                    <button class="btn btn-outline-secondary" id="sendTestBtn"
                            onclick="sendTestEmail()">Send Test</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function sendTestEmail() {
        const toEmail = document.getElementById('testEmailInput').value.trim();
        if (!toEmail) {
            showToast('Enter a recipient email.', 'warning');
            return;
        }

        const btn = document.getElementById('sendTestBtn');
        setButtonLoading(btn, true);
        try {
            const fd = new FormData();
            fd.append('toEmail', toEmail);
            const result = await postForm('/emailconfig/sendtest', fd);
            if (result.success) {
                showToast('Test email sent successfully.');
            } else {
                showToast(result.error ?? 'Send failed.', 'error');
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        } finally {
            setButtonLoading(btn, false);
        }
    }
</script>
}
