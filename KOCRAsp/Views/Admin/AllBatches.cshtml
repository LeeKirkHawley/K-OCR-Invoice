@model KOCRAsp.Models.AdminAllBatchesViewModel
@{
    ViewData["Title"] = "All Batches";
    ViewData["MetaDescription"] = "All organization batches with paging.";
    var orgNextDir = Model.Sort == "org" && Model.Dir == "asc" ? "desc" : "asc";
    var nameNextDir = Model.Sort == "name" && Model.Dir == "asc" ? "desc" : "asc";
    var filesNextDir = Model.Sort == "files" && Model.Dir == "asc" ? "desc" : "asc";
    var validatedNextDir = Model.Sort == "validated" && Model.Dir == "asc" ? "desc" : "asc";
    var statusNextDir = Model.Sort == "status" && Model.Dir == "asc" ? "desc" : "asc";
    var createdNextDir = Model.Sort == "created" && Model.Dir == "asc" ? "desc" : "asc";
    var orgArrow = Model.Sort == "org" ? (Model.Dir == "asc" ? "↑" : "↓") : "\u00A0";
    var nameArrow = Model.Sort == "name" ? (Model.Dir == "asc" ? "↑" : "↓") : "\u00A0";
    var filesArrow = Model.Sort == "files" ? (Model.Dir == "asc" ? "↑" : "↓") : "\u00A0";
    var validatedArrow = Model.Sort == "validated" ? (Model.Dir == "asc" ? "↑" : "↓") : "\u00A0";
    var statusArrow = Model.Sort == "status" ? (Model.Dir == "asc" ? "↑" : "↓") : "\u00A0";
    var createdArrow = Model.Sort == "created" ? (Model.Dir == "asc" ? "↑" : "↓") : "\u00A0";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">All Batches</h1>
    <a class="btn btn-outline-secondary btn-sm" href="/admin">Back to Admin Console</a>
</div>

<div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center py-2">
        <div class="small text-muted">
            Showing page @Model.CurrentPage of @Model.TotalPages (@Model.TotalCount total batches)
        </div>
        <form method="get" action="/admin/allbatches" class="d-flex align-items-center gap-2">
            <input type="hidden" name="sort" value="@Model.Sort" />
            <input type="hidden" name="dir" value="@Model.Dir" />
            <label for="orgId" class="small text-muted mb-0">Org Filter</label>
            <select id="orgId" name="orgId" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                @if (string.IsNullOrWhiteSpace(Model.SelectedOrgId))
                {
                    <option value="" selected>&lt;None&gt;</option>
                }
                else
                {
                    <option value="">&lt;None&gt;</option>
                }
                @foreach (var org in Model.OrgOptions)
                {
                    if (string.Equals(org.Id, Model.SelectedOrgId, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@org.Id" selected>@org.Name</option>
                    }
                    else
                    {
                        <option value="@org.Id">@org.Name</option>
                    }
                }
            </select>
            <label for="pageSize" class="small text-muted mb-0">Page size</label>
            <select id="pageSize" name="pageSize" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                @foreach (var size in new[] { 25, 50, 100, 200 })
                {
                    if (size == Model.PageSize)
                    {
                        <option value="@size" selected>@size</option>
                    }
                    else
                    {
                        <option value="@size">@size</option>
                    }
                }
            </select>
            <input type="hidden" name="page" value="1" />
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        <a class="link-dark text-decoration-none" href="/admin/allbatches?page=1&pageSize=@Model.PageSize&sort=org&dir=@orgNextDir&orgId=@Model.SelectedOrgId">
                            Org
                            <span class="ms-1 text-muted d-inline-block text-center" style="width:1em">@orgArrow</span>
                        </a>
                    </th>
                    <th>#</th>
                    <th>
                        <a class="link-dark text-decoration-none" href="/admin/allbatches?page=1&pageSize=@Model.PageSize&sort=name&dir=@nameNextDir&orgId=@Model.SelectedOrgId">
                            Name
                            <span class="ms-1 text-muted d-inline-block text-center" style="width:1em">@nameArrow</span>
                        </a>
                    </th>
                    <th>
                        <a class="link-dark text-decoration-none" href="/admin/allbatches?page=1&pageSize=@Model.PageSize&sort=files&dir=@filesNextDir&orgId=@Model.SelectedOrgId">
                            Files
                            <span class="ms-1 text-muted d-inline-block text-center" style="width:1em">@filesArrow</span>
                        </a>
                    </th>
                    <th>
                        <a class="link-dark text-decoration-none" href="/admin/allbatches?page=1&pageSize=@Model.PageSize&sort=validated&dir=@validatedNextDir&orgId=@Model.SelectedOrgId">
                            Validated
                            <span class="ms-1 text-muted d-inline-block text-center" style="width:1em">@validatedArrow</span>
                        </a>
                    </th>
                    <th>
                        <a class="link-dark text-decoration-none" href="/admin/allbatches?page=1&pageSize=@Model.PageSize&sort=status&dir=@statusNextDir&orgId=@Model.SelectedOrgId">
                            Status
                            <span class="ms-1 text-muted d-inline-block text-center" style="width:1em">@statusArrow</span>
                        </a>
                    </th>
                    <th>
                        <a class="link-dark text-decoration-none" href="/admin/allbatches?page=1&pageSize=@Model.PageSize&sort=created&dir=@createdNextDir&orgId=@Model.SelectedOrgId">
                            Created
                            <span class="ms-1 text-muted d-inline-block text-center" style="width:1em">@createdArrow</span>
                        </a>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Batches.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-3">No batches.</td>
                    </tr>
                }
                else
                {
                    foreach (var b in Model.Batches)
                    {
                        <tr>
                            <td class="small">@b.OrganizationName</td>
                            <td>@b.BatchNumber</td>
                            <td>@b.Name</td>
                            <td>@b.FileCount</td>
                            <td>@b.ValidatedCount</td>
                            <td>
                                @if (b.MarkedForDeletionAtUtc.HasValue)
                                {
                                    <span class="badge bg-danger">Marked For Deletion</span>
                                }
                                else if (b.LockedByUserId != null)
                                {
                                    <span class="badge bg-warning text-dark">Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                            </td>
                            <td>@b.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<nav class="mt-3" aria-label="All batches pagination">
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
            <a class="page-link" href="/admin/allbatches?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize&sort=@Model.Sort&dir=@Model.Dir&orgId=@Model.SelectedOrgId">Previous</a>
        </li>
        <li class="page-item disabled">
            <span class="page-link">Page @Model.CurrentPage / @Model.TotalPages</span>
        </li>
        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="/admin/allbatches?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize&sort=@Model.Sort&dir=@Model.Dir&orgId=@Model.SelectedOrgId">Next</a>
        </li>
    </ul>
</nav>
