@model KOCRAsp.Models.AdminOrganizationDetailsViewModel
@{
    ViewData["Title"] = "Organization Details";
    ViewData["MetaDescription"] = "View organization details in Admin Console.";
    var org = Model.Organization;
    var isPendingDeletion = org.MarkedForDeletionAtUtc.HasValue;
    var deletionText = isPendingDeletion
        ? org.MarkedForDeletionAtUtc!.Value.AddDays(Model.DeletedOrgRetentionDays).ToLocalTime().ToString("dd MMM yyyy HH:mm")
        : string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0">Organization Details</h1>
    <a class="btn btn-outline-secondary btn-sm" href="/admin">Back to Admin Console</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">
                @org.Name
                @if (org.IsGuestOrganization)
                {
                    <span class="badge bg-info text-dark ms-1">Guest</span>
                }
                else if (org.IsBetaTestOrganization)
                {
                    <span class="badge bg-primary ms-1">Beta</span>
                }
            </dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(org.Description) ? "—" : org.Description)</dd>

            <dt class="col-sm-3">Users</dt>
            <dd class="col-sm-9">@org.UserCount</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (isPendingDeletion)
                {
                    <span class="badge bg-danger">Pending Deletion</span>
                    <span class="small text-muted ms-2">deletes @deletionText</span>
                }
                else
                {
                    <span class="badge @(org.IsActive ? "bg-success" : "bg-secondary")">
                        @(org.IsActive ? "Active" : "Revoked")
                    </span>
                }
            </dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@org.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>

            <dt class="col-sm-3">Beta OCR Limit</dt>
            <dd class="col-sm-9">
                @if (org.IsBetaTestOrganization)
                {
                    @org.BetaMaxOcrPages
                }
                else
                {
                    <span class="text-muted">N/A</span>
                }
            </dd>

            <dt class="col-sm-3">Stripe</dt>
            <dd class="col-sm-9">
                @if (org.IsGuestOrganization || org.IsBetaTestOrganization)
                {
                    <span class="text-muted">N/A</span>
                }
                else if (org.StripeCustomerId != null)
                {
                    var stripeBadgeClass = org.StripeSubscriptionStatus switch
                    {
                        "active" => "bg-success",
                        "trialing" => "bg-info text-dark",
                        "past_due" => "bg-warning text-dark",
                        "canceled" => "bg-secondary",
                        _ => "bg-secondary"
                    };
                    <span class="badge @stripeBadgeClass">@org.StripeSubscriptionStatus</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Not provisioned</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Organization Members</h5>
    </div>
    <div class="card-body">
        @if (Model.Users.Length == 0)
        {
            <p class="text-muted">No users in this organization.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@(user.FullName ?? "—")</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge @(user.IsOrganizationAdmin ? "bg-primary" : "bg-secondary")">
                                        @(user.Roles.FirstOrDefault() ?? "Unknown")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(user.IsActive ? "bg-success" : "bg-warning text-dark")">
                                        @(user.IsActive ? "Active" : "Locked")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
