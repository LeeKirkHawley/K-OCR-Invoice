@using K_OCR.Models.Api.SuperAdmin
@using K_OCR.Models
@model OrganizationOverview[]
@{
    ViewData["Title"] = "Admin Console";
    var batches = (ViewBag.Batches as BatchDetail[]) ?? Array.Empty<BatchDetail>();
    var deletedOrgRetentionDays = (int)(ViewBag.DeletedOrgRetentionDays ?? 14);
}

<h4 class="mb-4">Admin Console</h4>

<!-- Create org panel -->
<div class="card mb-4">
    <div class="card-header"><strong>Create Organization</strong></div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-sm-4">
                <input type="text" id="orgName" class="form-control" placeholder="Organization name" maxlength="200" />
            </div>
            <div class="col-sm-4">
                <input type="text" id="orgDesc" class="form-control" placeholder="Description (optional)" maxlength="500" />
            </div>
            <div class="col-sm-4">
                <input type="email" id="adminEmail" class="form-control" placeholder="Admin email" />
            </div>
            <div class="col-sm-4">
                <input type="text" id="adminName" class="form-control" placeholder="Admin full name" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" id="createOrgBtn" onclick="createOrg()">Create</button>
            </div>
        </div>
    </div>
</div>

<!-- Organizations table -->
<div class="card mb-4">
    <div class="card-header"><strong>Organizations</strong></div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="orgTable">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Users</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th>Stripe</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">No organizations.</td>
                    </tr>
                }
                else
                {
                    foreach (var org in Model)
                    {
                        var isPendingDeletion = org.MarkedForDeletionAtUtc.HasValue;
                        <tr id="org-row-@org.OrganizationId">
                            <td>
                                @org.Name
                                @if (org.IsGuestOrganization)
                                {
                                    <span class="badge bg-info text-dark ms-1">Guest</span>
                                }
                            </td>
                            <td class="text-muted small">@org.Description</td>
                            <td>@org.UserCount</td>
                            <td>@org.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                @if (isPendingDeletion)
                                {
                                    <span id="org-badge-@org.OrganizationId" class="badge bg-danger">
                                        Pending Deletion
                                    </span>
                                    <div class="small text-muted">
                                        @{
                                            var markedDate = org.MarkedForDeletionAtUtc!.Value;
                                            var deletionDate = markedDate.AddDays(deletedOrgRetentionDays);
                                            <text>deletes @deletionDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</text>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span id="org-badge-@org.OrganizationId"
                                          class="badge @(org.IsActive ? "bg-success" : "bg-secondary")">
                                        @(org.IsActive ? "Active" : "Revoked")
                                    </span>
                                }
                            </td>
                            <td id="org-stripe-@org.OrganizationId">
                                @if (org.IsGuestOrganization)
                                {
                                    <span class="text-muted small">N/A</span>
                                }
                                else if (org.StripeCustomerId != null)
                                {
                                    var stripeBadgeClass = org.StripeSubscriptionStatus switch
                                    {
                                        "active"   => "bg-success",
                                        "trialing" => "bg-info text-dark",
                                        "past_due" => "bg-warning text-dark",
                                        "canceled" => "bg-secondary",
                                        _          => "bg-secondary"
                                    };
                                    <span class="badge @stripeBadgeClass">@org.StripeSubscriptionStatus</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Not provisioned</span>
                                }
                            </td>
                            <td class="text-end" id="org-actions-@org.OrganizationId">
                                @if (isPendingDeletion)
                                {
                                    <button class="btn btn-sm btn-outline-success me-1"
                                            onclick="reinstateOrg('@org.OrganizationId', this)">Reinstate</button>
                                    <button class="btn btn-sm btn-danger"
                                            onclick="hardDeleteOrg('@org.OrganizationId', this)">Delete Now</button>
                                }
                                else if (org.IsActive)
                                {
                                    if (!org.IsGuestOrganization && org.StripeCustomerId == null)
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                onclick="provisionStripe('@org.OrganizationId', this)">Provision Stripe</button>
                                    }
                                    @if (!org.IsGuestOrganization && org.StripeCustomerId != null)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary me-1"
                                                onclick="syncStripeStatus('@org.OrganizationId', this)">Sync Status</button>
                                    }
                                    <button class="btn btn-sm btn-outline-warning"
                                            onclick="revokeOrg('@org.OrganizationId', this)">Revoke</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success me-1"
                                            onclick="reEnableOrg('@org.OrganizationId', this)">Re-enable</button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            onclick="markForDeletionOrg('@org.OrganizationId', this)">Mark for Deletion</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- All batches table -->
<div class="card">
    <div class="card-header"><strong>All Batches</strong></div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Org</th>
                    <th>#</th>
                    <th>Name</th>
                    <th>Files</th>
                    <th>Validated</th>
                    <th>Status</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @if (!batches.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-3">No batches.</td>
                    </tr>
                }
                else
                {
                    foreach (var b in batches.OrderByDescending(x => x.CreatedAtUtc))
                    {
                        <tr>
                            <td class="small">@b.OrganizationName</td>
                            <td>@b.BatchNumber</td>
                            <td>@b.Name</td>
                            <td>@b.FileCount</td>
                            <td>@b.ValidatedCount</td>
                            <td>
                                @if (b.MarkedForDeletionAtUtc.HasValue)
                                {
                                    <span class="badge bg-danger">Marked For Deletion</span>
                                }
                                else if (b.LockedByUserId != null)
                                {
                                    <span class="badge bg-warning text-dark">Locked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                            </td>
                            <td>@b.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Setup link modal -->
<div class="modal fade" id="setupLinkModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Admin Setup Link</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Email was not sent. Share this setup link with the organization admin:</p>
                <input type="text" id="setupLinkInput" class="form-control mb-2" readonly />
                <button class="btn btn-sm btn-outline-secondary" onclick="copySetupLink()">Copy</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function createOrg() {
        const name = document.getElementById('orgName').value.trim();
        const desc = document.getElementById('orgDesc').value.trim();
        const email = document.getElementById('adminEmail').value.trim();
        const adminName = document.getElementById('adminName').value.trim();

        if (!name || !email || !adminName) {
            showToast('Name, admin email and admin name are required.', 'warning');
            return;
        }

        const btn = document.getElementById('createOrgBtn');
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/admin/createorganization', {
                name, description: desc, adminEmail: email, adminName
            });
            if (result.success) {
                if (result.stripeProvisioned === false) {
                    showToast('Organization created, but Stripe provisioning failed: ' + (result.stripeProvisioningError ?? 'unknown error') + ' \u2014 use the Provision Stripe button to retry.', 'warning');
                } else {
                    showToast('Organization created.');
                }
                if (result.setupLink && !result.emailSent) {
                    document.getElementById('setupLinkInput').value = result.setupLink;
                    new bootstrap.Modal(document.getElementById('setupLinkModal')).show();
                }
                location.reload();
            } else {
                showToast(result.error ?? 'Create failed.', 'error');
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
        } finally {
            setButtonLoading(btn, false);
        }
    }

    async function revokeOrg(orgId, btn) {
        if (!confirm('Revoke this organization? All its users will be locked out.')) return;
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/admin/revokeorganization', { orgId });
            if (result.success) {
                document.getElementById('org-badge-' + orgId).className = 'badge bg-secondary';
                document.getElementById('org-badge-' + orgId).textContent = 'Revoked';
                document.getElementById('org-actions-' + orgId).innerHTML =
                    `<button class="btn btn-sm btn-outline-success me-1" onclick="reEnableOrg('${orgId}', this)">Re-enable</button>` +
                    `<button class="btn btn-sm btn-outline-danger" onclick="markForDeletionOrg('${orgId}', this)">Mark for Deletion</button>`;
                showToast('Organization revoked.');
            } else {
                showToast(result.error ?? 'Revoke failed.', 'error');
                setButtonLoading(btn, false);
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
            setButtonLoading(btn, false);
        }
    }

    async function reEnableOrg(orgId, btn) {
        if (!confirm('Re-enable this organization? Its users will be able to log in again.')) return;
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/admin/reenableorganization', { orgId });
            if (result.success) {
                document.getElementById('org-badge-' + orgId).className = 'badge bg-success';
                document.getElementById('org-badge-' + orgId).textContent = 'Active';
                document.getElementById('org-actions-' + orgId).innerHTML =
                    `<button class="btn btn-sm btn-outline-warning" onclick="revokeOrg('${orgId}', this)">Revoke</button>`;
                showToast('Organization re-enabled.');
            } else {
                showToast(result.error ?? 'Re-enable failed.', 'error');
                setButtonLoading(btn, false);
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
            setButtonLoading(btn, false);
        }
    }

    async function markForDeletionOrg(orgId, btn) {
        if (!confirm('Mark this organization for deletion? It will be permanently deleted after the retention period.')) return;
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/admin/deleteorganization', { orgId });
            if (result.success) {
                document.getElementById('org-badge-' + orgId).outerHTML =
                    `<span id="org-badge-${orgId}" class="badge bg-danger">Pending Deletion</span>`;
                document.getElementById('org-actions-' + orgId).innerHTML =
                    `<button class="btn btn-sm btn-outline-success me-1" onclick="reinstateOrg('${orgId}', this)">Reinstate</button>` +
                    `<button class="btn btn-sm btn-danger" onclick="hardDeleteOrg('${orgId}', this)">Delete Now</button>`;
                showToast('Organization marked for deletion.');
            } else {
                showToast(result.error ?? 'Mark for deletion failed.', 'error');
                setButtonLoading(btn, false);
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
            setButtonLoading(btn, false);
        }
    }

    async function reinstateOrg(orgId, btn) {
        if (!confirm('Reinstate this organization? It will become active again.')) return;
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/admin/reinstateorganization', { orgId });
            if (result.success) {
                document.getElementById('org-badge-' + orgId).className = 'badge bg-success';
                document.getElementById('org-badge-' + orgId).textContent = 'Active';
                document.getElementById('org-actions-' + orgId).innerHTML =
                    `<button class="btn btn-sm btn-outline-warning" onclick="revokeOrg('${orgId}', this)">Revoke</button>`;
                showToast('Organization reinstated.');
            } else {
                showToast(result.error ?? 'Reinstate failed.', 'error');
                setButtonLoading(btn, false);
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
            setButtonLoading(btn, false);
        }
    }

    async function hardDeleteOrg(orgId, btn) {
        if (!confirm('Permanently delete this organization and ALL its data? This cannot be undone.')) return;
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/admin/harddeleteorganization', { orgId });
            if (result.success) {
                document.getElementById('org-row-' + orgId)?.remove();
                showToast('Organization permanently deleted.');
            } else {
                showToast(result.error ?? 'Delete failed.', 'error');
                setButtonLoading(btn, false);
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
            setButtonLoading(btn, false);
        }
    }

    function copySetupLink() {
        const input = document.getElementById('setupLinkInput');
        input.select();
        navigator.clipboard.writeText(input.value).then(() => showToast('Copied!'));
    }

    async function syncStripeStatus(orgId, btn) {
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/admin/syncstripestatus', { orgId });
            if (result.success) {
                location.reload();
            } else {
                showToast(result.error ?? 'Sync failed.', 'error');
                setButtonLoading(btn, false);
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
            setButtonLoading(btn, false);
        }
    }

    async function provisionStripe(orgId, btn) {
        const priceId = prompt('Enter a Stripe Price ID to use (leave blank to use the configured default):');
        if (priceId === null) return; // cancelled
        setButtonLoading(btn, true);
        try {
            const result = await postJson('/admin/provisionstripe', { orgId, priceId });
            if (result.success) {
                document.getElementById('org-stripe-' + orgId).innerHTML =
                    '<span class="badge bg-success">active</span>';
                btn.remove();
                showToast('Stripe subscription provisioned.');
            } else {
                showToast(result.error ?? 'Provision failed.', 'error');
                setButtonLoading(btn, false);
            }
        } catch (err) {
            showToast('Error: ' + err.message, 'error');
            setButtonLoading(btn, false);
        }
    }
</script>
}
