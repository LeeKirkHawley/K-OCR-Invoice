@model KOCRAsp.Models.OcrQueueViewModel
@{
    ViewData["Title"] = "OCR Queue Monitor";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0">📋 OCR Queue Monitor</h4>
    <span class="badge bg-secondary" id="connection-badge">Connecting…</span>
</div>

<!-- Pause/Resume controls -->
<div class="mb-3 d-flex align-items-center gap-3">
    <button id="btn-pause" class="btn btn-warning btn-sm" onclick="pauseQueue()"
        @(Model.IsPaused ? "disabled" : "")>
        ⏸ Pause Queue
    </button>
    <button id="btn-resume" class="btn btn-success btn-sm" onclick="resumeQueue()"
        @(!Model.IsPaused ? "disabled" : "")>
        ▶ Resume Queue
    </button>
    <span id="queue-status" class="fw-semibold @(Model.IsPaused ? "text-warning" : "text-success")">
        @(Model.IsPaused ? "⚠ Paused" : "● Running")
    </span>
    <span id="drain-status" class="text-muted small" style="display:none">Draining in-flight jobs…</span>
</div>

<!-- Summary card -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card text-center">
            <div class="card-body py-3">
                <div class="fs-1 fw-bold text-primary" id="total-queued">@Model.TotalQueued</div>
                <div class="text-muted small">Jobs queued</div>
            </div>
        </div>
    </div>
</div>

<!-- Per-org table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Queue by Organisation</strong>
        <span class="text-muted small" id="last-updated">—</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="org-queue-table">
            <thead class="table-light">
                <tr>
                    <th>Organisation</th>
                    <th class="text-end">Queued Invoices</th>
                </tr>
            </thead>
            <tbody id="org-queue-body">
                @if (!Model.PerOrgCount.Any())
                {
                    <tr id="empty-row">
                        <td colspan="2" class="text-center text-muted py-3">Queue is empty.</td>
                    </tr>
                }
                else
                {
                    foreach (var (orgId, count) in Model.PerOrgCount.OrderByDescending(x => x.Value))
                    {
                        var name = Model.OrgNames.TryGetValue(orgId, out var n) ? n : orgId;
                        Model.PerOrgInvoices.TryGetValue(orgId, out var files);
                        <tr class="org-header-row">
                            <td><strong>@name</strong></td>
                            <td class="text-end fw-bold">@count</td>
                        </tr>
                        @if (files is { Count: > 0 })
                        {
                            <tr class="invoice-detail-row">
                                <td colspan="2" class="pt-0 pb-2">
                                    <ul class="mb-0 ms-3 small text-muted">
                                        @foreach (var file in files)
                                        {
                                            <li>@file</li>
                                        }
                                    </ul>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="~/lib/signalr/signalr.min.js"></script>
<script>
    // org ID → name map, seeded from server render; updated by SignalR pushes
    const orgNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrgNames));

    const badge   = document.getElementById('connection-badge');
    const totalEl = document.getElementById('total-queued');
    const tbody   = document.getElementById('org-queue-body');
    const lastUpd = document.getElementById('last-updated');

    const connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/ocr')
        .withAutomaticReconnect()
        .build();

    connection.on('QueueStatsUpdated', (stats) => {
        // Update total
        totalEl.textContent = stats.totalQueued;

        // Rebuild per-org rows (exclude zero-count entries)
        const counts   = stats.perOrgCount    || {};
        const invoices = stats.perOrgInvoices  || {};
        const entries  = Object.entries(counts).filter(([, c]) => c > 0).sort((a, b) => b[1] - a[1]);

        if (entries.length === 0) {
            tbody.innerHTML = '<tr id="empty-row"><td colspan="2" class="text-center text-muted py-3">Queue is empty.</td></tr>';
        } else {
            tbody.innerHTML = entries.map(([orgId, count]) => {
                const name  = orgNames[orgId] || orgId;
                const files = invoices[orgId]  || [];
                const fileList = files.length
                    ? `<tr class="invoice-detail-row"><td colspan="2" class="pt-0 pb-2">` +
                      `<ul class="mb-0 ms-3 small text-muted">` +
                      files.map(f => `<li>${f}</li>`).join('') +
                      `</ul></td></tr>`
                    : '';
                return `<tr class="org-header-row"><td><strong>${name}</strong></td>` +
                       `<td class="text-end fw-bold">${count}</td></tr>${fileList}`;
            }).join('');
        }

        lastUpd.textContent = 'Updated ' + new Date().toLocaleTimeString();
    });

    connection.onreconnecting(() => {
        badge.textContent = 'Reconnecting…';
        badge.className = 'badge bg-warning text-dark';
    });

    connection.onreconnected(() => {
        badge.textContent = 'Live';
        badge.className = 'badge bg-success';
    });

    connection.onclose(() => {
        badge.textContent = 'Disconnected';
        badge.className = 'badge bg-danger';
    });

    connection.start()
        .then(() => {
            badge.textContent = 'Live';
            badge.className = 'badge bg-success';
            return connection.invoke('JoinQueueMonitor');
        })
        .catch(err => {
            badge.textContent = 'Error';
            badge.className = 'badge bg-danger';
            console.error('SignalR connection failed:', err);
        });

    // ── Pause / Resume ──────────────────────────────────────────────────────────

    const btnPause    = document.getElementById('btn-pause');
    const btnResume   = document.getElementById('btn-resume');
    const queueStatus = document.getElementById('queue-status');
    const drainStatus = document.getElementById('drain-status');

    function setUiPaused(paused) {
        btnPause.disabled  =  paused;
        btnResume.disabled = !paused;
        queueStatus.textContent  = paused ? '⚠ Paused'  : '● Running';
        queueStatus.className    = paused ? 'fw-semibold text-warning' : 'fw-semibold text-success';
        drainStatus.style.display = 'none';
    }

    async function pauseQueue() {
        btnPause.disabled = true;
        drainStatus.style.display = '';
        queueStatus.textContent = '⏳ Draining…';
        queueStatus.className = 'fw-semibold text-muted';
        try {
            const resp = await fetch('/Admin/PauseQueue', { method: 'POST' });
            const data = await resp.json();
            if (data.success) setUiPaused(true);
            else { alert('Pause failed: ' + data.error); setUiPaused(false); }
        } catch (e) {
            alert('Pause request failed: ' + e);
            setUiPaused(false);
        }
    }

    async function resumeQueue() {
        btnResume.disabled = true;
        try {
            const resp = await fetch('/Admin/ResumeQueue', { method: 'POST' });
            const data = await resp.json();
            if (data.success) setUiPaused(false);
            else { alert('Resume failed: ' + data.error); setUiPaused(true); }
        } catch (e) {
            alert('Resume request failed: ' + e);
            setUiPaused(true);
        }
    }
</script>
}
