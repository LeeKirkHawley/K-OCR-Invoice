@{
    ViewData["Title"] = "Elk Mountain Invoice";
    ViewData["HideNav"] = true;
    ViewData["AllowIndexing"] = true;
    ViewData["MetaDescription"] = "Elk Mountain Invoice is an invoice processing app. Sign in to upload, review, and process invoices.";
    Layout = "_Layout";
}

<section class="bg-light py-5 min-vh-100">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8 text-center">
                <img src="~/assets/ElkMountainHeader.png"
                     alt="Elk Mountain Invoice"
                     class="img-fluid mb-3"
                     style="max-width: 100%; height: auto;" />
                <p class="lead text-muted mb-4">
                    Sign in to upload, review, and process invoices with batch-based OCR and validation.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
                    <a class="btn btn-primary btn-lg" asp-controller="Auth" asp-action="Login">Log in</a>
                    <a class="btn btn-outline-secondary btn-lg"
                       asp-controller="Auth"
                       asp-action="Login"
                       asp-route-openGuest="1">New Guest Login</a>
                </div>
            </div>
            <div class="text-center">
                <a href="/manual">The Elk Mountain Invoice Manual</a>
            </div>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 card-title">Upload invoices</h2>
                        <p class="card-text text-muted mb-0">Add PDFs or images to a batch and keep related invoices together.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 card-title">Review OCR results</h2>
                        <p class="card-text text-muted mb-0">Check extracted fields, validate totals, and correct issues before export.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 card-title">Export batch data</h2>
                        <p class="card-text text-muted mb-0">Move finished work into JSON or Excel for downstream processing.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-5">
            <div class="col-lg-10 col-xl-8">
                <h2 class="h3 mb-3">How it works</h2>
                <ol class="text-muted">
                    <li class="mb-2">Sign in to your account or create a guest login.</li>
                    <li class="mb-2">Choose a batch, upload invoices, and run OCR.</li>
                    <li class="mb-0">Review results, validate data, and export when ready.</li>
                </ol>
            </div>
        </div>

        <div class="row justify-content-center mt-5">
            <div class="col-lg-10 col-xl-8">
                <h2 class="h3 mb-3">FAQ</h2>
                <div class="accordion" id="landingFaq">
                    <div class="accordion-item">
                        <h3 class="accordion-header" id="faq1Heading">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1" aria-expanded="true" aria-controls="faq1">
                                What is Elk Mountain Invoice?
                            </button>
                        </h3>
                        <div id="faq1" class="accordion-collapse collapse show" aria-labelledby="faq1Heading" data-bs-parent="#landingFaq">
                            <div class="accordion-body text-muted">
                                It is an invoice processing app for uploading batches, extracting invoice data, and reviewing OCR output.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h3 class="accordion-header" id="faq2Heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2" aria-expanded="false" aria-controls="faq2">
                                Can I try it without a full account?
                            </button>
                        </h3>
                        <div id="faq2" class="accordion-collapse collapse" aria-labelledby="faq2Heading" data-bs-parent="#landingFaq">
                            <div class="accordion-body text-muted">
                                Yes. Use the guest login flow from the sign-in page to create a temporary account.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h3 class="accordion-header" id="faq3Heading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3" aria-expanded="false" aria-controls="faq3">
                                What happens after sign in?
                            </button>
                        </h3>
                        <div id="faq3" class="accordion-collapse collapse" aria-labelledby="faq3Heading" data-bs-parent="#landingFaq">
                            <div class="accordion-body text-muted">
                                You go to the invoice processing workspace where batches, uploads, OCR, and validation tools are available.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script type="application/ld+json">
        @{
            var siteUrl = $"{ViewContext.HttpContext.Request.Scheme}://{ViewContext.HttpContext.Request.Host}{ViewContext.HttpContext.Request.PathBase}/";
            var schema = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@graph"] = new object[]
                {
                    new Dictionary<string, object?>
                    {
                        ["@type"] = "WebSite",
                        ["name"] = "Elk Mountain Invoice",
                        ["url"] = siteUrl
                    },
                    new Dictionary<string, object?>
                    {
                        ["@type"] = "SoftwareApplication",
                        ["name"] = "Elk Mountain Invoice",
                        ["applicationCategory"] = "BusinessApplication",
                        ["operatingSystem"] = "Web",
                        ["description"] = "Invoice processing app for uploading batches, extracting invoice data, and reviewing OCR output."
                    },
                    new Dictionary<string, object?>
                    {
                        ["@type"] = "FAQPage",
                        ["mainEntity"] = new object[]
                        {
                            new Dictionary<string, object?>
                            {
                                ["@type"] = "Question",
                                ["name"] = "What is Elk Mountain Invoice?",
                                ["acceptedAnswer"] = new Dictionary<string, object?>
                                {
                                    ["@type"] = "Answer",
                                    ["text"] = "It is an invoice processing app for uploading batches, extracting invoice data, and reviewing OCR output."
                                }
                            },
                            new Dictionary<string, object?>
                            {
                                ["@type"] = "Question",
                                ["name"] = "Can I try it without a full account?",
                                ["acceptedAnswer"] = new Dictionary<string, object?>
                                {
                                    ["@type"] = "Answer",
                                    ["text"] = "Yes. Use the guest login flow from the sign-in page to create a temporary account."
                                }
                            },
                            new Dictionary<string, object?>
                            {
                                ["@type"] = "Question",
                                ["name"] = "What happens after sign in?",
                                ["acceptedAnswer"] = new Dictionary<string, object?>
                                {
                                    ["@type"] = "Answer",
                                    ["text"] = "You go to the invoice processing workspace where batches, uploads, OCR, and validation tools are available."
                                }
                            }
                        }
                    }
                }
            });
        }
        @Html.Raw(schema)
    </script>
}
