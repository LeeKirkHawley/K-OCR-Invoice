    async function refreshFileList(page) {
        if (_refreshAbort) _refreshAbort.abort();
        _refreshAbort = new AbortController();
        const pgPrev = document.getElementById('pgPrev');
        const pgNext = document.getElementById('pgNext');
        pgPrev.disabled = true;
        pgNext.disabled = true;
        try {
            const p = page ?? _currentPage;
            const resp = await fetch(`/home/getfiles?page=${p}&pageSize=${_pageSize}`, { signal: _refreshAbort.signal });
            const data = await resp.json();
            _currentPage = data.page;
            renderFileList(data.items);
            renderPagination(data.total, data.page, data.pageSize, data.totalPages);
            document.getElementById('fileListContainer').scrollTop = 0;
        } catch (err) {
            if (err.name === 'AbortError') return;
            showToast('Refresh failed: ' + err.message, 'error');
        } finally {
            _refreshAbort = null;
        }
    }

    function renderFileList(files) {
        const container = document.getElementById('fileListContainer');
        if (!files || files.length === 0) {
            container.innerHTML = '<p class="text-muted small px-1">No files in batch.</p>';
            return;
        }
        let html = '';
        for (const file of files) {
            const active       = _currentFilePath === file.filePath ? ' active' : '';
            const overLimit    = file.exceedsPageLimit;
            const overLimitCls = overLimit ? ' file-list-item--overlimit' : '';
            const overLimitAttr = overLimit
                ? ` data-exceeds-limit="true" title="This invoice has ${file.totalPages} pages and exceeds the ${_maxPagesPerInvoice}-page limit. It will not be OCR'd."`
                : '';
            html += `<div class="file-list-item${active}${overLimitCls}" data-filepath="${escapeHtml(file.filePath)}"${overLimitAttr}>
                <span class="file-status-dot ${escapeHtml(file.processedDotClass ?? '')}"
                      title="${escapeHtml(file.processedDotTitle ?? '')}"></span>
                <span class="file-queue-indicator" style="${isFileQueued(file.filePath) ? '' : 'display:none;'}"
                      title="Queued for OCR">Q</span>
                <span class="file-status-dot ${escapeHtml(file.validationDotClass ?? '')}"
                      title="${escapeHtml(file.validationDotTitle ?? '')}"></span>
                <span class="text-truncate" style="flex:1;min-width:0;"
                      title="${escapeHtml(file.fileName)}">${escapeHtml(file.fileName)}</span>
            </div>`;
        }
        container.innerHTML = html;
    }

    function renderPagination(total, page, pageSize, totalPages) {
        const pgNavRow = document.getElementById('pgNavRow');
        const pgPrev   = document.getElementById('pgPrev');
        const pgNext   = document.getElementById('pgNext');
        const pgLabel  = document.getElementById('pgLabel');
        const pgSizeEl = document.getElementById('pgSize');
        pgSizeEl.value = String(pageSize);
        if (!totalPages || totalPages <= 1) {
            pgNavRow.style.display = 'none';
        } else {
            pgNavRow.style.display = '';
            const start = (page - 1) * pageSize + 1;
            const end   = Math.min(page * pageSize, total);
            pgLabel.textContent = `${start}–${end} of ${total}`;
            pgPrev.disabled = page <= 1;
            pgNext.disabled = page >= totalPages;
        }
    }

    async function refreshBatchDropdown() {
        try {
            const resp = await fetch('/home/getbatches');
            const batches = await resp.json();
            const selector = document.getElementById('batchSelector');
            const currentValue = selector.value;
            
            let html = '<option value="">— Select Batch —</option>';
            for (const batch of batches) {
                const selected = batch.batchId == currentValue ? ' selected' : '';
                html += `<option value="${batch.batchId}"${selected}>${escapeHtml(batch.name)}</option>`;
            }
            selector.innerHTML = html;
        } catch (err) {
            console.error('Failed to refresh batch dropdown:', err);
        }
    }

    function startOcrPolling() {
        if (_ocrPollInterval) return;
        _ocrPollInterval = setInterval(async () => {
            try {
                const resp = await fetch('/home/getocrstatus');
                const data = await resp.json();
                if (data.success && data.processed >= data.total && data.total > 0) {
                    clearInterval(_ocrPollInterval);
                    _ocrPollInterval = null;
                    hideOcrOverlay();
                    showToast(`OCR complete: ${data.processed}/${data.total} files processed.`);
                    await refreshFileList();
                }
            } catch { /* ignore poll errors */ }
        }, 3000);
    }

    // ── SignalR: real-time dot updates per invoice ───────────────
    async function refreshInvoiceDots(invoiceId) {
        try {
            const resp = await fetch(`/home/invoicedotstate?invoiceId=${invoiceId}`);
            if (!resp.ok) return;
            const data = await resp.json();
            if (data.error || !data.filePath) return;
            const item = findFileListItem(data.filePath);
            if (!item) return;
            const dots = item.querySelectorAll('.file-status-dot');
            if (dots.length >= 1) {
                dots[0].className = `file-status-dot ${data.processedDotClass ?? ''}`.trim();
                dots[0].title = data.processedDotTitle ?? '';
            }
            if (dots.length >= 2) {
                dots[1].className = `file-status-dot ${data.validationDotClass ?? ''}`.trim();
                dots[1].title = data.validationDotTitle ?? '';
            }
            // Remove Q indicator now that OCR is done
            clearFileQueued(data.filePath);
            const qEl = item.querySelector('.file-queue-indicator');
            if (qEl) qEl.style.display = 'none';
        } catch { /* ignore */ }
    }

    function markQueueIndicators() {
        document.querySelectorAll('.file-list-item').forEach(item => {
            const fp  = item.dataset.filepath;
            const qEl = item.querySelector('.file-queue-indicator');
            if (!qEl) return;
            qEl.style.display = isFileQueued(fp) ? '' : 'none';
        });
    }

    function initOcrSignalR() {
        if (!_orgId) return;
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/ocr')
            .withAutomaticReconnect()
            .build();

        connection.on('InvoiceOcrCompleted', async (payload) => {
            if (_currentBatchId !== null && payload.batchId !== _currentBatchId) return;
            await refreshInvoiceDots(payload.invoiceId);
        });

        connection.start()
            .then(() => connection.invoke('JoinOrgGroup', _orgId))
            .catch(err => console.warn('[OCR SignalR] Connection failed:', err));
    }

    // ── Strip bbox-only fields for JSON display / export ────────
    // Keeps _currentInvoice intact so 2-way highlighting still works.
    function stripBboxFields(inv) {
        if (!inv) return inv;
        const { fieldBoundingBoxes, originalPageWidth, originalPageHeight, pageCount, items, ...rest } = inv;
        return {
            ...rest,
            items: (items ?? []).map(({ boundingBoxes, ...itemRest }) => itemRest)
        };
    }

    // ── Init ────────────────────────────────────────────────────
    document.getElementById('pgPrev').addEventListener('click', () => refreshFileList(_currentPage - 1));
    document.getElementById('pgNext').addEventListener('click', () => refreshFileList(_currentPage + 1));
    document.getElementById('pgSize').addEventListener('change', function () {
        _pageSize = parseInt(this.value, 10);
        refreshFileList(1);
    });
    renderPagination(@Model.TotalFiles, @Model.CurrentPage, @Model.PageSize, @Model.TotalPages);
    updateExportButtonState();
    initKocrSplitters();
    initKocrZoom();
    initVtip();
    initOcrSignalR();
</script>
}
