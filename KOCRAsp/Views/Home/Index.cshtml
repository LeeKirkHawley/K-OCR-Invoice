@model KOCRAsp.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["FullScreen"] = true;
}

<div class="kocr-shell" id="kocrShell">

    <!-- ── Left pane: file list ──────────────────────────────────── -->
    <div class="kocr-pane kocr-pane-left">
        <div class="kocr-panel-header kocr-file-list-header p-1">
            <div class="d-flex gap-1 mb-1">
                <select id="batchSelector" class="form-select form-select-sm">
                    <option value="">— Select Batch —</option>
                    @foreach (var batch in Model.AvailableBatches)
                    {
                        if (batch.IsMarkedForDeletion)
                        {
                            <option value="@batch.BatchId" disabled
                                    style="text-decoration: line-through; color: gray;">
                                🗑️ @batch.Name (#@batch.BatchNumber)
                            </option>
                        }
                        else if (Model.CurrentBatch?.BatchId == batch.BatchId)
                        {
                            <option value="@batch.BatchId" selected>@batch.Name (#@batch.BatchNumber)</option>
                        }
                        else
                        {
                            <option value="@batch.BatchId">@batch.Name (#@batch.BatchNumber)</option>
                        }
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary py-0 text-nowrap" onclick="openNewBatchModal(); return false;" title="Create new batch">➕ New Batch</button>
            </div>
            <div class="d-flex gap-1">
                <label class="btn btn-sm btn-outline-primary mb-0 py-0 px-2" title="Upload Invoices">
                    📤 Upload Invoices
                    <input type="file" id="uploadInput" multiple hidden accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.bmp" />
                </label>
                <button id="batchOcrBtn" class="btn btn-sm btn-outline-success py-0" title="Run OCR on all files">▶ OCR All</button>
                <button id="refreshBtn"  class="btn btn-sm btn-outline-secondary py-0" title="Refresh">🔄</button>
                <div class="dropdown">
                    <button id="exportDropdownBtn" class="btn btn-sm btn-outline-secondary py-0 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Export batch">📥</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#" onclick="exportBatchJson(); return false;">Export to JSON</a></li>
                        <li><a class="dropdown-item" href="#" onclick="exportBatchExcel(); return false;">Export to Excel</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="kocr-file-items" id="fileListContainer">
            @if (Model.CurrentBatch == null)
            {
                <p class="text-muted small px-2 pt-2">No batch selected.</p>
            }
            else if (!Model.Files.Any())
            {
                <p class="text-muted small px-2 pt-2">No files in batch.</p>
            }
            else
            {
                foreach (var file in Model.Files)
                {
                    var overLimitClass = file.ExceedsPageLimit ? " file-list-item--overlimit" : "";
                    var overLimitAttr  = file.ExceedsPageLimit ? $" data-exceeds-limit=\"true\" title=\"This invoice has {file.TotalPages} pages and exceeds the {Model.MaxPagesPerInvoice}-page limit. It will not be OCR'd.\"" : "";
                    <text>
                    <div class="file-list-item@overLimitClass" data-filepath="@file.FilePath"@Html.Raw(overLimitAttr)>
                        <span class="file-status-dot @file.ProcessedDotClass"  title="@file.ProcessedDotTitle"></span>
                        <span class="file-queue-indicator" style="display:none;" title="Queued for OCR">Q</span>
                        <span class="file-status-dot @file.ValidationDotClass" title="@file.ValidationDotTitle"></span>
                        <span class="text-truncate" style="flex:1;min-width:0;" title="@file.FileName">@file.FileName</span>
                    </div>
                    </text>
                }
            }
        </div>
        <div class="kocr-file-list-footer">
            <div class="pg-size-row">
                <label for="pgSize" class="pg-size-label">Show</label>
                <select id="pgSize" class="form-select form-select-sm pg-size-select">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="pg-nav-row" id="pgNavRow" style="display:none;">
                <button id="pgPrev" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Previous page" disabled>&lsaquo;</button>
                <span id="pgLabel" class="pg-label small"></span>
                <button id="pgNext" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Next page" disabled>&rsaquo;</button>
            </div>
        </div>
    </div>

    <!-- ── Left splitter ─────────────────────────────────────────── -->
    <div class="splitter" id="splitterLeft"></div>

    <!-- ── Center pane: document viewer ─────────────────────────── -->
    <div class="kocr-pane kocr-pane-center">
        <div class="kocr-panel-header viewer-toolbar" id="viewerToolbar" style="display:none;">
            <button class="viewer-btn" id="zoomOutBtn"  title="Zoom out">−</button>
            <span   class="viewer-zoom-label" id="zoomLabel">100%</span>
            <button class="viewer-btn" id="zoomInBtn"   title="Zoom in">+</button>
            <button class="viewer-btn viewer-btn-fit" id="zoomFitWBtn" title="Fit to width">⊞ Fit W</button>
            <button class="viewer-btn viewer-btn-fit" id="zoomFitHBtn" title="Fit to height">↕ Fit H</button>
        </div>
        <div class="viewer-scroll" id="viewerScroll">
            <div class="viewer-placeholder" id="noDocMsg">Select a file to view the document</div>
            <div id="viewerPagesContainer"></div>
        </div>
    </div>

    <!-- ── Right splitter ────────────────────────────────────────── -->
    <div class="splitter" id="splitterRight"></div>

    <!-- ── Right pane: invoice/validation ────────────────────────── -->
    <div class="kocr-pane kocr-pane-right">
        <div class="kocr-panel-header kocr-invoice-header">
            <ul class="nav nav-tabs px-2 pt-1" id="invoiceTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active py-1 px-2 small" data-bs-toggle="tab"
                            data-bs-target="#tab-validation" type="button" role="tab">Validation</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-2 small" data-bs-toggle="tab"
                            data-bs-target="#tab-rawjson" type="button" role="tab">Raw JSON</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-2 small" data-bs-toggle="tab"
                            data-bs-target="#tab-validatedjson" type="button" role="tab">Updated JSON</button>
                </li>
            </ul>
            <span id="validationStatusLabel" class="validation-status-label" aria-live="polite"></span>
        </div>
        <div class="kocr-invoice-body tab-content">
            <div class="tab-pane fade show active" id="tab-validation" role="tabpanel">
                <div id="invoiceFields">
                    <p class="text-muted small">Select a file to view invoice data.</p>
                </div>
            </div>
            <div class="tab-pane fade" id="tab-rawjson" role="tabpanel">
                <pre id="rawJsonContent" class="bg-light p-2 rounded"
                     style="font-size:0.72rem;white-space:pre-wrap;word-break:break-all;"></pre>
            </div>
            <div class="tab-pane fade" id="tab-validatedjson" role="tabpanel">
                <pre id="validatedJsonContent" class="bg-light p-2 rounded"
                     style="font-size:0.72rem;white-space:pre-wrap;word-break:break-all;"></pre>
            </div>
        </div>
    </div>

</div>
<!-- OCR In Progress overlay -->
<div id="ocrOverlay">
    <div class="spinner-border text-light ocr-spinner" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <span class="ocr-overlay-label">OCR In Progress...</span>
</div>
<!-- Upload In Progress overlay -->
<div id="uploadOverlay">
    <div class="spinner-border text-light ocr-spinner" role="status">
        <span class="visually-hidden">Uploading...</span>
    </div>
    <span class="ocr-overlay-label">Uploading...</span>
</div>
<!-- Setup link modal -->
<div class="modal fade" id="setupLinkModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Setup Link</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Email was not sent. Share this link with the user:</p>
                <input type="text" id="setupLinkInput" class="form-control" readonly />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Re-OCR confirmation dialog -->
<div class="modal fade" id="reOcrModal" tabindex="-1" aria-labelledby="reOcrModalLabel" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info-subtle">
                <h5 class="modal-title" id="reOcrModalLabel">ℹ️ Files Already Processed</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>The following files already have OCR results:</p>
                <ul id="reOcrFileList" class="list-group list-group-flush mb-3" style="max-height:200px;overflow-y:auto;"></ul>
                <p class="mb-0">What would you like to do?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="reOcrSkipBtn">Skip these files (OCR remaining only)</button>
                <button type="button" class="btn btn-outline-danger" id="reOcrAllBtn">Re-OCR all files</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
<script src="~/lib/signalr/signalr.min.js"></script>
<script>
    let _currentFilePath  = null;
    let _currentInvoice   = null;
    let _ocrPollInterval  = null;
    let _selectedFieldKey = null;
    let _currentPage      = @Model.CurrentPage;
    let _pageSize         = @Model.PageSize;
    let _refreshAbort     = null;

    const _queuedFilePathKeys = new Set();

    function normalizeFilePathKey(filePath) {
        return String(filePath ?? '').replaceAll('/', '\\').toLowerCase();
    }

    function markFileQueued(filePath) {
        const key = normalizeFilePathKey(filePath);
        if (key) _queuedFilePathKeys.add(key);
    }

    function clearFileQueued(filePath) {
        const key = normalizeFilePathKey(filePath);
        if (key) _queuedFilePathKeys.delete(key);
    }

    function isFileQueued(filePath) {
        return _queuedFilePathKeys.has(normalizeFilePathKey(filePath));
    }

    function findFileListItem(filePath) {
        const key = normalizeFilePathKey(filePath);
        if (!key) return null;
        return Array.from(document.querySelectorAll('.file-list-item'))
            .find(item => normalizeFilePathKey(item.dataset.filepath) === key) ?? null;
    }

    const _orgId             = '@Html.Raw(Model.OrgId)';
    const _currentBatchId    = @(Model.CurrentBatch?.BatchId.ToString() ?? "null");
    const _maxPagesPerInvoice = @Model.MaxPagesPerInvoice;

    // ── Batch selector ──────────────────────────────────────────
    document.getElementById('batchSelector').addEventListener('change', function () {
        const batchId = this.value;
        if (!batchId) return;
        const fd = new FormData();
        fd.append('batchId', batchId);
        postForm('/home/selectbatch', fd)
            .then(() => location.reload())
            .catch(err => showToast('Failed to switch batch: ' + err.message, 'error'));
    });

    // ── File upload ─────────────────────────────────────────────
    document.getElementById('uploadInput').addEventListener('change', async function () {
        if (!this.files.length) return;
        const fd = new FormData();
        for (const f of this.files) {
            fd.append('files', f);
            fd.append('clientPaths', f.webkitRelativePath || f.name);
        }
        showUploadOverlay();
        try {
            const result = await postForm('/home/uploadfiles', fd);
            if (result.success) {
                showToast(`Uploaded ${result.filesUploaded} file(s).`);
                if (result.filesSkippedByLimit > 0) {
                    showToast(`${result.filesSkippedByLimit} file(s) were not uploaded: batch invoice limit reached.`, 'warning');
                }
                await refreshFileList();
                await refreshBatchDropdown();
                await updateExportButtonState();
            } else {
                showToast(result.error ?? 'Upload failed.', 'error');
            }
        } catch (err) {
            showToast('Upload error: ' + err.message, 'error');
        } finally {
            hideUploadOverlay();
        }
        this.value = '';
    });

    // ── Refresh ─────────────────────────────────────────────────
    document.getElementById('refreshBtn').addEventListener('click', async () => {
        await refreshFileList();
        await refreshBatchDropdown();
    });

    // ── Batch OCR ───────────────────────────────────────────────
    document.getElementById('batchOcrBtn').addEventListener('click', async function () {
        try {
            const checkResult = await fetch('/home/GetAlreadyOcrdFiles');
            const checkData   = await checkResult.json();
            if (checkData.files && checkData.files.length > 0) {
                const list = document.getElementById('reOcrFileList');
                list.innerHTML = '';
                checkData.files.forEach(f => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item py-1 px-2 small';
                    li.textContent = f;
                    list.appendChild(li);
                });
                bootstrap.Modal.getOrCreateInstance(document.getElementById('reOcrModal')).show();
                return;
            }
        } catch { /* network error – fall through to OCR */ }
        startBatchOcr(false);
    });

    document.getElementById('reOcrSkipBtn').addEventListener('click', function () {
        bootstrap.Modal.getInstance(document.getElementById('reOcrModal')).hide();
        startBatchOcr(true);
    });

    document.getElementById('reOcrAllBtn').addEventListener('click', function () {
        bootstrap.Modal.getInstance(document.getElementById('reOcrModal')).hide();
        startBatchOcr(false);
    });

    async function startBatchOcr(skipAlreadyOcrd) {
        showOcrOverlay();
        try {
            const fd = new FormData();
            if (skipAlreadyOcrd) fd.append('skipAlreadyOcrd', 'true');
            const result = await postForm('/home/batchocr', fd);
            if (result.success) {
                if (result.allSkipped) {
                    hideOcrOverlay();
                    showToast('All files already processed — nothing to OCR.');
                } else {
                    (result.queuedFilePaths ?? []).forEach(markFileQueued);
                    markQueueIndicators();
                    showToast('Batch OCR started.');
                    startOcrPolling();
                }
            } else {
                hideOcrOverlay();
                showToast(result.error ?? 'OCR failed.', 'error');
            }
        } catch (err) {
            hideOcrOverlay();
            showToast('Batch OCR error: ' + err.message, 'error');
        }
    }

    // ── File click ──────────────────────────────────────────────
    document.getElementById('fileListContainer').addEventListener('click', function (e) {
        const item = e.target.closest('.file-list-item');
        if (!item) return;
        document.querySelectorAll('.file-list-item').forEach(el => el.classList.remove('active'));
        item.classList.add('active');
        const exceedsLimit = item.dataset.exceedsLimit === 'true';
        selectFile(item.dataset.filepath, exceedsLimit);
    });

    async function selectFile(filePath, exceedsLimit) {
        _currentFilePath  = filePath;
        _selectedFieldKey = null;
        loadDocumentPages(filePath);
        try {
            const result = await fetch('/home/getinvoice?filePath=' + encodeURIComponent(filePath));
            const data = await result.json();
            if (data.success && data.invoice) {
                _currentInvoice = data.invoice;
                renderInvoiceFields(data.invoice);
                updateValidationStatusLabel(data.invoice);
                document.getElementById('validatedJsonContent').textContent =
                    data.invoice.isValidationAccepted ? JSON.stringify(stripBboxFields(data.invoice), null, 2) : '';
            } else {
                document.getElementById('invoiceFields').innerHTML =
                    '<p class="text-muted">No invoice data yet. Run OCR to process this file.</p>';
                renderRunOcrButton(filePath, exceedsLimit);
                document.getElementById('validatedJsonContent').textContent = '';
                updateValidationStatusLabel(null);
            }
            document.getElementById('rawJsonContent').textContent =
                JSON.stringify(stripBboxFields(data.invoice) ?? null, null, 2);
        } catch (err) {
            showToast('Failed to load invoice: ' + err.message, 'error');
        }
    }

    async function loadDocumentPages(filePath) {
        const container = document.getElementById('viewerPagesContainer');
        const msg       = document.getElementById('noDocMsg');
        const toolbar   = document.getElementById('viewerToolbar');

        container.innerHTML   = '';
        msg.style.display     = 'none';
        toolbar.style.display = '';

        try {
            const resp = await fetch('/api/pages?path=' + encodeURIComponent(filePath));
            if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
            const paths = await resp.json();

            if (!paths || !paths.length) {
                msg.style.display     = '';
                toolbar.style.display = 'none';
                return;
            }

            const multiPage = paths.length > 1;
            paths.forEach((pagePath, idx) => {
                const pageNum  = idx + 1;
                const pageWrap = document.createElement('div');
                pageWrap.className = 'viewer-page-wrap';

                if (multiPage) {
                    const lbl = document.createElement('div');
                    lbl.className   = 'viewer-page-label';
                    lbl.textContent = `Page ${pageNum}`;
                    pageWrap.appendChild(lbl);
                }

                const imgWrap = document.createElement('div');
                imgWrap.className    = 'viewer-img-wrap';
                imgWrap.style.width  = _viewerZoomPct + '%';
                imgWrap.dataset.page = pageNum;

                const img = document.createElement('img');
                img.className = 'viewer-page-img';
                img.alt       = `Page ${pageNum}`;
                img.loading   = 'lazy';
                img.src       = '/api/image?path=' + encodeURIComponent(pagePath);
                img.onload = () => {
                    if (idx === 0) { _viewerZoomPct = 100; applyViewerZoom(); }
                    renderBboxOverlayForPage(pageNum);
                };
                img.onerror = () => { imgWrap.style.opacity = '0.3'; };

                imgWrap.appendChild(img);
                pageWrap.appendChild(imgWrap);
                container.appendChild(pageWrap);
            });
        } catch (err) {
            showToast('Failed to load pages: ' + err.message, 'error');
            msg.style.display     = '';
            toolbar.style.display = 'none';
        }
    }

    function renderRunOcrButton(filePath, exceedsLimit) {
        const container = document.getElementById('invoiceFields');
        const btn = document.createElement('button');
        btn.id = 'runOcrBtn';
        if (exceedsLimit) {
            btn.className = 'btn btn-sm btn-secondary mt-2';
            btn.textContent = '▶ Run OCR';
            btn.disabled = true;
            btn.title = `This invoice exceeds the ${_maxPagesPerInvoice}-page limit and cannot be OCR'd.`;
        } else {
            btn.className = 'btn btn-sm btn-primary mt-2';
            btn.textContent = '▶ Run OCR';
            btn.onclick = () => runOcrOnFile(filePath, btn);
        }
        container.appendChild(btn);
    }

    async function runOcrOnFile(filePath, btn) {
        if (isFileQueued(filePath)) {
            showToast('This invoice is already queued for OCR.', 'warning');
            return;
        }
        setButtonLoading(btn, true);
        showOcrOverlay();
        try {
            const fd = new FormData();
            fd.append('filePath', filePath);
            const result = await postForm('/home/startocr', fd);
            if (result.pageLimitExceeded) {
                showToast(result.error ?? 'Invoice exceeds page limit.', 'error');
                setButtonLoading(btn, false);
                return;
            }
            if (result.success && result.invoice) {
                _currentInvoice = result.invoice;
                renderInvoiceFields(result.invoice);
                updateValidationStatusLabel(result.invoice);
                document.getElementById('validatedJsonContent').textContent = '';
                document.getElementById('rawJsonContent').textContent =
                    JSON.stringify(stripBboxFields(result.invoice), null, 2);
                await refreshFileList();
                showToast('OCR complete.');
            } else {
                showToast(result.error ?? 'OCR failed.', 'error');
                setButtonLoading(btn, false);
            }
        } catch (err) {
            showToast('OCR error: ' + err.message, 'error');
            setButtonLoading(btn, false);
        } finally {
            hideOcrOverlay();
        }
    }

    const HEADER_FIELDS = [
        { key: 'VendorName',    label: 'Vendor',    prop: 'vendorName'    },
        { key: 'CustomerName',  label: 'Customer',  prop: 'customerName'  },
        { key: 'InvoiceId',     label: 'Invoice #', prop: 'invoiceId'     },
        { key: 'InvoiceDate',   label: 'Date',      prop: 'invoiceDate'   },
        { key: 'DueDate',       label: 'Due Date',  prop: 'dueDate'       },
        { key: 'PurchaseOrder', label: 'PO #',      prop: 'purchaseOrder' },
        { key: 'Subtotal',      label: 'Subtotal',  prop: 'subtotal'      },
        { key: 'TotalTax',      label: 'Tax',       prop: 'totalTax'      },
        { key: 'Shipping',      label: 'Shipping',  prop: 'shipping'      },
        { key: 'Total',         label: 'Total',     prop: 'total'         },
    ];

    function fmtMoney(v) { return v != null ? '$' + Number(v).toFixed(2) : ''; }

    function renderInvoiceFields(inv) {
        const container = document.getElementById('invoiceFields');

        let html = '<table class="table table-sm invoice-field-table"><tbody>';
        for (const f of HEADER_FIELDS) {
            const raw     = inv[f.prop];
            const isNum   = f.prop === 'subtotal' || f.prop === 'totalTax' ||
                            f.prop === 'shipping'  || f.prop === 'total';
            const value   = isNum ? fmtMoney(raw) : (raw ?? '');
            const suspect = isSuspect(inv, f.key);
            const tipData = buildFieldTooltip(inv, f.key, value);
            html += `<tr class="inv-field-row${suspect ? ' inv-suspect-row' : ''}" data-fieldkey="${f.key}" data-vtip="${escapeHtml(tipData.value)}" data-vtip-errors="${escapeHtml(tipData.errors.join('\n'))}">
                         <td>${escapeHtml(f.label)}</td>
                         <td><input class="form-control form-control-sm inv-field${suspect ? ' inv-suspect-input' : ''}"
                                    data-field="${f.prop}"
                                    data-fieldkey="${f.key}"
                                    value="${escapeHtml(String(value))}" /></td>
                     </tr>`;
        }
        html += '</tbody></table>';

        if (inv.items?.length) {
            html += '<h6 class="mt-2">Line Items</h6>';
            html += '<div class="table-responsive li-table-wrap"><table class="table table-sm table-bordered li-table" id="liTable">';
            html += '<colgroup>'
                  + '<col class="li-col" id="liColDesc" style="width:50%">'
                  + '<col class="li-col" id="liColQty"  style="width:10%">'
                  + '<col class="li-col" id="liColUp"   style="width:20%">'
                  + '<col class="li-col" id="liColAmt"  style="width:20%">'
                  + '</colgroup>';
            html += '<thead><tr>'
                  + '<th class="li-th">Description<span class="li-col-drag" data-col="0"></span></th>'
                  + '<th class="li-th">Qty<span class="li-col-drag" data-col="1"></span></th>'
                  + '<th class="li-th">Unit Price<span class="li-col-drag" data-col="2"></span></th>'
                  + '<th class="li-th">Total</th>'
                  + '</tr></thead><tbody>';
            for (let i = 0; i < inv.items.length; i++) {
                const item = inv.items[i];
                const fk   = `Item_${i}_Desc`;

                const dSusp = isItemFieldSuspect(inv, item, 'Description', i);
                const qSusp = isItemFieldSuspect(inv, item, 'Quantity',    i);
                const uSusp = isItemFieldSuspect(inv, item, 'UnitPrice',   i);
                const aSusp = isItemFieldSuspect(inv, item, 'Amount',      i);

                const dTip = buildItemFieldTooltip(inv, item, 'Description', i, item.description);
                const qTip = buildItemFieldTooltip(inv, item, 'Quantity',    i, item.quantity);
                const uTip = buildItemFieldTooltip(inv, item, 'UnitPrice',   i, item.unitPrice);
                const aTip = buildItemFieldTooltip(inv, item, 'Amount',      i, item.amount);

                const vtip = t => `data-vtip="${escapeHtml(t.value)}" data-vtip-errors="${escapeHtml(t.errors.join('\n'))}"`;
                const sc = f => f ? ' inv-suspect-input' : '';
                html += `<tr class="inv-field-row${(dSusp || qSusp || uSusp || aSusp) ? ' inv-suspect-row' : ''}" data-fieldkey="${fk}">
                             <td><input class="form-control form-control-sm inv-field${sc(dSusp)}" ${vtip(dTip)} data-item-idx="${i}" data-field="description" data-fieldkey="${fk}" value="${escapeHtml(item.description ?? '')}" /></td>
                             <td><input class="form-control form-control-sm inv-field${sc(qSusp)}" ${vtip(qTip)} data-item-idx="${i}" data-field="quantity"    data-fieldkey="${fk}" value="${item.quantity ?? ''}" /></td>
                             <td><input class="form-control form-control-sm inv-field${sc(uSusp)}" ${vtip(uTip)} data-item-idx="${i}" data-field="unitPrice"   data-fieldkey="${fk}" value="${item.unitPrice ?? ''}" /></td>
                             <td><input class="form-control form-control-sm inv-field${sc(aSusp)}" ${vtip(aTip)} data-item-idx="${i}" data-field="amount"      data-fieldkey="${fk}" value="${item.amount ?? ''}" /></td>
                         </tr>`;
            }
            html += '</tbody></table></div>';
        }

        html += `<div class="mt-3">
            <label class="form-label form-label-sm mb-1" for="notesField">Notes</label>
            <textarea id="notesField" class="form-control form-control-sm" rows="3"
                      style="resize:vertical;overflow-y:auto"
                      tabindex="-1">${escapeHtml(inv.notes ?? '')}</textarea>
        </div>`;

        html += `<div class="d-flex gap-2 mt-2 flex-wrap">
            <button id="saveBtn"   class="btn btn-sm btn-primary"           tabindex="-1" onclick="saveInvoice()">Save</button>
            <button id="acceptBtn" class="btn btn-sm btn-success"           tabindex="-1" onclick="acceptValidation()">Accept</button>
        </div>`;

        container.innerHTML = html;

        const notesEl = container.querySelector('#notesField');
        if (notesEl) {
            notesEl.addEventListener('input', () => {
                if (_currentInvoice) _currentInvoice.notes = notesEl.value;
            });
        }

        initLiColResize();

        const allInputs = Array.from(container.querySelectorAll('.inv-field'));
        allInputs.forEach((input, idx) => {
            input.addEventListener('change', () => {
                const itemIdx = input.dataset.itemIdx;
                if (itemIdx !== undefined) {
                    const i = parseInt(itemIdx);
                    if (_currentInvoice?.items?.[i] != null)
                        _currentInvoice.items[i][input.dataset.field] = input.value;
                } else {
                    applyFieldEdit(input.dataset.field, input.value);
                }
            });
            input.addEventListener('focus', () => selectField(input.dataset.fieldkey));
            input.addEventListener('keydown', e => {
                if (e.key !== 'Tab') return;
                if (!e.shiftKey && idx === allInputs.length - 1) {
                    e.preventDefault();
                    allInputs[0].focus();
                } else if (e.shiftKey && idx === 0) {
                    e.preventDefault();
                    allInputs[allInputs.length - 1].focus();
                }
            });
        });
        container.querySelectorAll('.inv-field-row').forEach(row => {
            row.addEventListener('click', () => selectField(row.dataset.fieldkey));
        });

        renderBboxOverlay();

        // Auto-select first field
        const firstInput = container.querySelector('.inv-field');
        if (firstInput) {
            firstInput.focus();
        } else {
            selectField(HEADER_FIELDS[0].key);
        }
    }

