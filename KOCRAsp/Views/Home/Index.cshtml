    // Tooltip showing the field value on line 1, then one error per line.
    function buildItemFieldTooltip(inv, item, fieldKey, idx, value) {
        const errors = [];
        if (!inv.isInvoiceAccepted) {
            const tesseractConfirmed = item.tesseractConfirmed ?? {};
            const fieldConfidences = item.fieldConfidences ?? {};
            const mathConfirmed = inv._mathConfirmed ?? {};
        if (tesseractConfirmed[fieldKey] === false) errors.push('Secondary OCR mismatch');
            if (fieldKey in fieldConfidences && fieldConfidences[fieldKey] < _minConfidenceThreshold) errors.push('Low Azure confidence');
            if (fieldKey === 'Amount') {
                if (mathConfirmed[`LineItem[${idx}].Amount`] === false) errors.push('Math error');
            }
        }
        const valueStr = (value !== null && value !== undefined && value !== '') ? String(value) : '—';
        return { value: valueStr, errors };
    }

    // Builds the pending-edits history for header + item fields and persists
    // them via /home/saveinvoiceedits. Called when the user clicks Accept
    // (acceptValidation()), confirms saving via the "Unsaved changes"
    // switch-file prompt (which runs the same Accept flow), or explicitly
    // saves a single field via the field context menu's "Mark as Validated"
    // button - edits are NEVER written to the database on blur or any other
    // implicit action, only tracked locally as pending until then.
    // If fieldKeys is omitted, ALL pending edits are saved. If fieldKeys is a
    // Set of field keys (e.g. 'VendorName', 'Item_0_Qty'), only edits for
    // those fields are appended to history and persisted - other pending
    // edits are left untouched (still green) for a later save.
    // Returns { success, error } and skips the network call entirely when
    // there is nothing to save.
    async function savePendingEdits(fieldKeys) {
        if (!_currentFilePath || !_currentInvoice) 
            return { success: true };

        // Which field keys are we actually saving this call?
        const targetKeys = fieldKeys
            ? new Set([...fieldKeys].filter(k => _pendingEdits.has(k)))
            : new Set(_pendingEdits);

        if (targetKeys.size === 0) 
            return { success: true };

        // Store the original edit strings to restore on failure
        const savedInvoiceEdits = _currentInvoice.invoiceEdits;
        const savedItemEdits = (_currentInvoice.items ?? []).map(item => item.itemEdits);

        // Narrow _changedInvoiceFields/_changedItemFields down to just the
        // fields being saved this call, so appendPendingEditsToHistory only
        // appends history entries for those fields. Fields left out stay
        // tracked as "changed" for a future save.
        const changedInvoiceFieldsToSave = new Set();
        for (const prop of _changedInvoiceFields) {
            const f = HEADER_FIELDS.find(hf => hf.prop === prop);
            if (f && targetKeys.has(f.key)) changedInvoiceFieldsToSave.add(prop);
        }
        const ITEM_FIELD_KEY_SUFFIX = { description: 'Desc', quantity: 'Qty', unitPrice: 'Price', taxRate: 'Tax', amount: 'Amt' };
        const changedItemFieldsToSave = new Map(); // itemIdx -> Set<prop>
        for (const [itemIdx, propSet] of _changedItemFields) {
            for (const prop of propSet) {
                const suffix = ITEM_FIELD_KEY_SUFFIX[prop];
                const key = suffix ? `Item_${itemIdx}_${suffix}` : null;
                if (key && targetKeys.has(key)) {
                    if (!changedItemFieldsToSave.has(itemIdx)) changedItemFieldsToSave.set(itemIdx, new Set());
                    changedItemFieldsToSave.get(itemIdx).add(prop);
                }
            }
        }

        try {
            // Append new edits to the existing edit history (as a JSON array)
            // Only append fields being saved this call
            _currentInvoice.invoiceEdits = appendPendingEditsToHistory(
               _originalInvoiceEditsJson,
                _editingInvoiceEdits,
                changedInvoiceFieldsToSave,
                _currentInvoice
            );

            // For item edits, do the same
            for (let i = 0; i < (_currentInvoice.items ?? []).length; i++) {
               const item = _currentInvoice.items[i];
               const originalItemJson = _originalItemEditsJson.get(i) || '[]';
               const editingItemMap = _editingItemEdits.get(i) || new Map();
               const changedItemFieldSet = changedItemFieldsToSave.get(i) || new Set();
               item.itemEdits = appendPendingEditsToHistory(
                    originalItemJson,
                    editingItemMap,
                    changedItemFieldSet,
                    item
                );
            }

            const result = await postJson('/home/saveinvoiceedits',
                    { filePath: _currentFilePath, edits: _currentInvoice.invoiceEdits, invoiceItems: _currentInvoice.items });
            if (result.success) {
               // Move only the saved fields from pending to persisted (three-state model)
               for (const fieldKey of targetKeys) {
                   _persistedEdits.add(fieldKey);
                   _pendingEdits.delete(fieldKey);
               }

               // Advance the committed-values baseline to what was just saved, so
               // the blur handler's pending-detection compares against the new
               // database state rather than the pre-save one.
               for (const prop of changedInvoiceFieldsToSave) {
                   const f = HEADER_FIELDS.find(hf => hf.prop === prop);
                   if (f) _committedValues.set(f.key, String(_editingInvoiceEdits.get(prop)));
               }
               for (const [itemIdx, propSet] of changedItemFieldsToSave) {
                   const editingItemMap = _editingItemEdits.get(itemIdx);
                   for (const prop of propSet) {
                       const suffix = ITEM_FIELD_KEY_SUFFIX[prop];
                       if (suffix) _committedValues.set(`Item_${itemIdx}_${suffix}`, String(editingItemMap?.get(prop)));
                   }
               }

               // Advance the "base" history to what was just saved, and clear
               // changed-field tracking for the fields just saved. This makes
               // it safe to call savePendingEdits() again later in the same
               // session (e.g. a second field save or a later Accept) WITHOUT
               // requiring an invoice reload in between - otherwise a later
               // call would rebuild history from a stale base and silently
               // drop the edits just appended here.
               _originalInvoiceEditsJson = _currentInvoice.invoiceEdits;
               (_currentInvoice.items ?? []).forEach((item, i) => {
                   _originalItemEditsJson.set(i, item.itemEdits);
               });
               for (const prop of changedInvoiceFieldsToSave) _changedInvoiceFields.delete(prop);
               for (const [itemIdx, propSet] of changedItemFieldsToSave) {
                   const existing = _changedItemFields.get(itemIdx);
                   if (existing) {
                       for (const prop of propSet) existing.delete(prop);
                       if (existing.size === 0) _changedItemFields.delete(itemIdx);
                   }
               }

               // Apply updated styling to all fields
               refreshSavedFieldStyling();
               // Also redraw the bbox overlay to show correct borders
               renderBboxOverlay();
            } else {
               // Restore original edit strings so further edits still work
               _currentInvoice.invoiceEdits = savedInvoiceEdits;
               (_currentInvoice.items ?? []).forEach((item, i) => { item.itemEdits = savedItemEdits[i]; });
            }
            return result;
        } catch (err) {
            // Restore original edit strings so further edits still work
            _currentInvoice.invoiceEdits = savedInvoiceEdits;
            (_currentInvoice.items ?? []).forEach((item, i) => { item.itemEdits = savedItemEdits[i]; });
            return { success: false, error: err.message };
        }
    }

    // Saves ALL currently pending (unsaved/green) edits. Used by
    // acceptValidation(). (A single field can also be saved directly via
    // the field context menu's "Mark as Validated" button, which calls
    // savePendingEdits() with just that one field key.)
    async function saveAllPendingEdits() {
        return savePendingEdits();
    }

    // Convert object/array to JSON string (for sending to API)
    // Note: Edit serialization is now handled separately by appendPendingEditsToHistory()
    // function toJsonString(value) {
    //     if (value === null || value === undefined) {
    //         return null;
    //     }

    //     // If it's already a string, return it
    //     if (typeof value === 'string') {
    //         return value;
    //     }

    //     // Normal case
    //     return JSON.stringify(value);
    // }

    // Parse a JSON string (either new FieldEdit format or legacy array-of-pairs) back into a Map
    function parseEditsMap(str) {
        if (!str) return new Map();
        try {
            const parsed = JSON.parse(str);
            
            // Check if it's new format: array of objects with fieldName/value.
            // userName/timestampUtc are for reporting only, not required here.
            if (Array.isArray(parsed) && parsed.length > 0) {
                const firstItem = parsed[0];
                if (typeof firstItem === 'object' && 'fieldName' in firstItem) {
                    // New format: convert FieldEdit array to Map
                    const map = new Map();
                    for (const edit of parsed) {
                        // History stores PascalCase fieldName (e.g. "VendorName",
                        // "UnitPrice") to match the C# model, but every consumer of
                        // this Map (editing maps, persisted-edit tracking, JSON
                        // export) expects camelCase property names. Normalize here
                        // so callers don't have to special-case the casing.
                        // Latest edit for each field wins.
                        map.set(toCamelCase(edit.fieldName), edit.value);
                    }
                    return map;
                } else if (Array.isArray(firstItem) && firstItem.length >= 2) {
                    // Legacy format: array of pairs. Normalize keys too, in case
                    // any legacy data was ever written with PascalCase keys.
                    const map = new Map();
                    for (const [k, v] of parsed) {
                        map.set(toCamelCase(k), v);
                    }
                    return map;
                }
            }
            
            return new Map();
        } catch {
            return new Map();
        }
    }

