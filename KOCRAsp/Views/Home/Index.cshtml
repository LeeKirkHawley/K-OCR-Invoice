    async function loadDocumentPages(filePath) 
    {
        const container = document.getElementById('viewerPagesContainer');
        const msg       = document.getElementById('noDocMsg');
        const toolbar   = document.getElementById('viewerToolbar');

        container.innerHTML   = '';
        msg.style.display     = 'none';
        toolbar.style.display = '';

        try 
        {
            const resp = await fetch('/api/pages?path=' + encodeURIComponent(filePath));
            if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
            const paths = await resp.json();

            if (!paths || !paths.length) 
            {
                msg.style.display     = '';
                toolbar.style.display = 'none';
                return;
            }

            const multiPage = paths.length > 1;
            paths.forEach((pagePath, idx) => 
            {
                const pageNum  = idx + 1;
                const pageWrap = document.createElement('div');
                pageWrap.className = 'viewer-page-wrap';

                if (multiPage) 
                {
                    const lbl = document.createElement('div');
                    lbl.className   = 'viewer-page-label';
                    lbl.textContent = `Page ${pageNum}`;
                    pageWrap.appendChild(lbl);
                }

                const imgWrap = document.createElement('div');
                imgWrap.className    = 'viewer-img-wrap';
                imgWrap.style.width  = _viewerZoomPct + '%';
                imgWrap.dataset.page = pageNum;

                const img = document.createElement('img');
                img.className = 'viewer-page-img';
                img.alt       = `Page ${pageNum}`;
                img.loading   = 'lazy';
                img.src       = '/api/image?path=' + encodeURIComponent(pagePath);
                img.onload = () => 
                {
                    if (idx === 0) { _viewerZoomPct = 100; applyViewerZoom(); }
                    renderBboxOverlayForPage(pageNum);
                };
                img.onerror = () => { imgWrap.style.opacity = '0.3'; };

                imgWrap.appendChild(img);
                pageWrap.appendChild(imgWrap);
                container.appendChild(pageWrap);
            });
        } 
        catch (err) 
        {
            showToast('Failed to load pages: ' + err.message, 'error');
            msg.style.display     = '';
            toolbar.style.display = 'none';
        }
    }

    function renderInvoiceFields(inv) 
    {
        const container = document.getElementById('invoiceFields');
        const hasTaxData = inv.items?.some(item => item.taxRate);


        // Store the original edit history JSON and initialize editing Maps
        _originalInvoiceEditsJson = inv.invoiceEdits || '[]';
        _editingInvoiceEdits = parseEditsMap(inv.invoiceEdits);  // Always reinitialize (fresh Map even if no edits)
        
        _originalItemEditsJson.clear();
        _editingItemEdits.clear();
        _changedInvoiceFields.clear();  // Clear tracking of user changes
        _changedItemFields.clear();     // Clear tracking of user changes to items

        _originalValues.clear();  // Clear and rebuild original values map for this invoice
        _committedValues.clear(); // Clear and rebuild committed (DB) values map for this invoice
        _pendingEdits.clear();
        // Preserve _persistedEdits across invoice reloads

        let html = '<table class="table table-sm invoice-field-table"><tbody>';

        // Build map of original field values from OCR data
        const rawInvoiceData = getOriginalInvoiceLayout();
        if (rawInvoiceData) {
            // Store original header field values
            for (const f of HEADER_FIELDS) {
                const origValue = CaseInsensitivePropertyLookup(rawInvoiceData, f.prop) ?? '';
                _originalValues.set(f.key, String(origValue));
            }
            // Store original item field values
            const items = CaseInsensitivePropertyLookup(rawInvoiceData, 'items') ?? CaseInsensitivePropertyLookup(rawInvoiceData, 'Items') ?? [];
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                _originalValues.set(`Item_${i}_Desc`, String(CaseInsensitivePropertyLookup(item, 'description') ?? ''));
                _originalValues.set(`Item_${i}_Qty`, String(CaseInsensitivePropertyLookup(item, 'quantity') ?? ''));
                _originalValues.set(`Item_${i}_Price`, String(CaseInsensitivePropertyLookup(item, 'unitPrice') ?? ''));
                _originalValues.set(`Item_${i}_Tax`, String(CaseInsensitivePropertyLookup(item, 'taxRate') ?? ''));
                _originalValues.set(`Item_${i}_Amt`, String(CaseInsensitivePropertyLookup(item, 'amount') ?? ''));
            }
        }

        for (const f of HEADER_FIELDS) 
        {
            // Skip Notes field - it's rendered separately as a larger textarea at the bottom
            if (f.key === 'Notes') continue;

            const raw     = inv[f.prop];
            const isNum   = f.prop === 'subtotal' || f.prop === 'totalTax' || f.prop === 'discount'  || f.prop === 'total';
            let value   = isNum ? fmtMoney(raw) : (raw ?? '');
            const suspect = isSuspect(inv, f.key);
            const tipData = buildFieldTooltip(inv, f.key, value);
            const isDateField = f.key === "InvoiceDate" || f.key === "DueDate";

            // look for the field in _editingInvoiceEdits by prop name (camelCase key) - if found, replace the value
            const editedValue = _editingInvoiceEdits.get(f.prop);
            if (editedValue !== undefined) {
                value = editedValue;
            }

            // Track the value currently committed to the database (either the
            // latest saved edit, or the original OCR value if never edited).
            // This is the baseline the blur handler compares against to decide
            // whether a field has unsaved changes - NOT the original OCR value,
            // so that editing back to the original text after a save is still
            // detected as a real (unsaved) change from what's in the database.
            _committedValues.set(f.key, String(value));

            html += `<tr class="inv-field-row${suspect ? ' inv-suspect-row' : ''}" data-fieldkey="${f.key}" data-vtip="${escapeHtml(tipData.value)}" data-vtip-errors="${escapeHtml(tipData.errors.join('\n'))}">
                <td>${escapeHtml(f.label)}</td>
                <td><input class="form-control form-control-sm inv-field${suspect ? ' inv-suspect-input' : ''}"
                type="${isDateField ? 'date' : 'text'}"
                data-field="${f.prop}"
                data-fieldkey="${f.key}"
                value="${escapeHtml(String(value))}" /></td>
                </tr>`;
        }

        html += '</tbody></table>';

        if (inv.items?.length) 
        {
            html += '<h6 class="mt-2">Line Items</h6>';
            html += '<div class="table-responsive li-table-wrap"><table class="table table-sm table-bordered li-table" id="liTable">';
            html += '<colgroup>'
            + '<col class="li-col" id="liColDesc" style="width:40%">'
            + '<col class="li-col" id="liColQty"  style="width:10%">'
            + '<col class="li-col" id="liColUp"   style="width:25%">'
            + (hasTaxData ?'<col class="li-col" id="liColTaxRate"  style="width:5%">' : '')
            + '<col class="li-col" id="liColAmt"  style="width:20%">'
            + '</colgroup>';
            html += '<thead><tr>'
            + '<th class="li-th">Description<span class="li-col-drag" data-col="0"></span></th>'
            + '<th class="li-th">Qty<span class="li-col-drag" data-col="1"></span></th>'
            + '<th class="li-th">Unit Price<span class="li-col-drag" data-col="2"></span></th>'
            + (hasTaxData ? '<th class="li-th">Tax<span class="li-col-drag" data-col="1"></span></th>' : '')
            + '<th class="li-th">Total</th>'
            + '</tr></thead><tbody>';

            for (let i = 0; i < inv.items.length; i++) 
            {
                const item = inv.items[i];
                const fk   = `Item_${i}_Desc`;  // row-level key (bbox linking / row selection)
                // Per-cell field keys so edit/revert/validate act on the exact field, not the whole row
                const fkDesc  = `Item_${i}_Desc`;
                const fkQty   = `Item_${i}_Qty`;
                const fkPrice = `Item_${i}_Price`;
                const fkTax   = `Item_${i}_Tax`;
                const fkAmt   = `Item_${i}_Amt`;


                // suspect fields identified before edits are substituted
                const dSusp = isItemFieldSuspect(inv, item, 'Description', i);
                const qSusp = isItemFieldSuspect(inv, item, 'Quantity',    i);
                const uSusp = isItemFieldSuspect(inv, item, 'UnitPrice',   i);
                const tSusp = isItemFieldSuspect(inv, item, 'TaxRate',     i);
                const aSusp = isItemFieldSuspect(inv, item, 'Amount',      i);
                const dTip = buildItemFieldTooltip(inv, item, 'Description', i, item.description);
                const qTip = buildItemFieldTooltip(inv, item, 'Quantity',    i, item.quantity);
                const uTip = buildItemFieldTooltip(inv, item, 'UnitPrice',   i, item.unitPrice);
                const tTip = buildItemFieldTooltip(inv, item, 'TaxRate',     i, item.taxRate);
                const aTip = buildItemFieldTooltip(inv, item, 'Amount',      i, item.amount);


                const edits = parseEditsMap(item.itemEdits);
                // Save the original item edit history JSON and populate editing Map
                _originalItemEditsJson.set(i, item.itemEdits || '[]');
                _editingItemEdits.set(i, edits);  // Store the parsing Map for this item
                // Keep item.itemEdits as JSON string always - do NOT store the Map back
                const description = edits.get('description') ?? item.description;
                const quantity = edits.get('quantity') ?? item.quantity;
                const unitPriceValue = edits.get('unitPrice') ?? item.unitPrice;
                const taxRate = edits.get('taxRate') ?? item.taxRate;
                const amountValue = edits.get('amount') ?? item.amount;

                const vtip = t => `data-vtip="${escapeHtml(t.value)}" data-vtip-errors="${escapeHtml(t.errors.join('\n'))}"`;
                const sc = f => f ? ' inv-suspect-input' : '';
                const unitPrice = fmtMoney(unitPriceValue);
                const amount    = fmtMoney(amountValue);

                // Track the values currently committed to the database for this
                // item (either the latest saved edit, or the original OCR value
                // if never edited) - see header-field comment above for why the
                // blur handler compares against these rather than the original.
                _committedValues.set(fkDesc,  String(description ?? ''));
                _committedValues.set(fkQty,   String(quantity ?? ''));
                _committedValues.set(fkPrice, String(unitPrice));
                _committedValues.set(fkTax,   String(taxRate ?? ''));
                _committedValues.set(fkAmt,   String(amount));

                const currencyClass = f => CURRENCY_FIELDS.includes(f) ? ' currency-input' : '';
                html += `<tr class="inv-field-row${(dSusp || qSusp || uSusp || aSusp) ? ' inv-suspect-row' : ''}" data-fieldkey="${fk}">
                <td><input class="form-control form-control-sm inv-field${sc(dSusp)}" ${vtip(dTip)} data-item-idx="${i}" data-field="description" data-fieldkey="${fkDesc}" value="${escapeHtml(description ?? '')}" /></td>
                <td><input class="form-control form-control-sm inv-field${sc(qSusp)}" ${vtip(qTip)} data-item-idx="${i}" data-field="quantity"    data-fieldkey="${fkQty}" value="${quantity ?? ''}" /></td>
                <td><input class="form-control form-control-sm inv-field${sc(uSusp)}${currencyClass('unitPrice')}" ${vtip(uTip)} data-item-idx="${i}" data-field="unitPrice"   data-fieldkey="${fkPrice}" value="${escapeHtml(unitPrice)}" /></td>
                ${hasTaxData ? `<td><input class="form-control form-control-sm inv-field${sc(uSusp)}" ${vtip(tTip)} data-item-idx="${i}" data-field="taxRate" data-fieldkey="${fkTax}" value="${escapeHtml(taxRate)}" /></td>` : ''}
                <td><input class="form-control form-control-sm inv-field${sc(aSusp)}" ${vtip(aTip)} data-item-idx="${i}" data-field="amount"      data-fieldkey="${fkAmt}" value="${escapeHtml(amount)}" /></td>
                </tr>`;
            }
            
            html += '</tbody></table></div>';
        }

        html += `<div class="mt-3">
        <label class="form-label form-label-sm mb-1" for="notesField">Notes</label>
        <textarea id="notesField" class="form-control form-control-sm inv-field" rows="3"
        style="resize:vertical;overflow-y:auto"
        tabindex="-1"
        data-field="notes"
        data-fieldkey="Notes">${escapeHtml(inv.notes ?? '')}</textarea>
        </div>`;

        html += `<div class="d-flex gap-2 mt-2 flex-wrap">`;

        const role = "@User.ActiveOrganizationRole()";
        console.log(role);

        if (role === "OrganizationAdmin" || role === "OrganizationValidator")
        {
            @Html.Raw("html += `<button id=\"acceptBtn\" class=\"btn btn-sm btn-success\" tabindex=\"-1\">Accept</button>`;");
        };
        html += `</div>`;

        container.innerHTML = html;

        // Wire up button event handlers after DOM insertion
        // NOTE: There is no standalone Save button - Accept persists all
        // pending edits to the database itself (see acceptValidation()).
        const acceptBtnEl = container.querySelector('#acceptBtn');
        if (acceptBtnEl) {
            acceptBtnEl.addEventListener('click', () => acceptValidation());
        }

        initLiColResize();

        const allInputs = Array.from(container.querySelectorAll('.inv-field'));
        allInputs.forEach((input, idx) => 
        {
            // NOTE: Stashing edits (formatting, validation, map updates, styling)
            // happens on 'blur' rather than 'input' so that reformatting/validation
            // doesn't run on every keystroke (which corrupted cursor position and
            // caused stale/duplicate map entries while typing). Character-level
            // handling is still needed for currency fields only, and is done via
            // the 'keypress' listener below.
            input.addEventListener('blur', (event) => 
            {
                const control = event.target;
                const itemIdx = input.dataset.itemIdx;
                const field   = input.dataset.field;
                const fieldKey = input.dataset.fieldkey;

                if (itemIdx !== undefined) 
                {
                    const i = parseInt(itemIdx);
                    if (_currentInvoice?.items?.[i] != null) 
                    {
                        let value = ITEM_MONEY_FIELDS.has(field) ? fmtMoney(input.value) : input.value;
                        
                        // Validate currency fields
                        if (CURRENCY_FIELDS.includes(field) && value) {
                            const validation = validateCurrencyInput(value, field, i);
                            if (!validation.isValid) {
                                showToast(validation.error, 'error');
                                input.value = _originalValues.get(fieldKey) ?? '';
                                value = input.value;
                            }
                        }
                        
                        input.value = value;
                        _currentInvoice.items[i][field] = value;
                        
                        // Update the editing Map and track that this field was changed
                        if (!_editingItemEdits.has(i)) {
                            _editingItemEdits.set(i, new Map());
                        }
                        _editingItemEdits.get(i).set(field, value);
                        
                        // Track that user changed this field
                        if (!_changedItemFields.has(i)) {
                            _changedItemFields.set(i, new Set());
                        }
                        _changedItemFields.get(i).add(field);
                        
                        // Three-state model: track pending edits (unsaved). Compare
                        // against the last value committed (saved) to the database -
                        // NOT the original OCR value - so that editing a field back
                        // to its original text after a save is still recognized as a
                        // real, unsaved change from what's currently in the database.
                        // (Explicitly reverting via the "Revert Edits" context menu
                        // item is the only place that intentionally discards edits
                        // without creating a new saved history entry.)
                        if (value !== _committedValues.get(fieldKey)) 
                        {
                            _pendingEdits.add(fieldKey);
                            _persistedEdits.delete(fieldKey);  // Reverts persisted status when field is edited
                        } 
                        else 
                        {
                            _pendingEdits.delete(fieldKey);  // Matches what's already saved (or never edited) - nothing to save
                        }

                        refreshSavedFieldStyling();
                    }
                } 
                else 
                {
                    const value = HEADER_MONEY_FIELDS.has(field) ? fmtMoney(input.value) : input.value;
                    input.value = value;

                    // Update the editing Map and track that this field was changed
                    _editingInvoiceEdits.set(field, value);
                    _changedInvoiceFields.add(field);  // Track that user changed this field

                    // Three-state model: track pending edits (unsaved). Compare
                    // against the last value committed (saved) to the database -
                    // NOT the original OCR value - so that editing a field back
                    // to its original text after a save is still recognized as a
                    // real, unsaved change from what's currently in the database.
                    // (Explicitly reverting via the "Revert Edits" context menu
                    // item is the only place that intentionally discards edits
                    // without creating a new saved history entry.)
                    if (value !== _committedValues.get(fieldKey)) 
                    {
                        _pendingEdits.add(fieldKey);
                        _persistedEdits.delete(fieldKey);  // Reverts persisted status when field is edited
                    } 
                    else 
                    {
                        _pendingEdits.delete(fieldKey);  // Matches what's already saved (or never edited) - nothing to save
                    }

                    refreshSavedFieldStyling();
                }
            });
            input.addEventListener('focus', () => selectField(input.dataset.fieldkey));
            
            // For currency fields, filter out invalid characters in real-time
            if (CURRENCY_FIELDS.includes(input.dataset.field)) {
                input.addEventListener('keypress', (e) => {
                    const char = e.key;
                    // Allow: digits, decimal point, comma, minus sign, parentheses
                    if (!/[\d.,\-()]/.test(char)) {
                        e.preventDefault();
                        // Only show one toast per 500ms
                        if (!_currencyErrorThrottleTimer) {
                            const fieldName = input.dataset.field;
                            const itemIdx = input.dataset.itemIdx;
                            const msg = itemIdx !== undefined 
                                ? `Invalid currency: ${fieldName} (Line Item ${parseInt(itemIdx) + 1})` 
                                : `Invalid currency: ${fieldName}`;
                            showToast(msg, 'error');
                            _currencyErrorThrottleTimer = setTimeout(() => {
                                _currencyErrorThrottleTimer = null;
                            }, 500);
                        }
                    }
                });
            }
            
            input.addEventListener('keydown', e => {
                if (e.key !== 'Tab') return;
                if (!e.shiftKey && idx === allInputs.length - 1) 
                {
                    e.preventDefault();
                    allInputs[0].focus();
                } 
                else if (e.shiftKey && idx === 0) 
                {
                    e.preventDefault();
                    allInputs[allInputs.length - 1].focus();
                }
            });
        });
    
        container.querySelectorAll('.inv-field-row').forEach(row => {
            row.addEventListener('click', () => selectField(row.dataset.fieldkey));
        });

        renderBboxOverlay();

        // Load persisted edits from database so a reload shows blue borders 
        // without requiring a new save in this session.
        // NOTE: Accepting the invoice (isInvoiceAccepted) does NOT mark every
        // field as persisted - only fields with actual saved edits are blue.
        // The invoice-level accepted state is shown separately via the
        // "Validated"/"Not Validated" label at the top of the panel.
        for (const [k] of _editingInvoiceEdits) {
            const f = HEADER_FIELDS.find(hf => hf.prop === k);
            if (f) _persistedEdits.add(f.key);
        }
        // Map item property names to the field-key suffix used on each <input>
        const ITEM_FIELD_KEY_SUFFIX = {
            description: 'Desc',
            quantity:    'Qty',
            unitPrice:   'Price',
            taxRate:     'Tax',
            amount:      'Amt'
        };
        // For item edits, mark the item's field keys as persisted
        (inv.items ?? []).forEach((item, i) => {
            for (const [k] of parseEditsMap(item.itemEdits)) {
                const suffix = ITEM_FIELD_KEY_SUFFIX[k];
                if (suffix) _persistedEdits.add(`Item_${i}_${suffix}`);
            }
        });
        refreshSavedFieldStyling();

        // Auto-select first field
        const firstInput = container.querySelector('.inv-field');
        if (firstInput) 
        {
            firstInput.focus();
        } 
        else 
        {
        selectField(HEADER_FIELDS[0].key);
        }
    }


    function renderRunOcrButton(filePath, exceedsLimit) 
    {
        const container = document.getElementById('invoiceFields');
        const btn = document.createElement('button');
        btn.id = 'runOcrBtn';
        configureRunOcrButton(btn, filePath, exceedsLimit);
        container.appendChild(btn);
    }

    function isFileOverPageLimit(filePath) 
    {
        const item = findFileListItem(filePath);
        return item?.dataset.exceedsLimit === 'true';
    }

    function getRunOcrButtonState(filePath, exceedsLimit) 
    {
        if (_isBetaTestOrganization && _betaLimitExceeded) 
        {
            return {
                className: 'btn btn-sm btn-secondary mt-2',
                disabled: true,
                title: `Beta OCR page limit reached (${_betaUsedPages}/${_betaMaxPages}).`,
            };
        }

        if (exceedsLimit) 
        {
            return {
                className: 'btn btn-sm btn-secondary mt-2',
                disabled: true,
                title: `This invoice exceeds the ${_maxPagesPerInvoice}-page limit and cannot be OCR'd.`,
            };
        }

        if (isFileQueued(filePath)) 
        {
            return {
                className: 'btn btn-sm btn-secondary mt-2',
                disabled: true,
                title: 'This invoice is already queued for OCR.',
            };
        }

        return {
            className: 'btn btn-sm btn-primary mt-2',
            disabled: false,
            title: '',
        };
    }

    function configureRunOcrButton(btn, filePath, exceedsLimit) 
    {
        if (!btn) return;
        const state = getRunOcrButtonState(filePath, exceedsLimit);
        btn.className = state.className;
        btn.textContent = '▶ OCR This Invoice';
        btn.dataset.queueToggle = 'true';
        btn.disabled = state.disabled;
        btn.title = state.title;
        btn.onclick = () => runOcrOnFile(filePath, btn);
    }

    async function runOcrOnFile(filePath, btn) {
        // Prevent duplicate calls if button is already loading
        if (btn && btn.disabled) return;
        
        if (_isBetaTestOrganization && _betaLimitExceeded) {
            showBetaDialog(`This beta-test organization has reached its OCR limit (${_betaUsedPages}/${_betaMaxPages} pages). Uploads and OCR are disabled.`);
            return;
        }

        if (isFileQueued(filePath)) {
            showToast('This invoice is already queued for OCR.', 'warning');
            return;
        }
        if (btn) setButtonLoading(btn, true);
        try {
            const fd = new FormData();
            fd.append('filePath', filePath);
            const result = await postForm('/home/startocr', fd);
            setBetaLimitStateFromServer(result);
            if (result.pageLimitExceeded) {
                clearFileQueued(filePath);
                markQueueIndicators();
                showToast(result.error ?? 'Invoice exceeds page limit.', 'error');
                if (btn) setButtonLoading(btn, false);
                return;
            }
            if (result.betaLimitExceeded) {
                showBetaDialog(`This beta-test organization has reached its OCR limit (${_betaUsedPages}/${_betaMaxPages} pages). Uploads and OCR are disabled.`);
            }
            if (result.success && result.queued) {
                markFileQueued(result.filePath ?? filePath);
                showToast('OCR queued.');
                if (btn) setButtonLoading(btn, false);
                return;
            }
            if (result.success && result.invoice) {
                clearFileQueued(filePath);
                markQueueIndicators();
                _currentInvoice = result.invoice;
                // Clear original edit maps before loading new invoice
                _originalItemEditsJson.clear();
                attachValidation(_currentInvoice);
                renderInvoiceFields(result.invoice);
                updateValidationStatusLabel(result.invoice);
                updateViewerCurrencyLabel(result.invoice);
                document.getElementById('validatedJsonContent').textContent = '';
                document.getElementById('rawJsonContent').textContent =
                    JSON.stringify(stripBboxFields(result.invoice), null, 2);
                await refreshFileList();
                showToast('OCR complete.');
            } else {
                clearFileQueued(filePath);
                markQueueIndicators();
                showToast(result.error ?? 'OCR failed.', 'error');
                if (btn) setButtonLoading(btn, false);
            }
        } catch (err) {
            clearFileQueued(filePath);
            markQueueIndicators();
            showToast('OCR error: ' + err.message, 'error');
            if (btn) setButtonLoading(btn, false);
        }
    }

    async function loadFieldRegistry() {
        try {
            const result = await fetch('/home/getfieldregistry');
            const data = await result.json();
            HEADER_FIELDS = data.headerFields.map(f => ({
                key: f.key,
                label: f.label,
                prop: f.propertyNameCamelCase
            }));
            // ITEM_FIELDS = data.itemFields.map(f => ({
            //     propertyName: f.propertyName,
            //     propertyNameCamelCase: f.propertyNameCamelCase,
            //     label: f.label,
            //     fieldType: f.fieldType,
            //     itemFieldSuffix: f.itemFieldSuffix
            // }));
            HEADER_MONEY_FIELDS = new Set(
                data.moneyPropertyNames.filter(p => ['subtotal', 'totalTax', 'discount', 'total'].includes(p))
            );
            ITEM_MONEY_FIELDS = new Set(
                data.moneyPropertyNames.filter(p => ['unitPrice', 'amount'].includes(p))
            );
        } catch (err) {
            console.error('Failed to load field registry:', err);
        }
    }

    function stripCurrencySymbols(v) {
        return String(v ?? '')
            .replace(/[^\d.,\-()]/g, '')
            .trim();
    }

    function fmtMoney(v) {
        const stripped = stripCurrencySymbols(v);
        if (!stripped) return '';
        const n = Number(stripped.replace(/,/g, ''));
        return Number.isFinite(n) ? n.toFixed(2) : stripped;
    }

    function validateCurrencyInput(value, fieldName, itemIndex) {
        const stripped = stripCurrencySymbols(value);
        if (!stripped) {
            return { isValid: true };  // Empty is allowed
        }
        const n = Number(stripped.replace(/,/g, ''));
        if (!Number.isFinite(n)) {
            let errorMsg = `Invalid currency: ${fieldName}`;
            if (itemIndex !== undefined) {
                errorMsg = `Invalid currency: ${fieldName} (Line Item ${itemIndex + 1})`;
            }
            return { 
                isValid: false, 
                error: errorMsg
            };
        }
        return { isValid: true };
    }

    function showUploadOverlay(label) {
        const overlay = document.getElementById('uploadOverlay');
        const labelEl = overlay.querySelector('.ocr-overlay-label');
        if (labelEl) labelEl.textContent = label || 'Uploading...';
        overlay.classList.add('active');
    }

    function hideUploadOverlay() {
        const overlay = document.getElementById('uploadOverlay');
        overlay.classList.remove('active');
        const labelEl = overlay.querySelector('.ocr-overlay-label');
        if (labelEl) labelEl.textContent = 'Uploading...'; // reset to default for next use
    }

    function updateValidationStatusLabel(inv) {
        const el = document.getElementById('validationStatusLabel');
        if (!el) return;
        if (!inv) {
            el.textContent = '';
            el.className = 'validation-status-label';
            return;
        }
        if (inv.isInvoiceAccepted) {
            el.textContent = 'Validated';
            el.className = 'validation-status-label is-validated';
        } else {
            el.textContent = 'Not Validated';
            el.className = 'validation-status-label is-not-validated';
        }
    }

    function updateViewerCurrencyLabel(inv) {
        const el = document.getElementById('viewerCurrencyLabel');
        if (!el) return;

        const code = String(inv?.currencyCode ?? '').trim().toUpperCase();
        if (!code) {
            el.style.display = '';
            el.textContent = 'CUR: -';
            return;
        }

        const shortCode = code.length >= 2 ? code.slice(0, 2) : code;
        el.textContent = `CUR: ${shortCode}`;
        el.style.display = '';
    }

    // ── Two-way field / bbox highlighting ──────────────────────────────────────

    function selectField(key) 
    {
        _selectedFieldKey = key;

        // Update SVG polygon classes across all pages
        if (_currentInvoice) {
            document.querySelectorAll('.viewer-bbox').forEach(poly => 
            {
                const fk = poly.dataset.fieldkey ?? '';
                poly.classList.remove('bbox-ok', 'bbox-suspect', 'bbox-selected');
                if (fk === key) 
                {
                    poly.classList.add('bbox-selected');
                } 
                else if (fk.startsWith('Item_')) 
                {
                    const itemIdx = parseInt(fk.split('_')[1]);
                    const keyPfx  = `Item_${itemIdx}_`;
                    const item    = _currentInvoice.items?.[itemIdx];
                    if (key && key.startsWith(keyPfx)) 
                    {
                        poly.classList.add('bbox-selected');
                    } 
                    else 
                    {
                        poly.classList.add(item && isItemSuspect(_currentInvoice, item, itemIdx) ? 'bbox-suspect' : 'bbox-ok');
                    }
                } 
                else 
                {
                    poly.classList.add(isSuspect(_currentInvoice, fk) ? 'bbox-suspect' : 'bbox-ok');
                }
            });
        }

        // Highlight field row in validation panel
        document.querySelectorAll('.inv-field-row').forEach(row => {
            const rk    = row.dataset.fieldkey ?? '';
            const match = rk === key ||
                (key && key.startsWith('Item_') && rk.startsWith('Item_' + key.split('_')[1] + '_'));
            row.classList.toggle('inv-field-selected', match);
        });

        // Scroll selected bbox into view in the viewer
        requestAnimationFrame(() => scrollBboxIntoView());

        // Scroll matching field row into view in the panel
        requestAnimationFrame(() => {
            const row = document.querySelector(`.inv-field-row[data-fieldkey="${CSS.escape(key)}"]`);
            if (row) row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
    }

    function renderBboxOverlay() 
    {
        document.querySelectorAll('.viewer-bbox-overlay').forEach(s => s.remove());
        if (!_currentInvoice) return;
        document.querySelectorAll('.viewer-img-wrap[data-page]').forEach(wrap => {
            renderBboxOverlayForPage(parseInt(wrap.dataset.page), wrap);
        });
    }

    function renderBboxOverlayForPage(pageNum, wrap) 
    {
        if (!wrap) wrap = document.querySelector(`.viewer-img-wrap[data-page="${pageNum}"]`);
        if (!wrap || !_currentInvoice) return;

        wrap.querySelector('.viewer-bbox-overlay')?.remove();

        if(!_ocrLoaded)
            return;

        const invoice = _currentInvoice;
        const pageWidth  = invoice.originalPageWidth;
        const pageHeight = invoice.originalPageHeight;
        if (!pageWidth || !pageHeight) return;

        const bboxes = invoice.fieldBoundingBoxes ?? {};
        const lineItems  = invoice.items ?? [];
        const nameSpace     = 'http://www.w3.org/2000/svg';
        const svg    = document.createElementNS(nameSpace, 'svg');
        svg.setAttribute('viewBox', `0 0 ${pageWidth} ${pageHeight}`);
        svg.classList.add('viewer-bbox-overlay');

        let hasAny = false;

        for (const [key, boxList] of Object.entries(bboxes)) 
        {
            for (const box of boxList) 
            {
                if ((box.pageNumber ?? 1) !== pageNum) continue;
                const points = box.points;
                if (!points || points.length < 4) continue;
                hasAny = true;
                const poly = document.createElementNS(nameSpace, 'polygon');
                poly.setAttribute('points', formatBboxPoints(points));
                poly.dataset.fieldkey    = key;
                poly.style.pointerEvents = 'all';
                poly.style.cursor        = 'pointer';
                poly.classList.add('viewer-bbox');

        // this block adds the colored border to the polygon based on its state (selected, saved, suspect, ok)
                // In validation panel: selected > saved/approved/edited > suspect > ok
                // poly.classList.add(_selectedFieldKey === key ? 'bbox-selected'
                //                  : _savedFieldKeys.has(key) || _editedFieldKeys.has(key) || invoice.isInvoiceAccepted ? 'bbox-saved'
                //                  : isSuspect(invoice, key)       ? 'bbox-suspect'
                //                  :                             'bbox-ok');

         // this line adds the colored border to the one selected field.
                poly.addEventListener('click', e => { e.stopPropagation(); selectField(key); });

                svg.appendChild(poly);
            }
        }

        for (let i = 0; i < lineItems.length; i++) 
        {
            const item   = lineItems[i];
            const key    = `Item_${i}_Desc`;
            const prefix = `Item_${i}_`;
            for (const box of (item.boundingBoxes ?? [])) 
            {
                if ((box.pageNumber ?? 1) !== pageNum) continue;
                const pts = box.points;
                if (!pts || pts.length < 4) continue;
                hasAny = true;
                const poly = document.createElementNS(nameSpace, 'polygon');
                poly.setAttribute('points', formatBboxPoints(pts));
                poly.dataset.fieldkey    = key;
                poly.style.pointerEvents = 'all';
                poly.style.cursor        = 'pointer';
                poly.classList.add('viewer-bbox');

        // this block adds the colored border to the polygon based on its state (selected, saved, suspect, ok)
                // In validation panel: selected > saved/approved/edited > suspect > ok
                // poly.classList.add((_selectedFieldKey && _selectedFieldKey.startsWith(prefix)) ? 'bbox-selected'
                //                  : _savedFieldKeys.has(key) || _editedFieldKeys.has(key) || invoice.isInvoiceAccepted ? 'bbox-saved'
                //                  : isItemSuspect(invoice, item, i)                                 ? 'bbox-suspect'
                //                  :                                                              'bbox-ok');

        // this line adds the colored border to the one selected field.
                poly.addEventListener('click', e => { e.stopPropagation(); selectField(key); });

                svg.appendChild(poly);
            }
        }

        if (hasAny) wrap.appendChild(svg);
    }

    function scrollBboxIntoView() 
    {
        const polygon  = document.querySelector('.viewer-bbox.bbox-selected');
        const scroller = document.getElementById('viewerScroll');
        if (!polygon || !scroller) 
            return;
        const pr = polygon.getBoundingClientRect();
        const sr = scroller.getBoundingClientRect();
        const targetTop  = scroller.scrollTop  + (pr.top  + pr.height / 2 - sr.top)  - sr.height / 2;
        const targetLeft = scroller.scrollLeft + (pr.left + pr.width  / 2 - sr.left) - sr.width  / 2;
        scroller.scrollTo({ top: targetTop, left: targetLeft, behavior: 'smooth' });
    }

    function formatBboxPoints(pts) 
    {
        const pairs = [];
        
        for (let j = 0; j + 1 < pts.length; j += 2) 
        {
            pairs.push(`${pts[j]},${pts[j + 1]}`);
        }

        return pairs.join(' ');
    }

    // Mirrors LineItemValidationService — computes math pass/fail from raw invoice values.
    // Returns a dict keyed the same way as the old server-side MathConfirmed.
    function computeMathConfirmed(invoice) 
    {
        const TOL = 0.02;
        const mc = {};

        // Line items: qty × unitPrice (± tax) ≈ amount
        const items = invoice.items ?? [];
        for (let i = 0; i < items.length; i++) {
            const it = items[i];
            if (it.quantity != null && it.unitPrice != null && it.amount != null) 
            {
                let expected = it.quantity * it.unitPrice;
                const tr = it.taxRate;
                if (tr && tr.includes('%')) 
                {
                    const pct = parseFloat(tr.replace('%', ''));
                    if (!isNaN(pct)) {
                        const tax = expected * (pct / 100);
                        expected = expected + tax;
                    }
                }
                mc[`LineItem[${i}].Amount`] = Math.abs(expected - it.amount) <= TOL;
            }
        }

        // Subtotal: sum of line item amounts ≈ subtotal
        const lineAmounts = items.filter(it => it.amount != null).map(it => it.amount);
        if (lineAmounts.length > 0 && invoice.subtotal != null) {
            const sum = lineAmounts.reduce((a, b) => a + b, 0);
            mc['Subtotal'] = Math.abs(sum - invoice.subtotal) <= TOL;
        }

        // Total: subtotal + totalTax − discount ≈ total
        if (invoice.total != null) {
            let expected = 0;
            if (invoice.subtotal != null) {
                expected += invoice.subtotal;
            } else if (lineAmounts.length > 0) {
                expected += lineAmounts.reduce((a, b) => a + b, 0);
            }
            if (invoice.totalTax  != null) expected += invoice.totalTax;
            if (invoice.discount  != null) expected -= invoice.discount;
            mc['Total'] = Math.abs(expected - invoice.total) <= TOL;
        }

        return mc;
    }

    // Attaches computed validation to an invoice object so all suspect functions
    // use fresh values rather than stale persisted data.
    function attachValidation(inv) {
        inv._mathConfirmed = computeMathConfirmed(inv);
    }

    function isSuspect(inv, key) {
        if (inv.isInvoiceAccepted) return false;
        const tc = inv.tesseractConfirmed;
        const mc = inv._mathConfirmed ?? {};
        const fc = inv.fieldConfidences;
        return (tc && key in tc && tc[key] === false)
            || (mc && key in mc && mc[key] === false)
            || (fc && key in fc && fc[key] < _minConfidenceThreshold);
    }

