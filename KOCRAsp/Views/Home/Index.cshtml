    // Append pending edits to the existing edit history (JSON array)
    // Parameters:
    //   currentHistoryJson: existing history as JSON string (from database)
    //   editsMap: Map<string, string> with current edited values (camelCase keys for headers, item field names for items)
    //   changedFields: Set of fields that the user actually changed in this session
    //   sourceObject: original object (invoice or item) with field properties
    // Returns: updated JSON array string with new edits appended
    function appendPendingEditsToHistory(currentHistoryJson, editsMap, changedFields, sourceObject) {
        // Parse existing history
        let history = [];
        if (currentHistoryJson && typeof currentHistoryJson === 'string') {
            try {
                const parsed = JSON.parse(currentHistoryJson);
                if (Array.isArray(parsed)) {
                    history = parsed;
                }
            } catch (e) {
                console.warn('Failed to parse existing edit history:', e);
            }
        }

        // Determine if this is a header invoice or an item
        const isItem = sourceObject.description !== undefined && sourceObject.quantity !== undefined && 
                       sourceObject.unitPrice !== undefined && sourceObject.amount !== undefined;

        // Only append edits for fields that the user actually changed in this session
        for (const fieldKey of changedFields) {
            // Map camelCase field keys to PascalCase field names for history
            let fieldName = fieldKey;
            let currentValue = editsMap.get(fieldKey);

            if (currentValue !== undefined) {
                // Convert camelCase to PascalCase for history (e.g., 'total' -> 'Total', 'vendorName' -> 'VendorName')
                if (isItem) {
                    // Item fields
                    const pascalMap = {
                        'description': 'Description',
                        'quantity': 'Quantity',
                        'unitPrice': 'UnitPrice',
                        'taxRate': 'TaxRate',
                        'amount': 'Amount'
                    };
                    fieldName = pascalMap[fieldKey] || fieldKey;
                } else {
                    // Invoice header fields
                    const pascalMap = {
                        'vendorName': 'VendorName',
                        'customerName': 'CustomerName',
                        'invoiceId': 'InvoiceId',
                        'invoiceDate': 'InvoiceDate',
                        'dueDate': 'DueDate',
                        'purchaseOrder': 'PurchaseOrder',
                        'subtotal': 'Subtotal',
                        'totalTax': 'TotalTax',
                        'discount': 'Discount',
                        'total': 'Total',
                        'notes': 'Notes'
                    };
                    fieldName = pascalMap[fieldKey] || fieldKey;
                }

                // Always append a new history entry for every field the user
                // changed this session - even if the saved value happens to
                // match an earlier historical entry (e.g. the user typed
                // something then deleted it back to the original text). Each
                // save is a distinct audit event and must be recorded as such;
                // deduping against the last entry would silently drop real
                // edits and let a stale saved value reappear on reload.
                history.push({
                    fieldName: fieldName,
                    value: String(currentValue)
                });
            }
        }

        return JSON.stringify(history);
    }

    // Persists all pending edits and marks the invoice as validated. Blur
    // just tracks edits locally as "pending" (see the .inv-field blur
    // handlers); a single field can also be saved immediately via the field
    // context menu's "Mark as Validated" button (savePendingEdits() with one
    // field key). If nextFilePath is provided (used by the "Changes Not
    // Saved" switch-file dialog), the given file is loaded afterward instead
    // of reloading the current one.
    async function acceptValidation(nextFilePath, nextExceedsLimit) {
        if (!_currentFilePath) return;
        const btn = document.getElementById('acceptBtn');
        setButtonLoading(btn, true);
        try {
            // Flush the currently-focused field (if any) so an in-progress
            // edit that hasn't blurred yet is still captured before saving.
            const active = document.activeElement;
            if (active instanceof HTMLElement && active.classList.contains('inv-field')) {
                active.blur();
            }

            // Persist any pending (unsaved/green) edits before marking the invoice
            // accepted, since there is no separate Save step the user must take first.
            const saveResult = await saveAllPendingEdits();
            if (!saveResult.success) {
                showToast(saveResult.error ?? 'Failed to save pending edits.', 'error');
                return;
            }

            const fd = new FormData();
            fd.append('filePath', _currentFilePath);
            const result = await postForm('/home/acceptvalidation', fd);
            if (result.success) {
                // NOTE: Do NOT mark every field as persisted here - accepting the
                // invoice only changes the top-of-panel "Validated" status label.
                // Field-level blue styling continues to reflect only fields that
                // actually have saved edits (recomputed below from the reloaded invoice).
                showToast('Validation accepted.');
                // Reload invoice to display updated ValidatedOcrText from database
                // and recompute _persistedEdits/_pendingEdits from the saved edit maps.
                await selectFile(nextFilePath ?? _currentFilePath, nextFilePath ? (nextExceedsLimit ?? false) : false);
                await refreshFileList();
                await updateExportButtonState();
            } else {
                showToast(result.error ?? 'Accept failed.', 'error');
            }
        } catch (err) {
            showToast('Accept error: ' + err.message, 'error');
        } finally {
            setButtonLoading(btn, false);
        }
    }

    // function exportDocx(e) {
    //     e.preventDefault();
    //     if (!_currentFilePath) return;
    //     window.location.href = '/home/exportdocx?filePath=' + encodeURIComponent(_currentFilePath);
