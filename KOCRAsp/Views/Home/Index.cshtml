    // "Mark as Validated" on a single field: saves just that field to the
    // database immediately (unlike Accept, which saves all pending edits).
    // This is the one intentional exception to the "only Accept writes to
    // the DB" rule - the user explicitly asked for a per-field save action.
    document.getElementById('fieldMenuAcceptBtn').addEventListener('click', async function () 
    {
        if (!_selectedFieldKey) return;

        // If the field isn't already marked pending (e.g. the user right-clicked
        // without blurring first), check whether its current value differs from
        // what's committed in the database. If so, mark it pending so it gets
        // included in the save below.
        if (!_pendingEdits.has(_selectedFieldKey)) {
            const container = document.getElementById('invoiceFields');
            const input = container?.querySelector(`.inv-field[data-fieldkey="${CSS.escape(_selectedFieldKey)}"]`);
            if (input) {
                const committedValue = _committedValues.get(_selectedFieldKey) ?? '';
                const currentValue = input.value;

                if (currentValue !== committedValue) {
                    _pendingEdits.add(_selectedFieldKey);

                    // Also ensure it's tracked in the changed fields map so
                    // appendPendingEditsToHistory() knows to append it.
                    if (_selectedFieldKey.startsWith('Item_')) {
                        const match = _selectedFieldKey.match(/^Item_(\d+)_(\w+)$/);
                        if (match) {
                            const itemIdx = parseInt(match[1], 10);
                            const suffix = match[2];
                            const propMap = { Desc: 'description', Qty: 'quantity', Price: 'unitPrice', Tax: 'taxRate', Amt: 'amount' };
                            const prop = propMap[suffix];
                            if (prop) {
                                if (!_changedItemFields.has(itemIdx)) _changedItemFields.set(itemIdx, new Set());
                                _changedItemFields.get(itemIdx).add(prop);
                            }
                        }
                    } else {
                        const f = HEADER_FIELDS.find(hf => hf.key === _selectedFieldKey);
                        if (f) _changedInvoiceFields.add(f.prop);
                    }
                } else {
                    // Field matches what's already saved, nothing to do
                    hideFieldContextMenu();
                    return;
                }
            } else {
                hideFieldContextMenu();
                return;
            }
        }

        const result = await savePendingEdits(new Set([_selectedFieldKey]));
        hideFieldContextMenu();
        if (!result.success) {
            showToast(result.error ?? 'Failed to save field.', 'error');
        } else {
            showToast('Field saved.');
        }
    });

    document.getElementById('fieldMenuRevertBtn').addEventListener('click', function () 
    {
        if (!_selectedFieldKey || !_currentInvoice) 
            return;
        
        const container = document.getElementById('invoiceFields');
        const input = container?.querySelector(`.inv-field[data-fieldkey="${CSS.escape(_selectedFieldKey)}"]`);
        
        if (!input) 
            return;

        try {
            // Get the original value from _originalValues (built from raw OCR data)
            const origValueStr = _originalValues.get(_selectedFieldKey);
            if (origValueStr === undefined) {
                showToast('Original OCR data is not available for this field.', 'error');
                return;
            }

            const fieldProp = input.dataset.field; // e.g. 'vendorName' or 'quantity'
            const isMoney = _selectedFieldKey.startsWith('Item_') 
                ? ITEM_MONEY_FIELDS.has(fieldProp)
                : HEADER_MONEY_FIELDS.has(fieldProp);

            if (_selectedFieldKey.startsWith('Item_')) {
                const itemIdx = parseInt(input.dataset.itemIdx, 10);
                const origValue = origValueStr === '' ? undefined : origValueStr;

                // Remove from item edits map and sync the invoice model
                if (_currentInvoice.items?.[itemIdx]) {
                    const itemEdits = parseEditsMap(_currentInvoice.items[itemIdx].itemEdits);
                    itemEdits.delete(fieldProp);
                    _currentInvoice.items[itemIdx].itemEdits = itemEdits;
                    _currentInvoice.items[itemIdx][fieldProp] = origValue;
                }
            } else {
                const origValue = origValueStr === '' ? undefined : origValueStr;

                // Remove from editing edits map, update _editingInvoiceEdits (not _currentInvoice.invoiceEdits)
                _editingInvoiceEdits.delete(fieldProp);
                _currentInvoice[fieldProp] = origValue;
            }
            
            // Set field to original value (or empty string if null/undefined)
            input.value = origValueStr === '' ? '' : (isMoney ? fmtMoney(origValueStr) : origValueStr);
            
            // Remove from state sets
            _pendingEdits.delete(_selectedFieldKey);
            _persistedEdits.delete(_selectedFieldKey);
            
            // Update field styling to reflect reverted state
            refreshSavedFieldStyling();
            
            // Re-check if field is suspect to restore appropriate styling
            renderBboxOverlay();
            
            hideFieldContextMenu();
            showToast('Field reverted to original value.');
        } catch (err) {
            showToast('Failed to revert field: ' + err.message, 'error');
        }
    });

