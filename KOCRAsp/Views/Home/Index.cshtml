    // Tooltip: value on line 1, one validation error per subsequent line.
    function buildFieldTooltip(inv, key, value) {
        const errors = [];
        const tc = inv.tesseractConfirmed;
        const mc = inv._mathConfirmed ?? {};
        const fc = inv.fieldConfidences;
        if (tc && key in tc && tc[key] === false) errors.push('Secondary OCR mismatch');
        if (fc && key in fc && fc[key] < _minConfidenceThreshold) errors.push('Low Azure confidence');
        if (mc && key in mc && mc[key] === false) errors.push('Math error');
        const valueStr = (value !== null && value !== undefined && value !== '') ? String(value) : '—';
        return { value: valueStr, errors };
    }

    function isItemSuspect(inv, item, idx) {
        if (inv.isInvoiceAccepted) return false;
        const tc = item.tesseractConfirmed ?? {};
        const fc = item.fieldConfidences ?? {};
        const mc = inv._mathConfirmed ?? {};
        if (Object.values(tc).some(v => v === false)) return true;
        if (Object.keys(fc).some(k => fc[k] < _minConfidenceThreshold)) return true;
        return mc[`LineItem[${idx}].Amount`] === false;
    }

    function isItemFieldSuspect(inv, item, fieldKey, idx) {
        if (inv.isInvoiceAccepted) return false;
        const tc = item.tesseractConfirmed ?? {};
        const fc = item.fieldConfidences ?? {};
        const mc = inv._mathConfirmed ?? {};
        if (tc[fieldKey] === false) return true;
        if (fieldKey in fc && fc[fieldKey] < _minConfidenceThreshold) return true;
        if (fieldKey === 'Amount') {
            return mc[`LineItem[${idx}].Amount`] === false;
        }
        return false;
    }

