    // Two-phase export:
    //   1. Ask the user where to save FIRST. If they cancel, we never touch
    //      the server and nothing about the batch changes.
    //   2. Ask the server to build the export bytes.
    //   3. Write those bytes to the chosen location. Only once that write
    //      has actually succeeded do we tell the server to confirm the
    //      export (which is what marks the batch for deletion).
    async function _exportAndSave(exportUrl, suggestedName, mimeType, extensions) {
        let handle = null;
        if (window.showSaveFilePicker) {
            try {
                handle = await window.showSaveFilePicker({
                    suggestedName,
                    types: [{ description: mimeType, accept: { [mimeType]: extensions } }]
                });
            } catch (err) {
                if (err.name === 'AbortError') return { saved: false }; // user cancelled
                throw err;
            }
        }

        const response = await fetch(exportUrl, {
            method: 'POST',
            headers: { 'RequestVerificationToken': _antiforgeryToken },
            credentials: 'include'
        });
        if (!response.ok) {
            const msg = await response.text().catch(() => response.statusText);
            throw new Error(msg || response.statusText);
        }
        const blob = await response.blob();

        if (handle) {
            const writable = await handle.createWritable();
            await writable.write(blob);
            await writable.close();
        } else {
            // Browser doesn't support the File System Access API; fall back
            // to a normal browser download (goes to the Downloads folder).
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = suggestedName;
            a.click();
            URL.revokeObjectURL(a.href);
        }

        // The file is now confirmed written to disk — safe to mark the batch
        // for deletion.
        const result = await postForm('/home/confirmbatchexported', new FormData());
        if (!result.success)
            throw new Error(result.error ?? 'Failed to confirm export.');

        return { saved: true };
    }

