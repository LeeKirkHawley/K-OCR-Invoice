@using K_OCRLib.Security
@model KOCRAsp.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Invoice Processing";
    ViewData["MetaDescription"] = "Process invoices, manage batches, and review OCR results in Hardscrabble Invoice.";
    ViewData["FullScreen"] = true;
}

<h1 class="visually-hidden">Invoice Processing</h1>

<div class="kocr-shell" id="kocrShell">

    <!-- ── Left pane: file list ──────────────────────────────────── -->
    <div class="kocr-pane kocr-pane-left">
        <div class="kocr-panel-header kocr-file-list-header p-1">
            <div class="d-flex gap-1 mb-1">
                <button class="btn btn-sm btn-outline-primary py-0 text-nowrap" onclick="openNewBatchModal(); return false;" title="Create new batch">➕ New Batch</button>
                <select id="batchSelector" class="form-select form-select-sm">
                    <option value="">— Select Batch —</option>
                    @foreach (var batch in Model.AvailableBatches)
                    {
                        if (batch.IsMarkedForDeletion)
                        {
                            <option value="@batch.BatchId" disabled
                                    style="text-decoration: line-through; color: gray;">
                                🗑️ @batch.Name (#@batch.BatchNumber)
                            </option>
                        }
                        else if (Model.CurrentBatch?.BatchId == batch.BatchId)
                        {
                            <option value="@batch.BatchId" selected>@batch.Name (#@batch.BatchNumber)</option>
                        }
                        else
                        {
                            <option value="@batch.BatchId">@batch.Name (#@batch.BatchNumber)</option>
                        }
                    }
                </select>
            </div>
            <div class="d-flex gap-1">
                <label class="btn btn-sm btn-outline-primary mb-0 py-0 px-2" title="Upload Invoices">
                    @* 📤 Upload Invoices *@
                    @* <input type="file" id="uploadInput" multiple hidden accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.bmp" /> *@
                    <!-- ====================== UPLOAD BUTTON ====================== -->
                    <button id="open-upload-btn" disabled class="btn btn-primary">
                        Upload Files / Folders
                    </button>

                    <!-- ====================== MODAL DIALOG ====================== -->
                    <dialog id="upload-dialog" style="padding: 0; border: none; border-radius: 12px; max-width: 600px; width: 95%; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
                        <div style="padding: 24px;">
                            <!-- Header -->
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                                <h2 style="margin: 0; font-size: 1.4rem;">Upload Files or Folders</h2>
                                <button id="close-dialog-btn" style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">&times;</button>
                            </div>

                            <!-- Drop Zone -->
                            <div id="drop-zone"
                                 style="border: 2px dashed #ccc; border-radius: 8px; padding: 40px; text-align: center; margin-bottom: 20px; transition: all 0.2s;">
                                <p style="margin: 0 0 12px 0; color: #555;">
                                    Drag & drop files or folders here
                                </p>
                                <label for="file-input"
                                       style="display: inline-block; padding: 10px 20px; background: #007bff; color: white; border-radius: 6px; cursor: pointer; margin-right:8px;">
                                    Browse Files
                                </label>
                                <label for="folder-input"
                                       style="display: inline-block; padding: 10px 20px; background: #6c757d; color: white; border-radius: 6px; cursor: pointer;">
                                    Browse Folder
                                </label>
                                <input type="file" id="file-input" multiple hidden />
                                <input type="file" id="folder-input" multiple webkitdirectory hidden />
                            </div>

                            <!-- Selected Files -->
                            <div id="file-list-container" style="margin-bottom: 20px; max-height: 200px; overflow-y: auto;">
                                <div id="file-list" style="display: flex; flex-direction: column; gap: 8px;"></div>
                            </div>

                            <!-- Footer -->
                            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 20px;">
                                <button id="cancel-btn" class="btn btn-secondary">Cancel</button>
                                <button id="upload-btn" class="btn btn-success" disabled>Upload</button>
                            </div>
                        </div>
                    </dialog>
                </label>
                <button id="batchOcrBtn" class="btn btn-sm btn-outline-success py-0" title="Run OCR on all files">▶ OCR All</button>
                <button id="refreshBtn"  class="btn btn-sm btn-outline-secondary py-0" title="Refresh">🔄</button>
                <div class="dropdown">
                    <button id="exportDropdownBtn" class="btn btn-sm btn-outline-secondary py-0 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Export batch">📥</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#" onclick="exportBatchJson(); return false;">Export to JSON</a></li>
                        <li><a class="dropdown-item" href="#" onclick="exportBatchExcel(); return false;">Export to Excel</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="kocr-file-items" id="fileListContainer">
            @if (Model.CurrentBatch == null)
            {
                <p class="text-muted small px-2 pt-2">No batch selected.</p>
            }
            else if (!Model.Files.Any())
            {
                <p class="text-muted small px-2 pt-2">No files in batch.</p>
            }
            else
            {
                foreach (var file in Model.Files)
                {
                    var overLimitClass = file.ExceedsPageLimit ? " file-list-item--overlimit" : "";
                    var overLimitAttr  = file.ExceedsPageLimit ? $" data-exceeds-limit=\"true\" title=\"This invoice has {file.TotalPages} pages and exceeds the {Model.MaxPagesPerInvoice}-page limit. It will not be OCR'd.\"" : "";
                    <text>
                    <div class="file-list-item@overLimitClass"
                         data-filepath="@file.FilePath"@Html.Raw(overLimitAttr)
                         role="button"
                         tabindex="0"
                         onclick="handleFileListItemClick(this, event)"
                         onkeydown="handleFileListItemKeydown(event, this)"
                         oncontextmenu="return handleFileListItemContextMenu(event, this);">
                        <span class="file-status-dot @file.ProcessedDotClass"  title="@file.ProcessedDotTitle"></span>
                        <span class="file-queue-indicator" style="display:none;" title="Queued for OCR">Q</span>
                        <span class="file-status-dot @file.ValidationDotClass" title="@file.ValidationDotTitle"></span>
                        <span class="text-truncate" style="flex:1;min-width:0;" title="@file.FileName">@file.FileName</span>
                    </div>
                    </text>
                }
            }
        </div>
        <div class="kocr-file-list-footer">
            <div class="pg-size-row">
                <label for="pgSize" class="pg-size-label">Show</label>
                <select id="pgSize" class="form-select form-select-sm pg-size-select">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="pg-nav-row" id="pgNavRow" style="display:none;">
                <button id="pgPrev" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Previous page" disabled>&lsaquo;</button>
                <span id="pgLabel" class="pg-label small"></span>
                <button id="pgNext" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Next page" disabled>&rsaquo;</button>
            </div>
        </div>
    </div>

    <!-- ── Left splitter ─────────────────────────────────────────── -->
    <div class="splitter" id="splitterLeft"></div>

    <!-- ── Center pane: document viewer ─────────────────────────── -->
    <div class="kocr-pane kocr-pane-center">
        <div class="kocr-panel-header viewer-toolbar" id="viewerToolbar" style="display:none;">
            <button class="viewer-btn" id="zoomOutBtn"  title="Zoom out">−</button>
            <span   class="viewer-zoom-label" id="zoomLabel">100%</span>
            <button class="viewer-btn" id="zoomInBtn"   title="Zoom in">+</button>
            <button class="viewer-btn viewer-btn-fit" id="zoomFitWBtn" title="Fit to width">⊞ Fit W</button>
            <button class="viewer-btn viewer-btn-fit" id="zoomFitHBtn" title="Fit to height">↕ Fit H</button>
            <span class="viewer-currency-label" id="viewerCurrencyLabel" style="display:none;"></span>
        </div>
        <div class="viewer-scroll" id="viewerScroll">
            <div class="viewer-placeholder" id="noDocMsg">Select a file to view the document</div>
            <div id="viewerPagesContainer"></div>
        </div>
    </div>

    <!-- ── Right splitter ────────────────────────────────────────── -->
    <div class="splitter" id="splitterRight"></div>

    <!-- ── Right pane: invoice/validation ────────────────────────── -->
    <div class="kocr-pane kocr-pane-right">
        <div class="kocr-panel-header kocr-invoice-header">
            <ul class="nav nav-tabs px-2 pt-1" id="invoiceTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active py-1 px-2 small" data-bs-toggle="tab"
                            data-bs-target="#tab-validation" type="button" role="tab">Validation</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-2 small" data-bs-toggle="tab"
                            data-bs-target="#tab-rawjson" type="button" role="tab">Raw JSON</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-2 small" data-bs-toggle="tab"
                            data-bs-target="#tab-validatedjson" type="button" role="tab">Updated JSON</button>
                </li>
            </ul>
            <span id="validationStatusLabel" class="validation-status-label" aria-live="polite"></span>
        </div>
        <div class="kocr-invoice-body tab-content">
            <div class="tab-pane fade show active" id="tab-validation" role="tabpanel">
                <div id="invoiceFields">
                    <p class="text-muted small">Select a file to view invoice data.</p>
                </div>
            </div>
            <div class="tab-pane fade" id="tab-rawjson" role="tabpanel">
                <pre id="rawJsonContent" class="bg-light p-2 rounded"
                     style="font-size:0.72rem;white-space:pre-wrap;word-break:break-all;"></pre>
            </div>
            <div class="tab-pane fade" id="tab-validatedjson" role="tabpanel">
                <pre id="validatedJsonContent" class="bg-light p-2 rounded"
                     style="font-size:0.72rem;white-space:pre-wrap;word-break:break-all;"></pre>
            </div>
        </div>
    </div>

</div>

<div id="invoiceContextMenu" class="invoice-context-menu" style="display:none;">
    <button type="button" id="invoiceMenuRunOcrBtn" class="invoice-context-item">OCR this Invoice</button>
    <button type="button" id="invoiceMenuRemoveBtn" class="invoice-context-item">Remove Invoice from Batch</button>
    <button type="button" id="invoiceMenuMoveBtn" class="invoice-context-item">Move Invoice to another Batch</button>
</div>
<!-- Field context menu -->
<div id="fieldContextMenu" class="invoice-context-menu" style="display:none;">
    <button type="button" id="fieldMenuAcceptBtn" class="invoice-context-item">Mark as Validated</button>
    <button type="button" id="fieldMenuRevertBtn" class="invoice-context-item">Revert Edits</button>
</div>
<!-- Upload In Progress overlay -->
<div id="uploadOverlay">
    <div class="spinner-border text-light ocr-spinner" role="status">
        <span class="visually-hidden">Uploading...</span>
    </div>
    <span class="ocr-overlay-label">Uploading...</span>
</div>
<!-- Setup link modal -->
<div class="modal fade" id="setupLinkModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Setup Link</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Email was not sent. Share this link with the user:</p>
                <input type="text" id="setupLinkInput" class="form-control" readonly />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Re-OCR confirmation dialog -->
<div class="modal fade" id="reOcrModal" tabindex="-1" aria-labelledby="reOcrModalLabel" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info-subtle">
                <h5 class="modal-title" id="reOcrModalLabel">ℹ️ Files Already Processed</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>The following files already have OCR results:</p>
                <ul id="reOcrFileList" class="list-group list-group-flush mb-3" style="max-height:200px;overflow-y:auto;"></ul>
                <p class="small text-muted mb-2">Invoices already queued for OCR are also skipped and will not be added to the queue again.</p>
                <p class="mb-0">What would you like to do?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="reOcrSkipBtn">Skip these files (OCR remaining only)</button>
                <button type="button" class="btn btn-outline-danger" id="reOcrAllBtn">Re-OCR all files</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="moveInvoiceModal" tabindex="-1" aria-labelledby="moveInvoiceModalLabel" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="moveInvoiceModalLabel">Move Invoice to Batch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label for="moveInvoiceBatchSelect" class="form-label">Select target batch</label>
                <select id="moveInvoiceBatchSelect" class="form-select form-select-sm"></select>
                <p id="moveInvoiceNoBatches" class="text-muted small mt-2 mb-0" style="display:none;">
                    No other active batches are available.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="moveInvoiceConfirmBtn">Move</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="betaLimitModal" tabindex="-1" aria-labelledby="betaLimitModalLabel" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning-subtle">
                <h5 class="modal-title" id="betaLimitModalLabel">Beta Test Organization Notice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="betaLimitModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Unsaved Changes Confirmation Dialog -->
<div class="modal fade" id="unsavedChangesModal" tabindex="-1" aria-labelledby="unsavedChangesLabel" aria-modal="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning-subtle">
                <h5 class="modal-title" id="unsavedChangesLabel">⚠️ Changes Not Saved</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                This invoice has unsaved changes. Would you like to save and validate them before switching?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="unsavedChangesNoBtn" data-bs-dismiss="modal">No, Discard</button>
                <button type="button" class="btn btn-warning" id="unsavedChangesSaveBtn">Yes, Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/variables.js"></script>
<script src="~/js/functions.js"></script>
<script src="~/lib/signalr/signalr.min.js"></script>
<script>
    // @Model values are server-side - can't asssign to them
    var _currentPage = @Model.CurrentPage;
    var _pageSize    = @Model.PageSize;
    var _totalFiles = @Model.TotalFiles;

    var _orgId                   = '@Html.Raw(Model.OrgId)';
    //var _currentUserEmail        = '@Html.Raw(Model.CurrentUserEmail)';
    var _currentBatchId          = @(Model.CurrentBatch?.BatchId.ToString() ?? "null");
    var _maxPagesPerInvoice      = @Model.MaxPagesPerInvoice;
    var _maxInvoicesPerBatch     = @Model.MaxInvoicesPerBatch;
    var _isBetaTestOrganization  = @(Model.IsBetaTestOrganization.ToString().ToLowerInvariant());
    var _isOrgAdmin              = @(Model.IsOrgAdmin.ToString().ToLowerInvariant());
    var _minConfidenceThreshold    = @Model.MinConfidenceThreshold.ToString("R", System.Globalization.CultureInfo.InvariantCulture);

    var _showBetaWelcomeDialog   = @(Model.ShowBetaWelcomeDialog.ToString().ToLowerInvariant());
    var _betaLimitExceeded       = @(Model.BetaOcrLimitExceeded.ToString().ToLowerInvariant());
    var _betaUsedPages           = @Model.BetaUsedOcrPages;
    var _betaMaxPages            = @Model.BetaMaxOcrPages;
    var _betaPagesRemaining      = @Model.BetaRemainingOcrPages;
    var _betaExceededDialogShown = _betaLimitExceeded;

    var _isGuestOrganization       = @(Model.IsGuestOrganization.ToString().ToLowerInvariant());
    var _showGuestWelcomeDialog    = @(Model.ShowGuestWelcomeDialog.ToString().ToLowerInvariant());
    var _guestMaxBatches           = @Model.GuestMaxBatches;
    var _guestActiveBatchCount     = @Model.GuestActiveBatchCount;
    var _guestRemainingBatches     = @Model.GuestRemainingBatches;
    var _guestBatchLimitExceeded   = @(Model.GuestBatchLimitExceeded.ToString().ToLowerInvariant());
    var _guestMaxInvoicesPerBatch  = @Model.GuestMaxInvoicesPerBatch;
    var _guestMaxPagesPerInvoice   = @Model.GuestMaxPagesPerInvoice;

    let HEADER_FIELDS = [];
    //let ITEM_FIELDS = [];
    let HEADER_MONEY_FIELDS = new Set();
    let ITEM_MONEY_FIELDS = new Set();
    let CURRENCY_FIELDS = ['unitPrice', 'subtotal', 'totalTax', 'discount', 'total', 'amount'];  // Item fields that should accept only currency values
    let _currencyErrorThrottleTimer = null;  // Throttle currency validation errors

    // Pending file path when showing unsaved changes dialog
    var _pendingFilePathSwitch = null;
    var _pendingExceedsLimit = false;

    // ── Field state tracking ──────────────────────────────────────
    var _originalValues = new Map();  // fieldKey -> original value from OCR
    var _committedValues = new Map(); // fieldKey -> value currently saved to the database (or original, if never edited)
    var _pendingEdits = new Set();    // fieldKeys that differ from the last committed/saved value (unsaved)
    var _persistedEdits = new Set();  // fieldKeys that have been saved to database


    // ── File list click handlers (assigned early so onclick attributes work even if later init crashes) ──
    window.handleFileListItemClick = function (item, event) 
    {
        if (event && typeof event.button === 'number' && event.button !== 0) return;
        activateFileListItem(item);
    };

    window.handleFileListItemKeydown = function (event, item) 
    {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        activateFileListItem(item);
    };


    function showUnsavedChangesDialog(filePath, exceedsLimit) {
        _pendingFilePathSwitch = filePath;
        _pendingExceedsLimit = exceedsLimit;
        const modal = new bootstrap.Modal(document.getElementById('unsavedChangesModal'));
        modal.show();
    }

    async function selectFileWithPrompt(filePath, exceedsLimit) {
        // If switching to a different file and there are unsaved edits, show dialog
        if (filePath !== _currentFilePath && _pendingEdits.size > 0) {
            showUnsavedChangesDialog(filePath, exceedsLimit);
            return;
        }
        // Otherwise, proceed directly
        await selectFile(filePath, exceedsLimit);
    }

    async function selectFile(filePath, exceedsLimit)
    {
        // Clear field state if loading a different invoice
        if (filePath !== _currentFilePath) 
        {
            _persistedEdits.clear();
            _pendingEdits.clear();
        }
        _currentFilePath  = filePath;
        _selectedFieldKey = null;
        updateViewerCurrencyLabel(null);
        loadDocumentPages(filePath);

        try
        {
            const result = await fetch('/home/getinvoice?filePath=' + encodeURIComponent(filePath));
            const data = await result.json();
            _ocrLoaded = data?.invoice != null;
            if (data.success && data.invoice && data.invoice.ocrText)
            {
                _currentInvoice = data.invoice;

                replayEdits(_currentInvoice);

                // Clear original edit maps before loading new invoice
                _originalItemEditsJson.clear();
                attachValidation(_currentInvoice);
                renderInvoiceFields(data.invoice);
                updateValidationStatusLabel(data.invoice);
                updateViewerCurrencyLabel(data.invoice);
                // Raw JSON tab displays the original unedited OCR text from Azure
                const rawData = getRawOcrTextDisplay(data.invoice);
                document.getElementById('rawJsonContent').textContent =
                rawData ? JSON.stringify(rawData, null, 2) : '';

                // Updated JSON tab shows the export-ready invoice (edits applied) only
                // when the invoice has been edited or accepted
                const updatedData = buildUpdatedInvoiceDisplay(data.invoice);
                document.getElementById('validatedJsonContent').textContent =
                    updatedData ? JSON.stringify(updatedData, null, 2) : '';
            }
            else
            {
                document.getElementById('invoiceFields').innerHTML =
                '<p class="text-muted">No invoice data yet. Run OCR to process this file.</p>';
                renderRunOcrButton(filePath, exceedsLimit);
                document.getElementById('rawJsonContent').textContent = '';
                document.getElementById('validatedJsonContent').textContent = '';
                updateValidationStatusLabel(null);
            }
        }
        catch (err)
        {
            showToast('Failed to load invoice: ' + err.message, 'error');
        }
    }

    function replayEdits(invoice){
        if(invoice?.invoiceEdits || invoice?.invoiceEdits?.length)
        {
            const editsObj = JSON.parse(invoice.invoiceEdits);
            editsObj.forEach(item => {
                invoice[toCamelCase(item.fieldName)] = item.value;
            });
        }

        if(invoice?.items)
        {
            // for each line item
            invoice.items.forEach(item => 
            {
                if(item.itemEdits)
                {
                    const itemEditsObj = JSON.parse(item.itemEdits);

                   // for each individual edit for the item
                    itemEditsObj.forEach(itemEdit => 
                    {
                        item[toCamelCase(itemEdit.fieldName)] = itemEdit.value;
                    });
                }
            });
        }
    }

    function toCamelCase(str) {
        const camelCase = str.charAt(0).toLowerCase() + str.slice(1);
        return camelCase;
    }

    function normalizeFilePathKey(filePath) {
        return String(filePath ?? '').replace(/\//g, '\\').toLowerCase();
    }

    function markFileQueued(filePath) {
        const key = normalizeFilePathKey(filePath);
        if (!key) return;
        _queuedFilePathKeys.add(key);
        const item = findFileListItem(filePath);
        const qEl = item?.querySelector('.file-queue-indicator');
        if (qEl) qEl.style.display = 'inline-block';
        syncCurrentRunOcrButton(filePath);
    }

    function clearFileQueued(filePath) {
        const key = normalizeFilePathKey(filePath);
        if (!key) return;
        _queuedFilePathKeys.delete(key);
        const item = findFileListItem(filePath);
        const qEl = item?.querySelector('.file-queue-indicator');
        if (qEl) qEl.style.display = 'none';
        syncCurrentRunOcrButton(filePath);
    }

    function isFileQueued(filePath) {
        return _queuedFilePathKeys.has(normalizeFilePathKey(filePath));
    }

    function setQueuedFilePaths(filePaths) {
        _queuedFilePathKeys.clear();
        for (const filePath of (filePaths ?? [])) {
            const key = normalizeFilePathKey(filePath);
            if (key) _queuedFilePathKeys.add(key);
        }
    }

    function findFileListItem(filePath) {
        const key = normalizeFilePathKey(filePath);
        if (!key) return null;
        return Array.from(document.querySelectorAll('.file-list-item'))
            .find(item => normalizeFilePathKey(item.dataset.filepath) === key) ?? null;
    }

    function syncCurrentRunOcrButton(filePath) {
        if (!_currentFilePath) return;
        if (normalizeFilePathKey(_currentFilePath) !== normalizeFilePathKey(filePath)) return;
        const btn = document.getElementById('runOcrBtn');
        if (!btn || btn.dataset.queueToggle !== 'true') return;
        const queued = isFileQueued(filePath);
        if (queued) {
            btn.disabled = true;
            btn.classList.remove('btn-primary');
            btn.classList.add('btn-secondary');
            btn.title = 'This invoice is already queued for OCR.';
        } else {
            btn.disabled = false;
            btn.classList.remove('btn-secondary');
            btn.classList.add('btn-primary');
            btn.title = '';
        }
    }

    function hideInvoiceContextMenu() {
        const menu = document.getElementById('invoiceContextMenu');
        if (!menu) return;
