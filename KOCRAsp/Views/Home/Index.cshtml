    function showFieldContextMenu(x, y, fieldKey) {
        const menu = document.getElementById('fieldContextMenu');
        if (!menu) return;

        _selectedFieldKey = fieldKey;
        menu.style.display = 'block';

        const viewportWidth = window.innerWidth;
