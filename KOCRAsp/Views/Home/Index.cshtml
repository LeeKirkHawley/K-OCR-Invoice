    async function openMoveInvoiceModal(filePath) {
        const select = document.getElementById('moveInvoiceBatchSelect');
        const noBatches = document.getElementById('moveInvoiceNoBatches');
        const confirmBtn = document.getElementById('moveInvoiceConfirmBtn');

        _pendingMoveFilePath = filePath;
        select.innerHTML = '';

        try {
            const resp = await fetch('/home/getbatches', { cache: 'no-store' });
            const batches = await resp.json();
            const currentBatchId = Number(document.getElementById('batchSelector').value || 0);
            const candidates = (batches ?? []).filter(b => Number(b.batchId) !== currentBatchId);

            if (candidates.length === 0) {
                noBatches.style.display = '';
                confirmBtn.disabled = true;
            } else {
                noBatches.style.display = 'none';
                confirmBtn.disabled = false;
                for (const batch of candidates) {
                    const opt = document.createElement('option');
                    opt.value = String(batch.batchId);
                    opt.textContent = batch.name;
                    select.appendChild(opt);
                }
            }

            bootstrap.Modal.getOrCreateInstance(document.getElementById('moveInvoiceModal')).show();
        } catch (err) {
            showToast('Failed to load batches: ' + err.message, 'error');
        }
    }

    async function removeInvoiceFromBatch(filePath) {
        if (!confirm('Remove this invoice from the current batch?')) return;

        const fd = new FormData();
        fd.append('filePath', filePath);
        const result = await postForm('/home/removeinvoicefrombatch', fd);
        if (!result.success)
            throw new Error(result.error ?? 'Remove failed.');

        clearFileQueued(filePath);
        if (normalizeFilePathKey(_currentFilePath) === normalizeFilePathKey(filePath))
            resetInvoiceSelection();

        await refreshFileList();
        await updateExportButtonState();
        showToast('Invoice removed from batch.');
    }

    async function moveInvoiceToBatch(filePath, targetBatchId) {
        const fd = new FormData();
        fd.append('filePath', filePath);
        fd.append('targetBatchId', targetBatchId);

        const result = await postForm('/home/moveinvoicetobatch', fd);
        if (!result.success)
            throw new Error(result.error ?? 'Move failed.');

        clearFileQueued(filePath);
        if (normalizeFilePathKey(_currentFilePath) === normalizeFilePathKey(filePath))
            resetInvoiceSelection();

        await refreshFileList();
        await updateExportButtonState();
        showToast('Invoice moved to target batch.');
    }

    async function updateExportButtonState() {
        const btn = document.getElementById('exportDropdownBtn');
        if (!btn) return;
        try {
            const resp = await fetch('/home/getbatchexportstatus');
            const data = await resp.json();
            if (!data.requiresValidation || data.allValidated) {
                btn.disabled = false;
                btn.title = 'Export batch';
            } else {
                btn.disabled = true;
                btn.title = `Export disabled: ${data.validatedCount} of ${data.fileCount} invoice(s) validated`;
            }
        } catch {
            // leave button in its current state on network error
        }
    }

    async function refreshFileList(page) {
        if (_refreshAbort) _refreshAbort.abort();
        _refreshAbort = new AbortController();
        const pgPrev = document.getElementById('pgPrev');
        const pgNext = document.getElementById('pgNext');
        pgPrev.disabled = true;
        pgNext.disabled = true;
        try {
            const p = page ?? _currentPage;
            const resp = await fetch(`/home/getfiles?page=${p}&pageSize=${_pageSize}`, { signal: _refreshAbort.signal, cache: 'no-store' });
            const data = await resp.json();
            _currentPage = data.page;
            setQueuedFilePaths(data.queuedFilePaths);
            renderFileList(data.items);
            renderPagination(data.total, data.page, data.pageSize, data.totalPages);
            document.getElementById('fileListContainer').scrollTop = 0;
        } catch (err) {
            if (err.name === 'AbortError') return;
            showToast('Refresh failed: ' + err.message, 'error');
        } finally {
            _refreshAbort = null;
        }
    }

    function renderFileList(files) {
        const container = document.getElementById('fileListContainer');
        if (!files || files.length === 0) {
            container.innerHTML = '<p class="text-muted small px-1">No files in batch.</p>';
            return;
        }
        let html = '';
        for (const file of files) {
            if (file.hasOcrResult) {
                clearFileQueued(file.filePath);
            }
            const active       = _currentFilePath === file.filePath ? ' active' : '';
            const overLimit    = file.exceedsPageLimit;
            const overLimitCls = overLimit ? ' file-list-item--overlimit' : '';
            const overLimitAttr = overLimit
                ? ` data-exceeds-limit="true" title="This invoice has ${file.totalPages} pages and exceeds the ${_maxPagesPerInvoice}-page limit. It will not be OCR'd."`
                : '';
            html += `<div class="file-list-item${active}${overLimitCls}"
                          data-filepath="${escapeHtml(file.filePath)}"${overLimitAttr}
                          role="button"
                          tabindex="0"
                          onclick="handleFileListItemClick(this, event)"
                          onkeydown="handleFileListItemKeydown(event, this)"
                          oncontextmenu="return handleFileListItemContextMenu(event, this);">
                <span class="file-status-dot ${escapeHtml(file.processedDotClass ?? '')}"
                      title="${escapeHtml(file.processedDotTitle ?? '')}"></span>
                <span class="file-queue-indicator" style="${isFileQueued(file.filePath) ? '' : 'display:none;'}"
                      title="Queued for OCR">Q</span>
                <span class="file-status-dot ${escapeHtml(file.validationDotClass ?? '')}"
                      title="${escapeHtml(file.validationDotTitle ?? '')}"></span>
                <span class="text-truncate" style="flex:1;min-width:0;"
                      title="${escapeHtml(file.fileName)}">${escapeHtml(file.fileName)}</span>
            </div>`;
        }
        container.innerHTML = html;
    }

    function renderPagination(total, page, pageSize, totalPages) {
        const pgNavRow = document.getElementById('pgNavRow');
        const pgPrev   = document.getElementById('pgPrev');
        const pgNext   = document.getElementById('pgNext');
        const pgLabel  = document.getElementById('pgLabel');
        const pgSizeEl = document.getElementById('pgSize');
        pgSizeEl.value = String(pageSize);
        if (!totalPages || totalPages <= 1) {
            pgNavRow.style.display = 'none';
        } else {
            pgNavRow.style.display = '';
            const start = (page - 1) * pageSize + 1;
            const end   = Math.min(page * pageSize, total);
            pgLabel.textContent = `${start}–${end} of ${total}`;
            pgPrev.disabled = page <= 1;
            pgNext.disabled = page >= totalPages;
        }
    }

    async function refreshBatchDropdown() {
        try {
            const resp = await fetch('/home/getbatches', { cache: 'no-store' });
            const batches = await resp.json();
            const selector = document.getElementById('batchSelector');
            const currentValue = selector.value;
             
            // Only show "Select Batch" placeholder if no batch is currently selected
            let html = '';
            if (!currentValue) {
                html = '<option value="">— Select Batch —</option>';
            }
            for (const batch of batches) {
                const selected = batch.batchId == currentValue ? ' selected' : '';
                html += `<option value="${batch.batchId}"${selected}>${escapeHtml(batch.name)}</option>`;
            }
            selector.innerHTML = html;
        } catch (err) {
            console.error('Failed to refresh batch dropdown:', err);
        }
    }

    // ── SignalR: real-time dot updates per invoice ───────────────
    async function refreshInvoiceDots(invoiceId) {
        try {
            const resp = await fetch(`/home/invoicedotstate?invoiceId=${invoiceId}`);
            if (!resp.ok) return;
            const data = await resp.json();
            if (data.error || !data.filePath) return;
            const item = findFileListItem(data.filePath);
            if (!item) return;
            const dots = item.querySelectorAll('.file-status-dot');
            if (dots.length >= 1) {
                dots[0].className = `file-status-dot ${data.processedDotClass ?? ''}`.trim();
                dots[0].title = data.processedDotTitle ?? '';
            }
            if (dots.length >= 2) {
                dots[1].className = `file-status-dot ${data.validationDotClass ?? ''}`.trim();
                dots[1].title = data.validationDotTitle ?? '';
            }
            // Remove Q indicator now that OCR is done
            clearFileQueued(data.filePath);
            const qEl = item.querySelector('.file-queue-indicator');
            if (qEl) qEl.style.display = 'none';

            if (_currentFilePath && normalizeFilePathKey(_currentFilePath) === normalizeFilePathKey(data.filePath)) {
                await selectFile(data.filePath, false);
            }
        } catch { /* ignore */ }
    }

    function markQueueIndicators() {
        document.querySelectorAll('.file-list-item').forEach(item => {
            const fp  = item.dataset.filepath;
            const qEl = item.querySelector('.file-queue-indicator');
            if (!qEl) return;
            qEl.style.display = isFileQueued(fp) ? '' : 'none';
        });
    }

    function initOcrSignalR() {
        if (!_orgId) return;
        const connection = new signalR.HubConnectionBuilder()
            .withUrl('/hubs/ocr')
            .withAutomaticReconnect()
            .build();

        connection.on('InvoiceOcrCompleted', async (payload) => {
            if (_currentBatchId !== null && payload.batchId !== _currentBatchId) return;
            await refreshInvoiceDots(payload.invoiceId);
        });

        connection.on('InvoiceOcrQueued', (payload) => {
            if (_currentBatchId !== null && payload.batchId !== _currentBatchId) return;
            markFileQueued(payload.filePath);
        });

        connection.on('InvoiceOcrUnqueued', (payload) => {
            if (_currentBatchId !== null && payload.batchId !== _currentBatchId) return;
            clearFileQueued(payload.filePath);
        });

        // Batch list / file list changes (uploads, moves, deletes, etc.)
        connection.on('BatchChanged', (payload) => {
            try {
                if (!payload || !payload.orgId) return;
                if (_orgId && payload.orgId !== _orgId) return;
                // Refresh batches and files so uploads/moves are visible immediately
                refreshBatchDropdown();
                refreshFileList(1);
            } catch (e) { console.warn('BatchChanged handler error:', e); }
        });

        connection.start()
            .then(() => connection.invoke('JoinOrgGroup', _orgId))
            .catch(err => console.warn('[OCR SignalR] Connection failed:', err));
    }

    // ── Recursively strip bounding box fields from any JSON structure ──
    // Removes all bbox-related fields for cleaner display without modifying original data.
    function stripAllBboxFields(obj) {
        if (obj === null || obj === undefined) return obj;
        if (typeof obj !== 'object') return obj;

        if (Array.isArray(obj)) {
            return obj.map(item => stripAllBboxFields(item));
        }

        const result = {};
        for (const [key, value] of Object.entries(obj)) {
            // Skip bbox-related fields
            if (key.toLowerCase().includes('boundingbox') || 
                key.toLowerCase().includes('bbox') ||
                key === 'boundingBoxes' ||
                key === 'fieldBoundingBoxes' ||
                key === 'originalPageWidth' ||
                key === 'originalPageHeight' ||
                key === 'pageCount') {
                continue;
            }
            
            // Recursively process nested objects and arrays
            result[key] = stripAllBboxFields(value);
        }
        return result;
    }

    // ── Extract original OCR text from the invoice ──────────────────
    // Returns the original OCR text that came from Azure with bounding boxes stripped for readability.
    // The actual data is not modified - only the display is cleaned up.
    function getRawOcrTextDisplay(inv) {
        if (!inv || !inv.ocrText) return null;
        
        try {
            // OcrText is the raw JSON string from Azure
            const parsed = JSON.parse(inv.ocrText);
            
            // Strip all bounding box fields for readability in the display only
            return stripAllBboxFields(parsed);
        } catch (err) {
            console.warn('Failed to parse OcrText:', err);
        }
        
        return null;
    }

    // ── Strip bbox-only fields for JSON display / export ────────
    // Keeps _currentInvoice intact so 2-way highlighting still works.
    function stripBboxFields(inv) {
        if (!inv) return inv;
        const { fieldBoundingBoxes, originalPageWidth, originalPageHeight, pageCount, items, ...rest } = inv;
        return {
            ...rest,
            items: (items ?? []).map(({ boundingBoxes, ...itemRest }) => itemRest)
        };
    }

    // ── Build the export-ready invoice for the Updated JSON tab ──
    // Returns an object with edits overlaid on base fields, internal-only fields
    // stripped, and bbox data removed.  Returns null if the invoice has no edits
    // and has not been accepted (tab should be empty in that case).
    function buildUpdatedInvoiceDisplay(inv) {
        if (!inv) return null;

        const headerEdits = parseEditsMap(inv.invoiceEdits);
        const hasHeaderEdits = headerEdits.size > 0;
        const hasItemEdits = (inv.items ?? []).some(item => parseEditsMap(item.itemEdits).size > 0);

        if (!inv.isInvoiceAccepted && !hasHeaderEdits && !hasItemEdits) return null;

        // Destructure out internal / bbox fields from the header
        const {
            fieldBoundingBoxes, originalPageWidth, originalPageHeight, pageCount,
            ocrText, invoiceEdits, fieldConfidences, tesseractConfirmed,
            items,
            ...headerFields
        } = inv;

        // Overlay header edits
        for (const [k, v] of headerEdits) {
            headerFields[k] = v;
        }

        // Build effective items with item edits applied, stripping internal fields
        const effectiveItems = (items ?? []).map(item => {
            const { boundingBoxes, fieldConfidences: _fc, tesseractConfirmed: _tc, itemEdits, ...itemFields } = item;
            for (const [k, v] of parseEditsMap(itemEdits)) {
                itemFields[k] = v;
            }
            return itemFields;
        });

        return { ...headerFields, items: effectiveItems };
    }

    // ── Extract the actual InvoiceDto from the raw OcrText JSON ──────
    // OcrText is a serialized PipelineContext: { ..., "Layout": [ <InvoiceDto> ], ... }
    // (Newtonsoft default = PascalCase). This unwraps that structure and returns
    // the first layout entry, regardless of "Layout"/"layout" casing.
    function getOriginalInvoiceLayout() {
        if (!_currentInvoice || !_currentInvoice.ocrText) return null;
        try {
            const parsed = JSON.parse(_currentInvoice.ocrText);
            const layout = parsed.Layout ?? parsed.layout;
            if (Array.isArray(layout) && layout.length > 0) return layout[0];
            // Fallback: maybe ocrText is already the flat invoice object
            return parsed;
        } catch {
            return null;
        }
    }

    // Case-insensitive property lookup (OcrText may be PascalCase or camelCase)
    function CaseInsensitivePropertyLookup(obj, propName) {
        if (!obj || typeof obj !== 'object') 
            return undefined;
        if (propName in obj) 
            return obj[propName];
        
        const lower = propName.toLowerCase();
        for (const k of Object.keys(obj)) {
            if (k.toLowerCase() === lower) return obj[k];
        }
        return undefined;
    }

    function refreshSavedFieldStyling() {
        const container = document.getElementById('invoiceFields');
        if (!container) return;

        container.querySelectorAll('.inv-field').forEach(input => {
            const fieldKey = input.dataset.fieldkey;
            if (!fieldKey) 
                return;

            // Remove both classes first
            input.classList.remove('inv-persisted-input', 'inv-pending-input');
            
            // Apply persisted (blue, takes precedence) or pending (green)
            if (_persistedEdits.has(fieldKey)) {
                input.classList.add('inv-persisted-input');
            } else if (_pendingEdits.has(fieldKey)) {
                input.classList.add('inv-pending-input');
            }
        });
    }

    // ── Init ────────────────────────────────────────────────────
    document.getElementById('pgPrev').addEventListener('click', () => refreshFileList(_currentPage - 1));
    document.getElementById('pgNext').addEventListener('click', () => refreshFileList(_currentPage + 1));
    document.getElementById('pgSize').addEventListener('change', function () {
        _pageSize = parseInt(this.value, 10);
        refreshFileList(1);
    });
    renderPagination(@Model.TotalFiles, @Model.CurrentPage, @Model.PageSize, @Model.TotalPages);
    updateExportButtonState();
     
    // Enable upload button only when a batch is selected
    function updateUploadButtonState() {
        const openUploadBtn = document.getElementById('open-upload-btn');
        if (openUploadBtn) {
            openUploadBtn.disabled = !_currentBatchId;
        }
    }
     
    // Update batch selector to enable upload button on change
    const batchSelectorEl = document.getElementById('batchSelector');
    if (batchSelectorEl) {
        batchSelectorEl.addEventListener('change', function () {
            const batchId = this.value;
            if (!batchId) return;
            const fd = new FormData();
            fd.append('batchId', batchId);
            postForm('/home/selectbatch', fd)
                .then(() => location.reload())
                .catch(err => showToast('Failed to switch batch: ' + err.message, 'error'));
        });
    }
     
    updateUploadButtonState();
     
    // Remove the placeholder "Select Batch" option if a batch is selected
    if (_currentBatchId) {
        const placeholderOption = document.querySelector('#batchSelector option[value=""]');
        if (placeholderOption) {
            placeholderOption.remove();
        }
    }
     
    initKocrSplitters();
    initKocrZoom();
    initVtip();
    applyBetaLimitState();
    maybeShowInitialBetaDialog();
    maybeShowInitialGuestDialog();
    initOcrSignalR();
    refreshFileList(_currentPage);
</script>

<script>
    let selectedFiles = [];

    const dialog = document.getElementById('upload-dialog');
    const openBtn = document.getElementById('open-upload-btn');
    const closeBtn = document.getElementById('close-dialog-btn');
    const cancelBtn = document.getElementById('cancel-btn');
    const uploadBtn = document.getElementById('upload-btn');
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const folderInput = document.getElementById('folder-input');
    const fileListEl = document.getElementById('file-list');

    // Open the dialog
    openBtn.addEventListener('click', () => 
    {
        dialog.show();
    });

    // Close handlers
    closeBtn.addEventListener('click', () => closeDialog(dialog));
    cancelBtn.addEventListener('click', () => closeDialog(dialog));

    dialog.addEventListener('close', () => 
    {
        // Reset when dialog is closed
        resetState(dropZone, fileListEl, uploadBtn, selectedFiles);
    });

    // Drag & Drop handlers
    dropZone.addEventListener('dragover', e => 
    {
        e.preventDefault();
        dropZone.style.borderColor = '#007bff';
        dropZone.style.backgroundColor = '#f0f8ff';
    });

    dropZone.addEventListener('dragleave', () => 
    {
        dropZone.style.borderColor = '#ccc';
        dropZone.style.backgroundColor = '';
    });

    dropZone.addEventListener('drop', async e => 
    {
        e.preventDefault();
        dropZone.style.borderColor = '#ccc';
        dropZone.style.backgroundColor = '';

        const items = e.dataTransfer.items;
        if (items && items.length > 0) 
        {
            const newFiles = await getAllFileEntries(items);
            selectedFiles.push(...newFiles);
        } 
        else 
        {
            selectedFiles.push(...e.dataTransfer.files);
        }
        renderDialogFileList(fileListEl, uploadBtn, selectedFiles);
    });

    // Browse button(s)
    fileInput.addEventListener('change', () => 
    {
        for (const f of fileInput.files) {
            if (f.webkitRelativePath) f.relativePath = f.webkitRelativePath;
            selectedFiles.push(f);
        }
        renderDialogFileList(fileListEl, uploadBtn, selectedFiles);
        fileInput.value = '';
    });

    if (folderInput) {
        folderInput.addEventListener('change', () => {
            for (const f of folderInput.files) {
                if (f.webkitRelativePath) f.relativePath = f.webkitRelativePath;
                selectedFiles.push(f);
            }
            renderDialogFileList(fileListEl, uploadBtn, selectedFiles);
            folderInput.value = '';
        });
    }

    document.getElementById('upload-btn').addEventListener('click', async () => {
            await handleUpload(dialog, uploadBtn, fileListEl, selectedFiles);
    });

</script>
}
