@model KOCRAsp.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    ViewData["HideNav"] = true;
    Layout = "_Layout";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="width: 100%; max-width: 420px;">
        <div class="card-body p-4">
            <h4 class="card-title text-center mb-1">Forgot your password?</h4>
            <p class="text-muted text-center small mb-4">Enter your email and we'll send you a reset link.</p>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="display: @(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

            <form method="post" asp-action="ForgotPassword" asp-controller="Auth">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" autocomplete="email"
                           placeholder="you@example.com" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary">Send Reset Link</button>
                </div>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Login" asp-controller="Auth" class="small text-muted">Back to sign in</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
