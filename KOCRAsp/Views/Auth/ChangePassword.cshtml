@model KOCRAsp.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["MetaDescription"] = "Change your Hardscrabble Invoice account password.";
    Layout = "_Layout";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="width: 100%; max-width: 440px;">
        <div class="card-body p-4">
            <h1 class="h4 card-title text-center mb-1">Change Password</h1>
            <p class="text-muted text-center small mb-4">Enter your current password and choose a new one.</p>

            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <div class="alert alert-success" role="alert">@successMsg</div>
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="display: @(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

            <form method="post" asp-action="ChangePassword" asp-controller="Auth">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                    <input asp-for="CurrentPassword" class="form-control"
                           autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" class="form-control"
                           autocomplete="new-password" placeholder="Minimum 8 characters" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="form-control"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary">Change Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
