@model KOCRAsp.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["HideNav"] = true;
    Layout = "_Layout";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="width: 100%; max-width: 420px;">
        <div class="card-body p-4">
            <h4 class="card-title text-center mb-4">
                <span class="fw-bold">K-OCR</span> Login
            </h4>

            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <div class="alert alert-success">@successMsg</div>
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="display: @(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

            <form method="post" asp-action="Login" asp-controller="Auth">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" autocomplete="email"
                           placeholder="you@example.com" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password"
                           placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary">Sign In</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
