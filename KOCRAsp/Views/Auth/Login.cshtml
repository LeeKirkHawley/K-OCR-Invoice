@model KOCRAsp.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["HideNav"] = true;
    ViewData["MetaDescription"] = "Sign in to Hardscrabble Invoice to upload, review, and process invoices.";
    Layout = "_Layout";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="width: 100%; max-width: 420px;">
        <div class="card-body p-4">
            <h1 class="h4 card-title text-center mb-4">
                <span class="fw-bold">Hardscrabble Invoice</span> Login
            </h1>

            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <div class="alert alert-success">@successMsg</div>
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"
                 style="display: @(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

            <form method="post" asp-action="Login" asp-controller="Auth">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address or Guest name</label>
                    <input asp-for="Email" class="form-control" autocomplete="username"
                           placeholder="you@example.com or Guest12" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password"
                           placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary">Sign In</button>
                </div>
            </form>

            <div class="text-center mt-3">
                <a asp-action="ForgotPassword" asp-controller="Auth" class="small text-muted">Forgot your password?</a>
            </div>

            <hr class="my-3" />

            <div class="d-grid">
                <button type="button" class="btn btn-outline-secondary" id="btnNewGuestLogin">
                    New Guest Login
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Guest login creation modal -->
<div class="modal fade" id="guestLoginModal" tabindex="-1" aria-labelledby="guestLoginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="guestLoginModalLabel">New Guest Login</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="guestModalError" class="alert alert-danger d-none"></div>
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input type="text" class="form-control" id="guestUserName" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="guestEmail">Email address</label>
                    <input type="email" class="form-control" id="guestEmail" placeholder="you@example.com" />
                </div>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    A guest account allows you to quickly try out the app without registering. It will expire after one week, and any data you create will be deleted.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnCreateGuest">Create Guest Account</button>
            </div>
        </div>
    </div>
</div>

<!-- Guest password reveal modal -->
<div class="modal fade" id="guestPasswordModal" tabindex="-1" aria-labelledby="guestPasswordModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="guestPasswordModalLabel">Your Guest Account is Ready</h5>
            </div>
            <div class="modal-body">
                <p>Your username is <strong id="revealUserName"></strong>. Your temporary password is shown below. <strong>Please copy it now</strong> — it will not be shown again.</p>
                <div class="input-group">
                    <input type="text" class="form-control font-monospace" id="revealPassword" readonly />
                    <button class="btn btn-outline-secondary" type="button" id="btnCopyPassword">Copy</button>
                </div>
                <div id="copyConfirm" class="text-success small mt-2 d-none">Copied to clipboard!</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnContinueGuest">Continue to App</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const guestLoginModal    = new bootstrap.Modal(document.getElementById('guestLoginModal'));
        const guestPasswordModal = new bootstrap.Modal(document.getElementById('guestPasswordModal'));

        async function openGuestLoginModal() {
            document.getElementById('guestEmail').value = '';
            document.getElementById('guestModalError').classList.add('d-none');
            document.getElementById('guestUserName').value = 'Loading…';
            guestLoginModal.show();

            const res  = await fetch('/auth/nextguestno');
            const data = await res.json();
            document.getElementById('guestUserName').value = `Guest${data.nextNo}`;
        }

        document.getElementById('btnNewGuestLogin').addEventListener('click', openGuestLoginModal);

        document.getElementById('btnCreateGuest').addEventListener('click', async () => {
            const email  = document.getElementById('guestEmail').value.trim();
            const errBox = document.getElementById('guestModalError');
            errBox.classList.add('d-none');

            if (!email) {
                errBox.textContent = 'Email address is required.';
                errBox.classList.remove('d-none');
                return;
            }

            const btn = document.getElementById('btnCreateGuest');
            btn.disabled = true;
            btn.textContent = 'Creating…';

            try {
                const res  = await fetch('/auth/guestlogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await res.json();

                if (!data.success) {
                    errBox.textContent = data.error ?? 'Failed to create guest account.';
                    errBox.classList.remove('d-none');
                    return;
                }

                guestLoginModal.hide();
                document.getElementById('revealUserName').textContent = data.userName;
                document.getElementById('revealPassword').value       = data.password;
                document.getElementById('copyConfirm').classList.add('d-none');
                guestPasswordModal.show();
            } finally {
                btn.disabled = false;
                btn.textContent = 'Create Guest Account';
            }
        });

        document.getElementById('btnCopyPassword').addEventListener('click', () => {
            const pwd = document.getElementById('revealPassword').value;
            navigator.clipboard.writeText(pwd).then(() => {
                document.getElementById('copyConfirm').classList.remove('d-none');
            });
        });

        document.getElementById('btnContinueGuest').addEventListener('click', () => {
            window.location.href = '/';
        });

        const openGuest = new URLSearchParams(window.location.search).get('openGuest');
        if (openGuest === '1') {
            openGuestLoginModal();
        }
    </script>
}
