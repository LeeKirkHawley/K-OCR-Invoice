@using Microsoft.AspNetCore.Antiforgery
@using System.Security.Claims
@using K_OCRLib.Data
@using K_OCRLib.Security
@using KOCRAsp.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject IAntiforgery Antiforgery
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject ApplicationDbContext AppDb
@{
    var hideNav = ViewData["HideNav"] as bool? == true;
    var allowIndexing = ViewData["AllowIndexing"] as bool? == true;
    var pageTitle = ViewData["Title"] as string;
    var pageDescription = ViewData["MetaDescription"] as string;
    var gaMeasurementId = Configuration["GoogleAnalyticsMeasurementId"];
    var searchConsoleToken = Configuration["SearchConsoleVerificationToken"];
    var request = ViewContext.HttpContext.Request;
    var canonicalPath = UrlCanonicalizer.GetCanonicalPath(request.Path.Value ?? string.Empty);
    var resolvedTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Hardscrabble Invoice"
        : pageTitle == "Hardscrabble Invoice"
            ? pageTitle
            : $"{pageTitle} – Hardscrabble Invoice";
    var canonicalUrl = $"{request.Scheme}://{request.Host}{request.PathBase}{canonicalPath}";
    var activeOrgId = User.FindFirst(AppClaimTypes.OrganizationId)?.Value;
    var activeTenantName = User.FindFirst(AppClaimTypes.TenantName)?.Value;
    var returnUrl = $"{request.PathBase}{request.Path}{request.QueryString}";
    var orgOptions = Array.Empty<(string OrgId, string OrgName)>();
    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrWhiteSpace(userId))
        {
            var options = await AppDb.UserOrganizationMemberships
                .AsNoTracking()
                .Where(m => m.UserId == userId && m.Organization.IsActive)
                .OrderBy(m => m.Organization.Name)
                .Select(m => new { m.OrganizationId, OrgName = m.Organization.Name })
                .ToListAsync();
            orgOptions = options.Select(o => (o.OrganizationId, o.OrgName)).ToArray();
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@resolvedTitle</title>
    <meta name="robots" content="@(allowIndexing ? "index,follow" : "noindex,nofollow")" />
    @if (!string.IsNullOrWhiteSpace(pageDescription))
    {
        <meta name="description" content="@pageDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(searchConsoleToken))
    {
        <meta name="google-site-verification" content="@searchConsoleToken" />
    }
    <link rel="canonical" href="@canonicalUrl" />
    <meta name="request-verification-token"
          content="@Antiforgery.GetAndStoreTokens(ViewContext.HttpContext).RequestToken" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="//cdn.jsdelivr.net" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrWhiteSpace(gaMeasurementId))
    {
        <script async src="@($"https://www.googletagmanager.com/gtag/js?id={gaMeasurementId}")"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@gaMeasurementId');
        </script>
    }
</head>
<body>
    @if (!hideNav)
    {
        <nav class="navbar navbar-dark bg-dark fixed-top px-3">
            <div class="d-flex align-items-center">
                <a class="navbar-brand fw-bold mb-0" href="/">Hardscrabble Invoice</a>
                <span class="text-light small">@User?.Identity?.Name</span>

                @if (orgOptions.Length > 0)
                {
                    <span class="text-secondary px-2">–</span>
                    <form method="post" asp-controller="Auth" asp-action="SwitchOrganization" class="d-inline-flex align-items-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <select name="orgId" class="form-select form-select-sm bg-dark text-light border-secondary org-switcher-select" onchange="this.form.submit()">
                            @foreach (var opt in orgOptions)
                            {
                                <option value="@opt.OrgId" selected="@(opt.OrgId == activeOrgId ? "selected" : null)">@opt.OrgName</option>
                            }
                        </select>
                    </form>
                }
                else if (!string.IsNullOrEmpty(activeTenantName) && activeTenantName != "Global")
                {
                    <span class="text-secondary px-2">–</span>
                    <span class="text-light">@activeTenantName</span>
                }
            </div>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <div class="dropdown">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" id="mainMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">Menu</button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="mainMenuDropdown">
                            @if (User.IsActiveOrganizationAdmin())
                            {
                                <li><a class="dropdown-item" asp-controller="OrgConfig" asp-action="Index">🏢 Org Config</a></li>
                            }
                            @if (User.IsInRole(RoleNames.SuperAdmin))
                            {
                                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index">⚙️ Settings</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">🔧 Admin</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="OcrQueue">📋 OCR Queue</a></li>
                            }
                            <li><a class="dropdown-item" href="/Manual" target="_blank" rel="noopener noreferrer">📖 Manual</a></li>
                            <li><a class="dropdown-item" asp-controller="Auth" asp-action="ChangePassword">Change Password</a></li>
                            <li>
                                <form method="post" action="/auth/logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </nav>
        <div class="d-flex" style="padding-top: 56px; min-height: calc(100vh - 56px);">
            <main class="flex-grow-1 @(ViewData["FullScreen"] as bool? == true ? "overflow-hidden p-0" : "p-4 overflow-auto")">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="min-vh-100 @(ViewData["FullScreen"] as bool? == true ? "overflow-hidden p-0" : "p-4 overflow-auto")">
            @RenderBody()
        </main>
    }

    @if (!hideNav)
    {
        <div id="toast-container" aria-live="polite" aria-atomic="true"
             style="position: fixed; bottom: 1rem; right: 1rem; z-index: 9999; min-width: 280px;">
        </div>

        <div id="kocrVtip" class="kocr-vtip" role="tooltip" style="display:none"></div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (!hideNav)
    {
        <!-- New Batch Modal -->
        <div class="modal fade" id="newBatchModal" tabindex="-1" aria-labelledby="newBatchModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="newBatchModalLabel">📦 New Batch</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="newBatchNameInput" class="form-label">Batch Name</label>
                            <input type="text" class="form-control" id="newBatchNameInput"
                                   maxlength="200" placeholder="Enter batch name" autocomplete="off" />
                            <div class="invalid-feedback">Batch name is required.</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" id="newBatchCreateBtn" onclick="submitNewBatch()">Create</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            (function () {
                const modal = document.getElementById('newBatchModal');

                async function openNewBatchModal() {
                    const nameInput = document.getElementById('newBatchNameInput');
                    nameInput.value = '';
                    nameInput.classList.remove('is-invalid');

                    try {
                        const resp = await fetch('/batch/getnextbatchnumber');
                        if (resp.ok) {
                            const data = await resp.json();
                            nameInput.value = 'Batch' + data.nextBatchNumber;
                        }
                    } catch (e) { /* leave blank on error */ }

                    bootstrap.Modal.getOrCreateInstance(modal).show();
                }

                async function submitNewBatch() {
                    const nameInput = document.getElementById('newBatchNameInput');
                    const btn = document.getElementById('newBatchCreateBtn');
                    const name = nameInput.value.trim();

                    if (!name) {
                        nameInput.classList.add('is-invalid');
                        nameInput.focus();
                        return;
                    }
                    nameInput.classList.remove('is-invalid');
                    setButtonLoading(btn, true);

                    const fd = new FormData();
                    fd.append('name', name);
                    try {
                        const result = await postForm('/batch/createajax', fd);
                        if (result.success) {
                            bootstrap.Modal.getInstance(modal).hide();
                            showToast(`Batch '${escapeHtml(name)}' created.`);
                            // Refresh the batch table if we're on the Batch/Index page
                            if (typeof refreshBatchList === 'function') refreshBatchList();
                            // Auto-select the new batch on Home page and load invoice names
                            const selector = document.getElementById('batchSelector');
                            if (selector) {
                                // First refresh the dropdown
                                if (typeof refreshBatchDropdown === 'function') {
                                    await refreshBatchDropdown();
                                }
                                // Then select the new batch
                                if (result.batchId) {
                                    selector.value = result.batchId;
                                    selector.dispatchEvent(new Event('change'));
                                }
                            }
                        } else {
                            showToast(result.error ?? 'Failed to create batch.', 'error');
                        }
                    } catch (err) {
                        showToast('Error: ' + err.message, 'error');
                    } finally {
                        setButtonLoading(btn, false);
                    }
                }

                // Submit on Enter key
                document.getElementById('newBatchNameInput')
                    .addEventListener('keydown', e => { if (e.key === 'Enter') submitNewBatch(); });

                // Reset validation state when modal closes
                modal.addEventListener('hidden.bs.modal', () => {
                    document.getElementById('newBatchNameInput').classList.remove('is-invalid');
                });

                window.openNewBatchModal = openNewBatchModal;
                window.submitNewBatch = submitNewBatch;
            })();
        </script>

        <div class="modal fade" id="guestOcrLimitModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="guestOcrLimitModalTitle">Guest Account Notice</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="guestOcrLimitModalBody">Your guest account OCR limit has been reached.</div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                    </div>
                </div>
            </div>
        </div>
        <script>
            function showGuestOcrLimitModal(message, title) {
                const titleEl = document.getElementById('guestOcrLimitModalTitle');
                const body = document.getElementById('guestOcrLimitModalBody');
                if (titleEl) titleEl.textContent = title || 'Guest Account Notice';
                if (body && message) body.textContent = message;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('guestOcrLimitModal')).show();
            }
        </script>

        @if (TempData["StripeInactiveWarning"] is true)
        {
            <!-- Stripe inactive warning — shown once after login when subscription is not active -->
            <div class="modal fade" id="stripeInactiveModal" tabindex="-1"
                 aria-labelledby="stripeInactiveModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title" id="stripeInactiveModalLabel">⚠️ Subscription Inactive</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body pt-2">
                            <p>Your organization's billing subscription is currently inactive or could not be verified with Stripe.</p>
                            <p><strong>OCR processing will be unavailable</strong> until an active subscription is confirmed.</p>
                            <p class="mb-0 text-muted">All other functions — uploading, validating, and exporting invoices — are still available.</p>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-warning" data-bs-dismiss="modal">I Understand</button>
                        </div>
                    </div>
                </div>
            </div>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('stripeInactiveModal')).show();
                });
            </script>
        }

        @if (User?.Identity?.IsAuthenticated == true)
        {
            <!-- Guest account expiry modal - non-dismissable, shown when IsPendingDeletion is true -->
            <div class="modal fade" id="guestExpiryModal" tabindex="-1"
                 data-bs-backdrop="static" data-bs-keyboard="false"
                 aria-labelledby="guestExpiryModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title" id="guestExpiryModalLabel">⏰ Guest Account Expired</h5>
                        </div>
                        <div class="modal-body pt-2">
                            Your guest account lifetime has expired and will now be deleted.
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-primary">OK</button>
                        </div>
                    </div>
                </div>
            </div>
            <form id="guestExpiryLogoutForm" method="post" action="/auth/logout" style="display:none">
                @Html.AntiForgeryToken()
            </form>
            <script>
                (function () {
                    let pollTimer = null;
                    let autoLogoutTimer = null;

                    function triggerLogout() {
                        document.getElementById('guestExpiryLogoutForm').submit();
                    }

                    function showExpiryModal() {
                        clearInterval(pollTimer);

                        bootstrap.Modal.getOrCreateInstance(
                            document.getElementById('guestExpiryModal')
                        ).show();

                        // Auto-logout after 30 seconds if the user does not click OK.
                        autoLogoutTimer = setTimeout(triggerLogout, 30000);
                    }

                    async function checkGuestExpiry() {
                        try {
                            const resp = await fetch('/auth/guestexpirystatus');
                            if (!resp.ok) return;
                            const data = await resp.json();
                            if (data.isPendingDeletion) {
                                showExpiryModal();
                            }
                        } catch (e) { /* ignore transient network errors */ }
                    }

                    document.getElementById('guestExpiryModal')
                        .querySelector('.btn-primary')
                        .addEventListener('click', function () {
                            clearTimeout(autoLogoutTimer);
                            triggerLogout();
                        });

                    // Poll every 30 seconds; also check shortly after page load.
                    pollTimer = setInterval(checkGuestExpiry, 30000);
                    setTimeout(checkGuestExpiry, 3000);
                })();
            </script>
        }
    }
</body>
</html>
