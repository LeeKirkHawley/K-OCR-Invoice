{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./wwwroot/js", // ← Compiled JS goes here
    "sourceMap": true,
    "rootDir": "./Views/Home"
  },
  "include": [ "Views/**/*.ts" ],
  "exclude": [ "node_modules", "wwwroot" ]
}